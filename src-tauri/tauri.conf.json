{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farfold",
  "version": "0.1.0",
  "identifier": "ai.farfold.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Farfold",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/pi"],
    "resources": {
      "resources/pi-runtime/": "pi-runtime/"
    }
  }
}
