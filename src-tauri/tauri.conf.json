{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farfold",
  "version": "0.1.1",
  "identifier": "ai.farfold.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Farfold",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../scripts/pi-capability-wrapper.sh": "farfold-runtime/pi-capability-wrapper.sh",
      "../scripts/pi-sidecar-wrapper.sh": "farfold-runtime/pi-sidecar-wrapper.sh",
      "resources/farfold-runtime/": "farfold-runtime/",
      "resources/release-manifest.json": "release-manifest.json",
      "resources/opencode-runtime/": "opencode-runtime/",
      "resources/pi-runtime/": "pi-runtime/",
      "resources/pi-capabilities/": "pi-capability-runtime/",
      "resources/third-party/": "third-party/"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
