"""Prepare exact reviewed P18 checkpoint paths; never changes the index."""
import hashlib,json,subprocess
from pathlib import Path
ROOT=Path('/Users/tw/Desktop/farfold'); OUT=ROOT/'output/2026-10-14-diff-summary-integration'; BASE=ROOT/'docs/evidence/2026-10-09-capability-hardening'
def read(p):return json.loads(p.read_bytes())
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def ref(p):return {'path':str(p.relative_to(ROOT)),'bytes':p.stat().st_size,'sha256':sha(p)}
assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT).decode().strip()=='522a4f20439976a6cd1b2629be8c7920b9e00c73'
assert not subprocess.check_output(['git','diff','--cached','--name-only'],cwd=ROOT)
s=read(OUT/'checks-run-02/summary.json');assert s['allPassed'] and s['completedCount']==s['requiredCommandsExecuted']==7 and s['sourceStable'] and s['sourceMembershipStable'] and s['protectedUnchanged']
f=read(OUT/'checks-freeze-02/freeze.json');assert not f['changesSincePreparation']
for name,digest in {**f['inputs'],**f['protected']}.items():assert sha(ROOT/name)==digest,name
sources=read(ROOT/'output/2026-10-14-diff-summary-frontend/source-freeze-v2.json')['files'];assert len(sources)==16
paths=set()
for r in sources:
 actual=ref(ROOT/r['path']);assert all(actual[k]==r[k] for k in actual);paths.add(r['path'])
for name in ['docs/status.md','docs/architecture.md','plans/agent-access.md','docs/evidence/2026-10-09-capability-hardening/README.md']:
 assert name in f['inputs'];paths.add(name)
tracked=set(subprocess.check_output(['git','ls-files','-z'],cwd=ROOT).decode().rstrip('\0').split('\0'))
aux=sorted(n for n in f['inputs'] if n.startswith('output/') and n not in tracked)
assert all(n.startswith('output/2026-10-14-diff-summary-') for n in aux)
paths.update(aux)
for folder in ['diff-summary','diff-summary-checks','diff-summary-correction']:
 directory=BASE/folder
 for pair in read(directory/'publication.json')['files']:
  for key in ['original','published']:assert ref(ROOT/pair[key]['path'])==pair[key]
  assert pair['original']['sha256']==pair['published']['sha256']
 for p in directory.rglob('*'):
  assert not p.is_symlink()
  if p.is_file():paths.add(str(p.relative_to(ROOT)))
review=BASE/'diff-summary-review';review.mkdir(exist_ok=False)
for n in ['browser-review.json','docs/report.json','engineering-review.json']:
 p=ROOT/'output/2026-10-14-diff-summary-independent'/n
 target=review/(n.replace('/','-')+'.raw');target.write_bytes(p.read_bytes());assert sha(target)==sha(p);paths.add(str(target.relative_to(ROOT)))
paths.add(str(Path(__file__).absolute().relative_to(ROOT)))
record=review/'checkpoint-scope.json';record.write_text(json.dumps({'phase':'CHECKPOINT_AFTER_SEVEN','scope':'Exact P18 shared diff comparison increment, four current docs, scoped evidence and all new synthetic engineering inputs. All new test inputs are committed to satisfy candidate commit-source equality. Existing unrelated dirty evidence is preserved.','inputCount':f['inputCount'],'auxiliaryInputs':[ref(ROOT/n) for n in aux],'engineering':ref(OUT/'checks-run-02/summary.json')},indent=2)+'\n');subprocess.run(['corepack','pnpm','exec','prettier','--write',str(record)],cwd=ROOT,check=True);paths.add(str(record.relative_to(ROOT)))
assert not paths.intersection(f['protected'])
selected=[ref(ROOT/n) for n in sorted(paths)]
with (OUT/'source-stage-plan.json').open('x') as h:json.dump({'base':'522a4f20439976a6cd1b2629be8c7920b9e00c73','files':selected,'count':len(selected)},h,indent=2);h.write('\n')
with (OUT/'source-stage-paths.nul').open('xb') as h:h.write(b'\0'.join(n.encode() for n in sorted(paths))+b'\0')
print(json.dumps({'files':len(selected),'bytes':sum(r['bytes'] for r in selected),'plan':ref(OUT/'source-stage-plan.json')}))
