type: \"inlineStr\", rawValue: null, text, runs: [], formula: null, cacheState: \"notFormula\", visibility: \"visible\", included: true, covered: false, display: text, displayKnown: true, ...extra };\n}\nexport function searchWorkbook(cells = [searchCell(\"author needle tail\")]): XlsxInputResult {\n  return { date1904: false, sheets: [{ id: \"sheet1\", name: \"Author sheet\", state: \"visible\" }], scope: { mode: \"visible-saved-cells\", sheetIds: [\"sheet1\"] }, selectedSheets: [{ id: \"sheet1\", cells, merges: [], protection: \"inactive\" }], partial: false, warnings: [] };\n}\nexport function xlsxSetup(texts = [\"author needle tail\"], plain: string[] = []) {\n  const h = setup([...texts.map(() => \"compressed source\"), ...plain]);\n  const captures = new Map<string, WorkbookCapture>(), results = new Map<string, XlsxInputResult>();\n  texts.forEach((text, i) => {\n    const item = h.s.items[i]; if (item.kind !== \"user\" && item.kind !== \"agent\") throw Error();\n    const path = `/fixture/chosen${i}.xlsx`;\n    item.attachments![0] = { name: `chosen${i}.xlsx`, uri: `file://${path}` };\n    const file = { ...h.files.get(`/fixture/file${i}.txt`)!, path, resolvedPath: path, name: `chosen${i}.xlsx` };\n    h.files.set(path, file);\n    captures.set(path, { file, parts: [{ name: \"xl/workbook.xml\", data: \"eA==\" }], entries: [\"xl/workbook.xml\"], inflatedBytes: 1 });\n    results.set(path, searchWorkbook([searchCell(text)]));\n  });\n  const services = { ...h.services,\n    readWorkbook: vi.fn(async (file: VerifiedFile) => captures.get(file.path)!),\n    parseWorkbook: vi.fn(async (capture: WorkbookCapture, _signal: AbortSignal) => results.get(capture.file.path)!),\n  };\n  let candidates = attachmentSearchCandidates([h.s.key], h.states).candidates;\n  const refresh = () => (candidates = attachmentSearchCandidates([h.s.key], h.states).candidates);\n  const current = () => candidates.every((c) => attachmentSearchSourceCurrent(c, h.states));\n  const capture = captures.values().next().value!;\n  return { ...h, services, captures, results, capture, file: capture.file, workbook: results.get(capture.file.path)!, candidates, refresh, current, search: new AttachmentSearch(services) };\n}\nTS\ncat > src/runtime/attachment_search.xlsx.test.ts <<'TS'\nimport { describe, expect, it } from \"vitest\";\nimport { xlsxSetup } from \"./attachment_search.xlsx.test-support\";\n\ndescribe(\"selected current XLSX attachment search\", () => {\n  it(\"reads XLSX through the bounded capture and searches cell author content\", async () => {\n    const h = xlsxSetup();\n    await h.search.start(\"needle\", h.candidates, h.current);\n    expect(h.search.snapshot().matches).toBe(1);\n    expect(h.services.readWorkbook).toHaveBeenCalledOnce();\n    expect(h.services.read).not.toHaveBeenCalled();\n    expect(h.search.snapshot().hits[0]).toMatchObject({ location: { kind: \"xlsx\", sheetId: \"sheet1\", reference: \"A1\", field: \"value\" } });\n  });\n});\nTS\npython3 output/2026-10-14-xlsx-search-frontend/run.py red-01 corepack pnpm exec vitest run src/runtime/attachment_search.xlsx.test.ts"],"cwd":"file:///Users/tw/Desktop/farfold","parsed_cmd":[{"type":"unknown","cmd":"mkdir -p output/2026-10-14-xlsx-search-frontend\ncat > output/2026-10-14-xlsx-search-frontend/run.py <<'PY'\nimport sys,subprocess,datetime,json,pathlib,hashlib\nbase=pathlib.Path(__file__).parent\nname=sys.argv[1];argv=sys.argv[2:];assert argv\nstart=datetime.datetime.now(datetime.timezone.utc).isoformat()\np=subprocess.run(argv,capture_output=True)\nrefs={}\nfor stream in ['stdout','stderr']:\n path=base/(name+'.'+stream+'.log');data=getattr(p,stream);path.write_bytes(data);refs[stream]={'path':str(path),'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}\n(base/(name+'.completed.json')).write_text(json.dumps({'argv':argv,'cwd':str(pathlib.Path.cwd()),'startedAtUtc':start,'completedAtUtc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'actualExitCode':p.returncode