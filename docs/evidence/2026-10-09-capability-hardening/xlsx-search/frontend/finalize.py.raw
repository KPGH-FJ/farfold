from pathlib import Path
import hashlib,json,datetime
base=Path('output/2026-10-14-xlsx-search-frontend')
def ref(path):
 p=Path(path);b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
freeze=json.loads((base/'source-freeze-v1.json').read_text());assert all(ref(x['path'])==x for x in freeze['ownedFiles'])
transcript=Path('/Users/tw/.codex/sessions/2026/10/13/rollout-2026-10-13T15-01-07-01a13410-a021-7660-b316-4a5e2c3de35f.jsonl')
raw=transcript.read_bytes();offset=max(0,len(raw)-4000000);offset=raw.find(b'\n',offset)+1 if offset else 0
records=[];dest=base/'transcript-receipts';dest.mkdir(exist_ok=False)
for line in raw[offset:].splitlines(keepends=True):
 start=offset;offset+=len(line)
 try:o=json.loads(line)
 except:continue
 p=o.get('payload',{});item=p.get('item',{})
 command=str(item.get('command',''))
 if p.get('type')=='item_completed' and item.get('type')=='CommandExecution' and 'xlsx-search-frontend/run.py ' in command:
  n=len(records)+1;file=dest/f'{n:02d}-completed.jsonl.raw';file.write_bytes(line)
  records.append({**ref(file),'sourceStartByte':start,'sourceEndByte':offset,'sourceLine':raw[:start].count(b'\n')+1,'timestamp':o.get('timestamp'),'callId':item.get('id'),'actualExitCode':item.get('exit_code'),'processId':item.get('process_id')})
assert len(records)==10,len(records)
(dest/'manifest.json').write_text(json.dumps({'sourceTranscript':str(transcript),'boundary':'Exact selected CommandExecution item_completed JSONL lines for this frontend scoped runner only. No full transcript copy; all raw test failures retained.','records':records},indent=2)+'\n')
runNames=['red-01','route-green-01','targeted-02','targeted-03','format-write','typecheck-01','targeted-final','format-check-01','fixture-format-write','format-final','targeted-frozen']
runs=[]
for name in runNames:
 receipt=base/(name+'.completed.json');data=json.loads(receipt.read_text());runs.append({'name':name,'actualExitCode':data['actualExitCode'],'completion':ref(receipt),'stdout':data['stdout'],'stderr':data['stderr']})
assert all(next(x for x in runs if x['name']==n)['actualExitCode']==0 for n in ['typecheck-01','format-final','targeted-frozen'])
result={'schema':1,'completedAtUtc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'P32 current explicitly selected XLSX saved cells and stored included formulas, common attachment search alongside existing DOCX and UTF8. Source implementation and targeted verification only.','sourceFreeze':ref(base/'source-freeze-v1.json'),'sourceStableAfterFrozenTests':True,'ownedFiles':freeze['ownedFiles'],'interface':{'captureCommand':'file_delivery_read_workbook_search','captureInput':'{file: VerifiedFile}','captureOutput':'WorkbookCapture','worker':'readWorkbookInput(capture,{mode:visible-saved-cells},signal) with checkedXlsxInputResult','projection':'xlsxSearchText checked model -> cell/field-separated segments; string text decoded once, other raw lexemes; no formula calculation/shared expansion/format display/labels/attributes','location':'kind:xlsx, sheetId(actual relationship id), sheetName, reference, row, column, field:value|savedCache|formula','state':'row.workbook={mode,partial,warnings}; existing row.document and DocxSearchLocation unchanged'},'limits':{'sourceBytes':1048576,'files':20,'actualUtf8SearchBytes':16777216,'displayedHits':200,'queryUtf8Bytes':256,'prefetchedReads':2,'batchStructuredParsers':'One shared parseTail for DOCX/XLSX; external preview contention remains busy; native blocking reads retain actual backend slots through timeout/cancellation.'},'verification':{'targeted':{'files':7,'passed':190,'actualExitCode':0,'scope':['XLSX bounded route, source7 fields and postparse capture/revision checks','MIME extensionless/case/parameters, ownership drift, late capture/parse and explicit pending retry','missing/empty/zero, Unicode/precise lexemes, formula/cache/cell barriers, hidden protected expressions and valid cache','mixed DOCX/XLSX/text actual UTF8 budgets including exact16MiB and failed-reservation regression','same-batch parser serialization, cancellation and source navigation','real parser plus independent 3 ZIP/capture/oracle samples:26 segments265bytes,6 segments69bytes,scopeEmpty','existing DOCX/UTF8 controller and author projection regression','React server render notices outside closed details, no stale/current mislabel and centralized strings']},'typecheckActualExitCode':0,'formatActualExitCode':0,'installedApp':False,'realAgent':False,'browser':'Root-owned controlled browser run is separate and not included in this summary. SSR component tests do not prove pixel layout.'},'preservedFailures':[{'run':'red-01','actualExitCode':1,'passed':0,'total':1,'cause':'Existing frontend route treated the selected XLSX as plain text; no cell author-content search. Controlled route red, not installed/native evidence.'},{'run':'targeted-02','actualExitCode':1,'passedTests':178,'failedSuites':1,'cause':'New structured warning formatter was put in the primitive-argument string registry; string-suite collection passed number/string and threw. Moved object formatter outside the registry without changing authored content.'},{'run':'format-check-01','actualExitCode':1,'cause':'Independent oracle JSON copy needed repository formatting. Only whitespace changed; parsed JSON equality is independently recorded. Not a production correctness failure.'}],'fixtureCopies':ref(base/'fixture-copies.json'),'fixtureOracleFormatting':ref(base/'fixture-oracle-format.json'),'runs':runs,'originalToolCompletions':ref(dest/'manifest.json'),'notPerformed':['No full seven engineering checks','No build/install/App/UI/real Agent/database operation','No docs/plan/PRODUCT/backend edits or commit by frontend']}
(base/'summary.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps({'summary':ref(base/'summary.json'),'manifest':ref(dest/'manifest.json'),'rawCompletedCount':len(records)}))
