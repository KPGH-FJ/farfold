GENERATED_TOOLS = ROOT / 'output/2026-10-14-browser-tabs-install-preparation/generated-tools.json'

def verify_generated_tools():
    generated = read_json(GENERATED_TOOLS)
    require(generated['phase'] == 'fullyConfiguredForVerifiedInstallBeforeAppMutation' and generated['sourceCommit'] == SOURCE_COMMIT and generated['notYetKnownPins'] == [], 'Final runtime tools not fully pinned')
    preparation = GENERATED_TOOLS.parent / 'preparation.json'
    require(generated['preparation'] == {'path': str(preparation.relative_to(ROOT)), 'sha256': sha(preparation)}, 'Final runtime tool preparation pointer differs')
    expected = {str((EVIDENCE / name).relative_to(ROOT)) for name in ('prepare-candidate.py', 'verify-candidate.py')}
    expected |= {str((OUT / name).relative_to(ROOT)) for name in ('install_verified_candidate.py', 'install_data_snapshot.py', 'capture_snapshot.py', 'data_manifest.py', 'backup_metadata.py', 'observe_normal_exit.py')}
    expected.add('output/2026-10-14-browser-tabs-independent-install/verify_installed_final.py')
    require(len(generated['tools']) == 9 and {item['path'] for item in generated['tools']} == expected, 'Final runtime tool membership differs')
    for item in generated['tools']:
        require(sha(ROOT / item['path']) == item['sha256'] and all(value != 'UNSET' for value in item['pins'].values()), 'Configured runtime tool changed or unknown pins remain')
        if 'SOURCE_COMMIT' in item['pins']:
            require(item['pins']['SOURCE_COMMIT'] == SOURCE_COMMIT, 'Runtime tool source differs')
        for name in ('NORMAL_EXIT_SHA', 'BEFORE_SUMMARY_SHA', 'BACKUP_RECEIPT_SHA'):
            if name in item['pins']:
                require(item['pins'][name] == globals()[name], 'Runtime data pin differs')
    require(generated['beforeSummary']['sha256'] == BEFORE_SUMMARY_SHA and generated['backupReceipt']['sha256'] == BACKUP_RECEIPT_SHA and generated['normalExit']['sha256'] == NORMAL_EXIT_SHA, 'Generated-tool dependency pins differ')
    require(all(generated[field]['path'] == str((OUT / filename).relative_to(ROOT)) for field, filename in (('beforeSummary', 'install-data-before-summary.json'), ('backupReceipt', 'metadata-backup-receipt.json'), ('normalExit', 'normal-exit-observation.json'))), 'Generated-tool dependency paths differ')
    require(sha(OUT / 'install-data-before-summary.json') == BEFORE_SUMMARY_SHA and sha(OUT / 'metadata-backup-receipt.json') == BACKUP_RECEIPT_SHA, 'Generated-tool dependency receipts changed')
    return generated


