EXECUTABLE = FORMAL / 'Contents/MacOS/farfold'
SCOPES = ['src/', 'assets/', 'public/', 'scripts/', 'src-tauri/src/', 'src-tauri/native/', 'src-tauri/capabilities/', 'src-tauri/icons/', 'src-tauri/resources/', 'docs/evidence/2026-10-09-capability-hardening/docx-fixtures/', 'docs/evidence/2026-10-09-capability-hardening/docx/public-samples/']







SCOPES += ['docs/evidence/2026-10-09-capability-hardening/workbook-range/fixtures/', 'docs/evidence/2026-10-09-capability-hardening/visual-area/fixtures/']














BUNDLE_FILES = {'Contents/Info.plist', 'Contents/MacOS/farfold', 'Contents/Resources/icon.icns', 'Contents/Resources/release-manifest.json', 'Contents/_CodeSignature/CodeResources'}



# P08 fixed source inputs; checked against the complete engineering inventory.


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def nonsymlink(path, directory=False):
    for parent in (path, *path.parents):
        require(not parent.is_symlink(), 'Unexpected symbolic link in a verified path')
    mode = path.lstat().st_mode
    require(stat.S_ISDIR(mode) if directory else stat.S_ISREG(mode), 'Unexpected verified file type')


def sha(path):
    nonsymlink(path)
    value = hashlib.sha256()
    with path.open('rb') as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
            value.update(chunk)
    return value.hexdigest()


def read_json(path):
    nonsymlink(path)
    return json.loads(path.read_text())


def run(args):
    result = subprocess.run(args, cwd=ROOT, capture_output=True, text=True)
    require(result.returncode == 0, f'{args[0]} failed with exit {result.returncode}: {result.stderr[-1200:]}')
    return (result.stdout + result.stderr).strip()


def files(base):
    nonsymlink(base, directory=True)
    result = {}
    for path in sorted(base.rglob('*')):
        require(not path.is_symlink(), 'Unexpected bundle symbolic link')
        mode = path.lstat().st_mode
        require(stat.S_ISDIR(mode) or stat.S_ISREG(mode), 'Unexpected bundle entry type')
        if stat.S_ISREG(mode):
            result[str(path.relative_to(base))] = sha(path)
    require(set(result) == BUNDLE_FILES, 'Bundle does not contain exactly the approved five files')
    return result


def process_count():
    output = run(['/bin/ps', '-axo', 'pid=,comm='])
    return sum(fields[1] == str(EXECUTABLE) for line in output.splitlines() if len(fields := line.split(None, 1)) == 2)


def verify_bundle(path):
    info = plistlib.loads((path / 'Contents/Info.plist').read_bytes())
    require(info.get('CFBundleIdentifier') == 'ai.farfold.desktop', 'Bundle identifier differs')
    require(info.get('CFBundleShortVersionString') == '0.1.7', 'Bundle version differs')
    require(info.get('CFBundleExecutable') == 'farfold', 'Bundle executable differs')
    require(info.get('CFBundleDevelopmentRegion') == 'zh_CN' and 'zh-Hans' in info.get('CFBundleLocalizations', []), 'Bundle localization differs')
    architecture = run(['/usr/bin/lipo', '-archs', str(path / 'Contents/MacOS/farfold')])
    require(architecture == 'arm64', 'Bundle architecture differs')
    verified = run(['/usr/bin/codesign', '--verify', '--deep', '--strict', '--verbose=2', str(path)])
    details = run(['/usr/bin/codesign', '-d', '--verbose=4', str(path)])
    require('Signature=adhoc' in details and 'Identifier=ai.farfold.desktop' in details, 'Bundle signature differs')
    return {'identifier': info['CFBundleIdentifier'], 'version': info['CFBundleShortVersionString'], 'architecture': architecture, 'strictCodesign': verified, 'signature': 'ad-hoc; not notarized'}


def verify_source(inputs):
    output = subprocess.run(['/usr/bin/git', 'ls-tree', '-r', '-z', COMMIT], cwd=ROOT, capture_output=True, check=True).stdout
    tracked = {}
    for entry in output.split(b'\0'):
        if not entry:
            continue
        metadata, name = entry.split(b'\t', 1)
        mode, kind, oid = metadata.split()
        name = name.decode()
        if kind == b'blob' and (name in TOP or any(name.startswith(scope) for scope in SCOPES)):
            tracked[name] = (mode.decode(), oid.decode())
    disk = set(TOP)
    for scope in SCOPES:
        disk.update(str(path.relative_to(ROOT)) for path in (ROOT / scope).rglob('*') if path.is_file() and path.name != '.DS_Store' and '__pycache__' not in path.parts)
    require(set(inputs) == set(tracked) == disk and len(inputs) == EXPECTED_INPUT_COUNT, 'Source input inventory differs from approved commit')
    for name, expected in inputs.items():
        path = ROOT / name
        nonsymlink(path)
        raw = path.read_bytes()
        require(hashlib.sha256(raw).hexdigest() == expected, 'Source input differs from candidate receipt')
        blob = hashlib.sha1(b'blob ' + str(len(raw)).encode() + b'\0' + raw).hexdigest()
        require(tracked[name][0] in ('100644', '100755') and blob == tracked[name][1], 'Source input differs from approved commit')


def verify_before_snapshot():
    summaries = []
    for phase in ('before', 'preinstall'):
        summary_path = OUT / f'install-data-{phase}-summary.json'
        raw_path = OUT / f'install-data-{phase}.jsonl'
        summary = read_json(summary_path)
        execution = read_json(OUT / f'snapshot-{phase}-execution.json')
        require(set(summary) == {'counts', 'sha256'} and execution['exitCode'] == 0 and execution['stderr'] == '' and json.loads(execution['stdout']) == summary, 'Before capture lacks an actual successful execution')
        require(manifest(raw_path) == summary, 'Before full manifest hash/schema/counts differ')
        for item in (summary_path, OUT / f'snapshot-{phase}-execution.json'):
            require(stat.S_IMODE(item.stat().st_mode) == 0o600 and item.stat().st_uid == os.getuid(), 'Capture receipt must be owner-held 0600')
        summaries.append(summary)
    require(sha(OUT / 'install-data-before-summary.json') == BEFORE_SUMMARY_SHA and summaries[0] == summaries[1], 'Data changed between complete before and preinstall snapshots')
    return {**summaries[1], 'rawMode': '0600', 'rawBytes': (OUT / 'install-data-preinstall.jsonl').stat().st_size, 'summarySha256': sha(OUT / 'install-data-preinstall-summary.json')}


def retention_helpers():
    spec = importlib.util.spec_from_file_location('docx_retention_helpers', Path(__file__).with_name('data_manifest.py'))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def verify_candidate_engineering(candidate, inputs):
    spec = importlib.util.spec_from_file_location('xlsx_install_engineering_helpers', EVIDENCE / 'verify-candidate.py')
    verifier = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(verifier)
    require(verifier.SOURCE_COMMIT == SOURCE_COMMIT, 'Engineering verifier source pin differs')
    actual = verifier.engineering(verifier.ENGINEERING_PATH, inputs)
    require(actual == candidate['engineeringVerification'], 'Candidate engineering evidence changed before installation')
    return actual


def manifest(path, expected_count=None):
    return retention_helpers().manifest(path, expected_count)



def require_configured(backup=False):
    require(INPUT_SCOPE_READY is True, 'Preparation only: final inventory scope is UNSET')
    require(isinstance(EXPECTED_INPUT_COUNT, int) and not isinstance(EXPECTED_INPUT_COUNT, bool) and EXPECTED_INPUT_COUNT > 0, 'Preparation only: final closed input count is UNSET')
    require(isinstance(SOURCE_COMMIT, str) and len(SOURCE_COMMIT) == 40 and all(c in '0123456789abcdef' for c in SOURCE_COMMIT), 'Preparation only: SOURCE_COMMIT is UNSET')
    require(isinstance(NORMAL_EXIT_SHA, str) and len(NORMAL_EXIT_SHA) == 64 and all(c in '0123456789abcdef' for c in NORMAL_EXIT_SHA), 'Preparation only: fresh normal-exit SHA is UNSET')
    if backup:
        require(isinstance(BACKUP_RECEIPT_SHA, str) and len(BACKUP_RECEIPT_SHA) == 64 and all(c in '0123456789abcdef' for c in BACKUP_RECEIPT_SHA), 'Preparation only: verified backup SHA is UNSET')
        require(isinstance(BEFORE_SUMMARY_SHA, str) and len(BEFORE_SUMMARY_SHA) == 64 and all(c in '0123456789abcdef' for c in BEFORE_SUMMARY_SHA), 'Preparation only: exact before summary SHA is UNSET')
        verify_generated_tools()


def modes(base):
    return {name: stat.S_IMODE((base / name).stat().st_mode) for name in files(base)}


def verify_normal_exit():
    require_configured()
    path = OUT / 'normal-exit-observation.json'
    require(sha(path) == NORMAL_EXIT_SHA, 'Fresh normal-exit observation changed')
    spec = importlib.util.spec_from_file_location('audio_normal_exit_helpers', EVIDENCE / 'verify-candidate.py')
    verifier = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(verifier)
    require(verifier.SOURCE_COMMIT == SOURCE_COMMIT, 'Normal-exit helper source pin differs')
    return verifier.validate_normal_observation(read_json(path))


def verify_backup():
    require_configured(backup=True)
    path = OUT / 'metadata-backup-receipt.json'
    require(sha(path) == BACKUP_RECEIPT_SHA, 'Pinned private backup receipt changed')
    receipt = read_json(path)
    require(receipt['sourceCommit'] == SOURCE_COMMIT and receipt['normalExitSha256'] == NORMAL_EXIT_SHA and receipt['sourceAndCaptureUnchanged'] is True and receipt['integrity'] == 'ok' and receipt['privateMode'] == '0600', 'Private backup incomplete or source pins differ')
    require(stat.S_IMODE(path.stat().st_mode) == 0o600 and path.stat().st_uid == os.getuid(), 'Private backup receipt owner or mode differs')
    backup = OUT / 'metadata-before.sqlite3'
    require(stat.S_IMODE(backup.stat().st_mode) == 0o600 and backup.stat().st_uid == os.getuid() and sha(backup) == receipt['backupSha256'], 'Private backup digest, mode or owner differs')
    require('farfold.sqlite3' in receipt['capturedFiles'] and set(receipt['capturedFiles']) <= {'farfold.sqlite3', 'farfold.sqlite3-wal', 'farfold.sqlite3-shm'}, 'Captured SQLite set differs')
    capture = OUT / 'metadata-source'
    nonsymlink(capture, True)
    require(stat.S_IMODE(capture.stat().st_mode) == 0o700 and capture.stat().st_uid == os.getuid(), 'Captured SQLite directory must be private')
    for name, expected in receipt['capturedFiles'].items():
        captured = capture / name
        require(stat.S_IMODE(captured.stat().st_mode) == 0o600 and captured.stat().st_uid == os.getuid() and sha(captured) == expected, 'Captured original SQLite bytes or private owner/mode differ')
    require(set(p.name for p in capture.iterdir()) == set(receipt['capturedFiles']), 'Captured SQLite inventory differs')

    # The latest NEW26 phase remains strict exit 2. These are byte identities only;
    # the current installation still requires its own fresh full manifests/backup.
    stage = verify_normal_exit()['latestClosedDataStage']
    require(receipt['backupSha256'] == 'a70054804a5399ff5a1e38157d6008987c9c0e6218545545f3b3089f42b4cc24' and backup.stat().st_size == 512000, 'Fresh consolidated backup differs from latest sealed NEW26 baseline')
    require(stage['strictExitCode'] == 2 and stage['differencesAccepted'] is False, 'Prior strict data result changed')
    require(receipt['capturedFiles'] == {name: item['sha256'] for name, item in stage['sourceFiles'].items()}
            and all((capture / name).stat().st_size == item['bytes'] for name, item in stage['sourceFiles'].items()),
            'Fresh installation backup differs from latest closed NEW26 source bytes')
    before, entries = retention_helpers().validated_manifest(OUT / 'install-data-before.jsonl')
    require(before == read_json(OUT / 'install-data-before-summary.json') and before['sha256'] == receipt['sourceBeforeManifestSha256'] and sha(OUT / 'install-data-before-summary.json') == BEFORE_SUMMARY_SHA, 'Backup and complete before manifest differ')
    expected_names = {'farfold.sqlite3', 'farfold.sqlite3-wal', 'farfold.sqlite3-shm'}
    require({name for name in expected_names if ('appData', name) in entries} == set(receipt['capturedFiles']), 'Backup SQLite presence differs from before manifest')
    require(all(entries[('appData', name)]['kind'] == 'file' and entries[('appData', name)]['sha256'] == digest and entries[('appData', name)]['size'] == (capture / name).stat().st_size for name, digest in receipt['capturedFiles'].items()), 'Backup bytes differ from before manifest')
    return {'receiptSha256': sha(path), 'backupSha256': sha(backup), 'capturedFiles': receipt['capturedFiles'], 'boundary': 'Verified only retained private evidence; no live database was opened by this check.'}


def main():
    require_configured(backup=True)
    require(isinstance(EXPECTED_COMMIT, str) and len(EXPECTED_COMMIT) == 40 and all(c in '0123456789abcdef' for c in EXPECTED_COMMIT) and COMMIT == EXPECTED_COMMIT, 'Approved exact commit has not been configured; installation is disabled')
    require(Path(__file__).absolute() == OUT / 'install_verified_candidate.py', 'Installer path differs from the approved location')
    nonsymlink(OUT, directory=True)
    require(OUT.stat().st_uid == os.getuid(), 'Output directory owner differs')
    # Exclusive ownership is obtained before any validation or copy; never replace
    # an earlier success/failure receipt, including through a symbolic link.
    descriptor = os.open(OUT / 'install-operation.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    record = {'startedAtUtc': datetime.now(timezone.utc).isoformat(), 'candidateCommit': COMMIT, 'phase': 'preflight', 'userAuthorizedContinuousDevelopment': True, 'normalQuitObservedByRootAgent': False, 'forcedQuit': False, 'copyStarted': False, 'installed': False, 'launched': False, 'realAgentInvoked': False, 'dataRetentionComparisonPending': True}
    with os.fdopen(descriptor, 'w') as receipt_handle:
        try:
            exit_observation = verify_normal_exit()
            record['privateBackup'] = verify_backup()
            candidate_path = EVIDENCE / 'candidate.json'
            inputs_path = EVIDENCE / 'candidate-inputs.json'
            independent_path = EVIDENCE / 'candidate-independent.json'
            candidate = read_json(candidate_path)
            independent = read_json(independent_path)
            inputs = read_json(inputs_path)
            require(candidate['sourceCommit'] == COMMIT and candidate['phase'] == 'internalCandidatePreparedNotInstalled' and candidate['buildExitCode'] == 0, 'Candidate receipt is not an approved completed build')
            require(independent['sourceCommit'] == COMMIT and independent['result'] == 'passed' and independent['failures'] == [] and len(independent['checks']) == 9 and all(item['passed'] for item in independent['checks'].values()), 'Independent candidate verification did not pass')
            require(independent['inputReceipts']['candidateJsonSha256'] == sha(candidate_path) and independent['inputReceipts']['candidateInputsJsonSha256'] == sha(inputs_path), 'Candidate inputs changed after independent verification')
            require(candidate['candidateApp'] == str(CANDIDATE) and candidate['archive'] == str(ARCHIVE), 'Candidate paths differ from fixed approved locations')
            verify_source(inputs)
            engineering = verify_candidate_engineering(candidate, inputs)
            candidate_refs = {str(p.relative_to(ROOT)): sha(p) for p in (candidate_path, inputs_path, independent_path)}
            expected_files = candidate['candidateFiles']
            require(files(CANDIDATE) == expected_files and modes(CANDIDATE) == candidate['candidateModes'], 'Candidate bundle or modes differ from receipt')
            require(files(FORMAL) == candidate['formalFiles'] and modes(FORMAL) == candidate['formalModes'], 'Formal app or modes differ from pre-build receipt')
            record['candidateVerification'] = verify_bundle(CANDIDATE)
            require(sha(ARCHIVE) == candidate['archiveSha256'] and ARCHIVE.stat().st_size == candidate['archiveBytes'], 'Candidate archive differs')
            with zipfile.ZipFile(ARCHIVE) as archive:
                require(archive.testzip() is None, 'Candidate archive CRC failed')
                entries = archive.infolist()
                require(len(entries) == 5 and all(not entry.is_dir() and stat.S_ISREG(entry.external_attr >> 16) for entry in entries), 'Archive must contain only the exact five regular files')
                names = [entry.filename for entry in entries]
                require(len(names) == len(set(names)) and all(name.startswith('Farfold.app/') for name in names), 'Candidate archive members differ')
                archived = {entry.filename.removeprefix('Farfold.app/'): hashlib.sha256(archive.read(entry)).hexdigest() for entry in entries}
                require(archived == expected_files and {entry.filename.removeprefix('Farfold.app/'): stat.S_IMODE(entry.external_attr >> 16) for entry in entries} == candidate['candidateModes'], 'Candidate archive contents or modes differ')
            record['beforeSnapshot'] = verify_before_snapshot()
            record['formalAppProcessesBefore'] = process_count()
            require(record['formalAppProcessesBefore'] == 0, 'Formal app is still running; normal exit is required')
            record['normalQuitObservedByRootAgent'] = True
            # Recheck both exact app identities immediately before the only mutation.
            require(files(CANDIDATE) == expected_files and modes(CANDIDATE) == candidate['candidateModes'] and files(FORMAL) == candidate['formalFiles'] and modes(FORMAL) == candidate['formalModes'], 'An application bundle or mode changed during preflight')
            require(all(sha(ROOT / p) == value for p, value in {**candidate_refs, **engineering['references']}.items()), 'Candidate or actual-seven evidence changed during preflight')
            require(process_count() == 0, 'Formal app restarted during preflight')
            record.update(phase='copying', copyStarted=True)
            run(['/usr/bin/ditto', str(CANDIDATE), str(FORMAL)])
            record['phase'] = 'verification'
            installed_files = files(FORMAL)
            require(installed_files == expected_files and modes(FORMAL) == candidate['candidateModes'], 'Installed bundle or modes differ from verified candidate')
            record['installedVerification'] = verify_bundle(FORMAL)
            record['formalAppProcessesAfter'] = process_count()
            require(record['formalAppProcessesAfter'] == 0, 'Formal app started during installation; stop for review')
            record.update(phase='installedVerifiedNotLaunched', installed=True, onlyFormalAppReplaced=True, installedExactFiveFiles=True, installedFiles=installed_files, archiveSha256=candidate['archiveSha256'], sourceInputsVerified=len(inputs), receiptHashes={'candidate': sha(candidate_path), 'inputs': sha(inputs_path), 'independent': sha(independent_path)})
        except BaseException as error:
            record.update(failedDuring=record['phase'], phase='failed', error=f'{type(error).__name__}: {error}')
            raise
        finally:
            record['completedAtUtc'] = datetime.now(timezone.utc).isoformat()
            receipt_handle.write(json.dumps(record, ensure_ascii=False, indent=2) + '\n')
            receipt_handle.flush()
            os.fsync(receipt_handle.fileno())
    print(json.dumps({'phase': record['phase'], 'installed': record['installed'], 'launched': False, 'dataRetentionComparisonPending': True}), flush=True)



