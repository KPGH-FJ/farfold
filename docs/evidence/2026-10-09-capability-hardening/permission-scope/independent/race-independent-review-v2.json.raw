  "resolvedFinding": {
    "id": "RACE-P1-01",
    "status": "RESOLVED_FOR_REVIEWED_V2",
    "fixRef": "src-tauri/src/acp_client/pump.rs:1174",
    "explanation": "lock() runs only after a successful save, while guard.current is still exactly the saved snapshot. Draining m2 then compares against expected m1, yields blocked, and retains m1. A second request stops at the pre-save readiness check at line 1149. The ordinary frontend continueQueue also refuses because applyConfigCheck sets modelDrift true (config_check.ts:82; sessions.ts:1100). No repeated save can silently replace m1 with m2.",
    "regressionRef": "src-tauri/src/acp_client/prompt_config_race_tests.rs:208"
  },
