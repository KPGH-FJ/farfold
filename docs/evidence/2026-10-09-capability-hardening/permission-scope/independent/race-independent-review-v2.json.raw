      ],
      "assessment": "Error returns before lock. Existing record_failed state remains; no wire prompt. Production-path save-failure test is present in the 37-test passing log.",
      "evidenceLevel": "source plus backend controlled regression log"
    },
    {
      "case": "Successfully saved first request expires or loses receiver",
