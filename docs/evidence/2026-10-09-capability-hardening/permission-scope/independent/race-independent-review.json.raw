  "findings": [
    {
      "id": "RACE-P1-01",
      "priority": "P1",
      "status": "OPEN",
      "title": "First-prompt drift rejection does not retain the saved model baseline",
      "proofLevel": "Static causal path in current production source; not independently executed by reviewer",
      "trigger": "Fresh unlocked model guard begins at m1. While its first prompt is blocked in metadata save, a routed notification changes model to m2. Release metadata save, then explicitly continue the rejected queued input without set_config or confirm_config.",
      "steps": [
        {
          "ref": "src-tauri/src/acp_client/pump.rs:1164",
          "fact": "Captures and successfully persists m1 before draining the queued update."
        },
        {
          "ref": "src-tauri/src/acp_client/pump.rs:1174",
          "fact": "Drains current=m2, then record mismatch rejects this attempt as CONFIG_BLOCKED."
        },
        {
          "ref": "src-tauri/src/acp_client/model_guard.rs:217",
          "fact": "Expected-vs-current comparison is conditional on locked; fresh guard is still unlocked."
        },
        {
          "ref": "src-tauri/src/acp_client/pump.rs:1182",
          "fact": "Emits guard.check() which remains ready for valid m2. The failure does not lock m1 or latch a blocked state."
        },
        {
          "ref": "src/runtime/config_check.ts:82",
          "fact": "ready makes modelDrift false."
        },
        {
          "ref": "src/runtime/sessions.ts:1028",
          "fact": "Known rejection preserves queue and pauses unavailable, but does not independently latch config confirmation."
        },
        {
          "ref": "src/runtime/sessions.ts:1087",
          "fact": "Explicit continue can clear queue pause because modelDrift is false and other guards may all be ready."
        },
        {
          "ref": "src-tauri/src/acp_client/pump.rs:1164",
          "fact": "Second attempt captures and saves m2, equal post-drain record allows sending; first successful send only then locks m2 at line 1212."
        }
      ],
      "impact": "A model rejected because it differed from the saved first-request selection can become the next request selection merely by resuming the queue, without explicit model confirmation.",
      "contractRefs": [
        "PRODUCT.md:47",
        "PRODUCT.md:82",
        "PRODUCT.md:144"
      ],
      "minimalProtectionSuggestion": "After a successful save and before drain, retain exactly the saved snapshot as the expected/locked baseline, or equivalently latch a persistent block against it. A cosmetic blocked event or one-attempt rejection is insufficient. Preserve first-draft explicit configuration change paths and saved baseline on expiry or send failure.",
      "requiredRegression": "After the controlled first-model race rejects, a second ordinary request must remain rejected with zero wire prompts and saved m1. Rechecking/restoring m1 or an explicit supported configuration change with confirmed response and successful persistence may permit a later send. Matching updates, unchanged first sends, existing established-session protection, expired requests and pre-wire send failure require appropriate boundary coverage.",
      "testGapRef": "src-tauri/src/acp_client/prompt_config_race_tests.rs:234",
      "testGap": "The v1 first-model test checks only first rejection and persisted m1, not ready/blocked event status or a second request.",
      "sourceVersion": "V1 only: initial pump 4840a3d3f80791621173f3861147605f64faa301282a0adac6d71f0c650f2655; test 995a697003d660b7a74e0f02b87cf2d2800e809b20f0b5199e71fade20312431"
    }
  ],
  "positiveObservations": [
    {
      "ref": "src-tauri/src/acp_client/pump/restore_config.rs:263",
      "conclusion": "Every currently queued config dispatch updates both model and permission guards before its raw/projection event; malformed config latches model unknown."
    },
    {
      "ref": "src-tauri/src/acp_client/pump.rs:1176",
      "conclusion": "After save/drain, permission readiness and model readiness/record equality are checked before synchronous prompt dispatch. The covered first attempt cannot send a routed changed selection."
    },
    {
      "ref": "src-tauri/src/acp_client/permission_guard.rs:94",
      "conclusion": "Unsolicited permission change invalidates readiness and cannot itself re-confirm it, including change-back."
    },
    {
      "ref": "src-tauri/src/acp_client/session.rs:493",
      "conclusion": "Pump-returned definite pre-wire error is FAILED-prefixed; timeout/channel uncertainty remains distinct."
    },
    {
      "ref": "src-tauri/src/acp_client/session_commands.rs:158",
      "conclusion": "FAILED CONFIG_* maps to rejected/config_*; other known FAILED permission error remains rejected/failed, not unknown."
    },
    {
      "ref": "src/runtime/sessions.ts:1028",
      "conclusion": "Known rejection removes optimistic user item and pauses without removing exact queued blocks; finally flush persists pause and queue. Unknown result follows a separate uncertain path."
    },
    {
      "ref": "src/runtime/queue.ts:55",
      "conclusion": "Paused queue cannot automatically drain."
    },
    {
      "ref": "src/runtime/sessions.permission-scope.test.ts:140",
      "conclusion": "Existing source test asserts exact input/attachment preservation and no implicit retry after definite permission-scope rejection. Reviewer did not rerun it."
    }
  ],
  "controlledTestDesignReview": {
    "ref": "src-tauri/src/acp_client/prompt_config_race_tests.rs:136",
    "assessment": "The SQLite BEGIN IMMEDIATE barrier, initial prompt poll, observed work lease, and incoming-actor fence distinguish an update already routed during storage wait from timing-by-sleep. Assertions cover wire prompt counts and persisted selection. This is meaningful product-path coverage, not a guard-only mirror.",
    "v1Cases": [
      "established model change",
      "established permission change",
      "first model change",
      "matching established update"
    ],
    "executionStatus": "Not executed by this reviewer; backend owns Cargo and must provide raw exit/result evidence."
  },
  "limits": [
    "drain covers the local queue prefix already routed. It does not provide an atomic protocol guarantee against a remote Agent changing configuration after the final local drain or without a notification.",
    "No installed-app or real-Agent conclusion is established by this source review or controlled fixture.",
    "Permission scope checks are based on currently verified capability shape/effect and should not be generalized to all Agents.",
    "Report intentionally remains OPEN until backend v2 source and controlled regression evidence are independently rechecked."
  ],
