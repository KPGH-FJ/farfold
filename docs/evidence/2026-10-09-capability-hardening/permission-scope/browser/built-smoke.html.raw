<!doctype html><html><head><meta charset="utf-8"><title>Built PDF Worker smoke</title></head><body><p>Controlled bundled PDF Worker check</p><script>
window.workerSmoke=async function(url,capture){let worker;try{return await new Promise((resolve,reject)=>{const timer=setTimeout(()=>{worker?.terminate();reject(Error('built real worker timeout'));},20000);worker=new Worker(url,{type:'module'});worker.addEventListener('error',e=>{clearTimeout(timer);reject(Error('built real worker error '+e.message));});worker.addEventListener('message',e=>{clearTimeout(timer);resolve(e.data);});const raw=atob(capture.data),data=Uint8Array.from(raw,c=>c.charCodeAt(0));worker.postMessage({data,request:{mode:'decoded-page-text',includePossiblyInvisibleText:true}},[data.buffer]);});}finally{worker?.terminate();}};
</script></body></html>
