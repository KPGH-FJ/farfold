import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
const {webkit,chromium}=await import('/Users/tw/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright/index.mjs');
const base='output/2026-10-13-permission-pdf-ui-integration',parent='output/2026-10-13-pdf-input-independent',engine=process.argv[2],label=process.argv[3];
if(!['chromium','webkit'].includes(engine)||!/^run\d+$/.test(label))throw Error('identity required');
const scan=p=>fs.readdirSync(p,{withFileTypes:true}).flatMap(e=>e.isDirectory()?scan(p+'/'+e.name):[p+'/'+e.name]);
const hash=p=>createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const gate=JSON.parse(fs.readFileSync(base+'/source-admission.json'));if(gate.ready!==true||gate.frontendStaticReview?.ready!==true)throw Error('Frozen NEW24 source and first independent review required before this run');
for(const r of gate.frozenRefs)if(hash(r.path)!==r.sha256||fs.statSync(r.path).size!==r.bytes)throw Error('Source admission changed '+r.path);
const isTest=p=>/\.test\.[cm]?[jt]sx?$/.test(p);
const inputs=()=>Object.fromEntries([...scan('src').filter(p=>!isTest(p)),...gate.frozenRefs.map(r=>r.path),...scan(parent+'/fixtures'),...['index.html','fixture.tsx','run.mjs','source-admission.json'].map(n=>base+'/'+n),...['package.json','pnpm-lock.yaml','vite.config.ts']].sort().map(p=>[p,hash(p)]));
const result={schema:1,engine,label,scope:'NEW24 only: complete production App/StrictMode/shared PermissionControl/controller; actual PDF Worker for retained document source. Controlled native IPC replies exercise UI normalization, typed rejection, queue/input preservation and late owners. No actual backend command/permission effect/Agent evidence.',before:inputs(),testsBefore:Object.fromEntries(scan('src').filter(isTest).sort().map(p=>[p,hash(p)])),checks:[],errors:[],externalRequests:[],snapshots:[],limitations:['Backend first-block command gate and effective OS permissions are controlled, not executed or claimed','Only generic capability fact is used; no Agent-specific UI branch','No installed App/real Agent/user DB/new build; built PDF Worker smoke remains separate']};
const browser=await(engine==='webkit'?webkit:chromium).launch({headless:true,executablePath:engine==='webkit'?path.resolve('output/2026-10-10-text-feedback-webkit/browsers/webkit-2336/pw_run.sh'):'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});
let page,scenario;const timer=setTimeout(()=>void browser.close(),240000);
const state=()=>page.evaluate(()=>window.fixture.current());
const count=(s,c)=>s.calls.filter(x=>x.cmd===c).length;
const check=(name,pass,detail)=>{result.checks.push({scenario,name,pass:!!pass,...detail===undefined?{}:{detail}});if(!pass)throw Error(name);};
const owned=()=>page.getByRole('main').filter({has:page.getByRole('heading',{name:'PDF_CONTROLLED',exact:true})});
const control=()=>owned().getByRole('button',{name:'对话权限',exact:true});
const permission=()=>page.getByRole('dialog',{name:'对话权限',exact:true});
const confirm=()=>page.getByRole('dialog',{name:'确认对话权限',exact:true});
async function load(seed={}){if(page)await page.close();page=await browser.newPage({viewport:{width:1100,height:820}});page.setDefaultTimeout(15000);page.on('pageerror',e=>result.errors.push({scenario,error:String(e)}));await page.route('**/*',r=>{if(r.request().url().startsWith('http://127.0.0.1:1534/'))return r.continue();result.externalRequests.push(r.request().url());return r.abort();});await page.addInitScript(seed=>window.fixtureSeed=seed,seed);await page.goto('http://127.0.0.1:1534/'+base+'/index.html');await page.locator('.product-recent').filter({hasText:'PDF_CONTROLLED'}).click();await page.waitForFunction(()=>document.querySelector('textarea')?.value==='KEEP_COMPOSER'&&window.fixture.current().calls.some(c=>c.cmd==='session_open'&&c.args.nativeSessionId==='native-pdf')&&window.fixture.current().thread?.resumed===true);}
async function choosePermission(name='限制访问'){await control().click();await permission().getByRole('radio',{name:new RegExp('^'+name)}).click();await confirm().waitFor();}
async function applyPermission(name='限制访问'){await choosePermission(name);await confirm().getByRole('button',{name:gate.strings.permissionApplyNextOrdinary,exact:true}).click();await confirm().waitFor({state:'hidden'});await page.waitForFunction(()=>window.fixture.current().thread.permissionState==='ready');}
async function readPdf(){await page.getByRole('button',{name:'加入文字',exact:true}).click();const review=page.getByRole('dialog',{name:'加入文档文字',exact:true});await review.getByRole('checkbox').check();await review.getByRole('button',{name:'读取此范围的文字',exact:true}).click();const box=review.getByRole('textbox',{name:'本次拟加入的全部文字',exact:true});await box.waitFor();const text=await box.inputValue();await review.getByRole('checkbox').check();await review.getByRole('button',{name:'只加入已读取文字',exact:true}).click();await review.waitFor({state:'hidden'});await page.waitForFunction(()=>!window.fixture.current().status.saving);return text;}
const effect={configId:'access',appliesAt:'next_ordinary_prompt',currentScope:'unknown'};
try{
 scenario='generic-next-ordinary-fact';await load({noAttachment:true});let s=await state();check('Resumed owner remains required and current full scope is explicitly unknown',s.thread.permissionState==='required'&&JSON.stringify(s.thread.permissionEffect)===JSON.stringify(effect));check('Resumed control exposes required confirmation',(await control().innerText()).includes('待确认'));await control().click();const note=await permission().innerText();check('Permission explanation preserves exact next ordinary timing and unknown current scope',note.includes(gate.strings.permissionScopeNextOrdinary));await page.keyboard.press('Escape');await choosePermission();const beforeCancel=await state();await confirm().getByRole('button',{name:'取消',exact:true}).click();check('Cancel permission review sends no setter and preserves original input',count(await state(),'session_set_config')===count(beforeCancel,'session_set_config')&&(await state()).draft.text==='KEEP_COMPOSER');await applyPermission();s=await state();check('Exact setter ACK confirms next selection without promoting current scope',s.thread.permissionState==='ready'&&s.thread.configOptions.find(x=>x.id==='access').currentValue==='restricted'&&JSON.stringify(s.thread.permissionEffect)===JSON.stringify(effect)&&count(s,'session_prompt')===0);
 await control().click();check('Confirmed selection explicitly names next-message scope',(await permission().innerText()).includes(gate.strings.permissionNextMessage));await page.screenshot({path:base+'/'+engine+'-'+label+'-confirmed-scope.png'});await page.keyboard.press('Escape');await owned().getByRole('button',{name:'发送',exact:true}).click();await page.waitForFunction(()=>window.fixture.current().calls.some(x=>x.cmd==='session_prompt'));s=await state();check('Ordinary message control still sends original text with no host metadata',count(s,'session_prompt')===1&&s.calls.find(x=>x.cmd==='session_prompt').args.content[0].text==='KEEP_COMPOSER'&&!JSON.stringify(s.calls.find(x=>x.cmd==='session_prompt').args.content).includes('permissionEffect'));await page.evaluate(()=>window.fixture.echo());await page.waitForFunction(()=>!window.fixture.current().thread.running);check('Ordinary completion cannot promote current permission scope',JSON.stringify((await state()).thread.permissionEffect)===JSON.stringify(effect));
 for(const [index,invalid] of [null,{configId:'other',appliesAt:'next_ordinary_prompt',currentScope:'unknown'},{configId:'access',appliesAt:'now',currentScope:'unknown'},{configId:'access',appliesAt:'next_ordinary_prompt',currentScope:'known'},{...effect,extra:true}].entries()){scenario='missing-or-invalid-effect-'+index;await load({noAttachment:true,permissionEffect:invalid});s=await state();check('Missing/mismatched/unsupported/extra effect does not claim timing or current complete authority',s.thread.permissionEffect==null&&!(await control().innerText()).includes('下次消息'));}
 for(const command of ['/review controlled change','/compact','/goal set controlled objective']){scenario='rejected-command-'+command.split(' ')[0];await load();await applyPermission();const full=await readPdf();await owned().locator('textarea').fill(command);const approved=(await state()).draft.attachments[0].documentText;await page.evaluate(()=>window.fixture.mode({promptReason:'permission_scope_unverified'}));await owned().getByRole('button',{name:'发送',exact:true}).click();await page.waitForFunction(()=>window.fixture.current().thread.queuePaused&&window.fixture.current().calls.some(x=>x.cmd==='session_prompt')&&!window.fixture.current().thread.submitting);s=await state();const queue=s.thread.queued[0];check('Explicit backend scope rejection keeps exact command/full confirmed attachment in paused queue',queue[0].text===command&&queue.some(x=>x.type==='resource'&&x.resource.text===full&&JSON.stringify(x.localDocumentText)===JSON.stringify(approved.local))&&s.thread.queuePaused==='unavailable'&&s.thread.uncertainPrompt===null&&s.thread.connectionOutcomeUnknown===false&&s.thread.running===false);check('Rejected optimistic user is removed and exact safe reason appears',!s.thread.items.some(x=>x.kind==='user'&&x.text===command)&&s.thread.items.some(x=>x.kind==='notice'&&x.message===gate.strings.permissionScopeUnverified)&&await owned().getByText(gate.strings.permissionScopeUnverified,{exact:true}).count()===1);const rejectedWire=s.calls.find(x=>x.cmd==='session_prompt').args.content;check('Rejected wire retains exact original blocks while excluding local authority',rejectedWire[0].text===command&&rejectedWire.some(x=>x.type==='resource'&&x.resource.text===full&&!Object.hasOwn(x,'localDocumentText'))&&!JSON.stringify(rejectedWire).includes('permissionEffect'));
 await applyPermission('扩大访问');s=await state();check('Confirmed new option cannot auto-retry or resume rejected command queue',count(s,'session_prompt')===1&&s.thread.queued.length===1&&s.thread.queuePaused!==null&&s.thread.configOptions.find(x=>x.id==='access').currentValue==='expanded'&&s.thread.permissionEffect.currentScope==='unknown');await page.screenshot({path:base+'/'+engine+'-'+label+'-rejected-'+command.split(' ')[0].slice(1)+'.png'});result.snapshots.push({scenario,command,wholeTextSha256:createHash('sha256').update(full).digest('hex'),queue:s.thread.queued,permissionEffect:s.thread.permissionEffect,captureCount:count(s,'file_delivery_read_pdf_input'),promptCount:count(s,'session_prompt')});}
 scenario='late-permission-event';await load({noAttachment:true});await applyPermission();await page.evaluate(()=>window.fixture.event({kind:'permissionState',permissionConfigId:'access',permissionState:'unknown',permissionEffect:{configId:'access',appliesAt:'next_ordinary_prompt',currentScope:'unknown'}}));s=await state();check('Unknown effect event pauses owner and preserves input',s.thread.permissionState==='unknown'&&s.thread.queuePaused==='stopped'&&s.draft.text==='KEEP_COMPOSER'&&count(s,'session_prompt')===0);await page.evaluate(()=>window.fixture.event({kind:'permissionState',permissionConfigId:'access',permissionState:'ready',permissionEffect:{configId:'access',appliesAt:'next_ordinary_prompt',currentScope:'unknown'}}));check('Late ready event cannot silently enable unknown owner',(await state()).thread.permissionState==='unknown'&&await owned().getByRole('button',{name:'加入待发',exact:true}).isDisabled());
 scenario='late-setting-replacement-owner';await load({noAttachment:true});await applyPermission();await page.evaluate(()=>window.fixture.mode({configHold:true}));await choosePermission('扩大访问');await confirm().getByRole('button',{name:gate.strings.permissionApplyNextOrdinary,exact:true}).click();await page.waitForFunction(()=>window.fixture.current().pending.includes('config'));const replaced=await page.evaluate(()=>window.fixture.replaceThread());await page.evaluate(()=>window.fixture.release('config'));await page.waitForFunction(()=>window.fixture.current().pending.length===0);s=await state();check('Late exact setter receipt cannot mutate a same-key replacement owner',replaced.sameId&&replaced.differentObject&&s.thread.configOptions.find(x=>x.id==='access').currentValue==='restricted'&&s.thread.permissionState==='ready'&&s.thread.configError===null&&s.thread.configuring===false&&s.draft.text==='KEEP_COMPOSER'&&count(s,'session_prompt')===0);result.snapshots.push({scenario,thread:s.thread,draft:s.draft});
 scenario='retired-setting-error-cannot-affect-successor-review';await load({noAttachment:true});await applyPermission();await page.evaluate(()=>window.fixture.mode({configHold:true}));await choosePermission('扩大访问');await confirm().getByRole('button',{name:gate.strings.permissionApplyNextOrdinary,exact:true}).click();await page.waitForFunction(()=>window.fixture.current().pending.includes('config'));await page.evaluate(()=>window.fixture.replaceThread());await confirm().waitFor({state:'hidden'});await choosePermission('限制访问');await confirm().getByRole('button',{name:gate.strings.permissionApplyNextOrdinary,exact:true}).click();await page.waitForFunction(()=>window.fixture.current().pending.length===2);await page.evaluate(()=>window.fixture.release('config'));await page.waitForFunction(()=>window.fixture.current().pending.length===1);s=await state();check('Retired receipt leaves successor setter pending and cannot publish old choice',s.thread.configuring===true&&s.thread.permissionState==='changing'&&s.thread.configOptions.find(x=>x.id==='access').currentValue==='restricted'&&s.thread.configError===null&&s.draft.text==='KEEP_COMPOSER'&&count(s,'session_prompt')===0);check('Retired setter error cannot attach itself to a later explicit review',await confirm().getByRole('alert').count()===0);await page.evaluate(()=>window.fixture.release('config'));await confirm().waitFor({state:'hidden'});s=await state();check('Only successor exact setter finishes its own current review',s.thread.permissionState==='ready'&&s.thread.configuring===false&&JSON.stringify(s.thread.permissionEffect)===JSON.stringify(effect)&&s.draft.text==='KEEP_COMPOSER'&&count(s,'session_prompt')===0);
 check('No unhandled IPC in final scenario',(await state()).unexpected.length===0);
}catch(e){result.failure=String(e);if(page)await page.screenshot({path:base+'/'+engine+'-'+label+'-failure.png'}).catch(()=>{});result.diagnostic={body:await page.locator('body').innerText().catch(()=>''),state:await state().catch(()=>null),workers:await page.evaluate(()=>window.fixture.workerState()).catch(()=>null)};}
finally{clearTimeout(timer);await browser.close();result.after=inputs();result.testsAfter=Object.fromEntries(scan('src').filter(isTest).sort().map(p=>[p,hash(p)]));result.stable=JSON.stringify(result.before)===JSON.stringify(result.after);result.testChanges=Object.keys({...result.testsBefore,...result.testsAfter}).filter(p=>result.testsBefore[p]!==result.testsAfter[p]);result.passed=!result.failure&&result.stable&&!result.testChanges.length&&!result.errors.length&&!result.externalRequests.length&&result.checks.every(x=>x.pass);fs.writeFileSync(base+'/'+engine+'-'+label+'.json',JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({engine,label,passed:result.passed,checks:result.checks.length,failure:result.failure,errors:result.errors,externalRequests:result.externalRequests,stable:result.stable,testChanges:result.testChanges}));process.exitCode=result.passed?0:1;}
