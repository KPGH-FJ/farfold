import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
const {webkit,chromium}=await import('/Users/tw/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright/index.mjs');
const base='output/2026-10-13-permission-pdf-ui-integration',fixtureBase='output/2026-10-13-pdf-input-independent',engine=process.argv[2],label=process.argv[3];
if(!['chromium','webkit'].includes(engine)||!/^run\d+$/.test(label))throw Error('identity required');
const build=JSON.parse(fs.readFileSync(base+'/root-build-ready.json'));if(build.ready!==true)throw Error('root build completion required');
const scan=p=>fs.readdirSync(p,{withFileTypes:true}).flatMap(e=>e.isDirectory()?scan(p+'/'+e.name):[p+'/'+e.name]);
const hash=p=>createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const inputs=()=>Object.fromEntries([...scan('dist'),...['built-smoke.html','built-smoke.mjs'].map(n=>base+'/'+n),...['01','04','05'].map(n=>fixtureBase+'/fixtures/'+n+'.capture.json')].sort().map(p=>[p,hash(p)]));
const assets=scan('dist/assets').filter(p=>/\/pdf_input\.worker-[\w-]+\.js$/.test(p));if(assets.length!==1)throw Error('Exactly one built input Worker required');
const staticRefs=JSON.parse(fs.readFileSync(base+'/built-static.json')).assets;const served=[];for(const r of staticRefs){const response=await fetch('http://127.0.0.1:1535/'+r.path.replace(/^dist\//,''));const bytes=Buffer.from(await response.arrayBuffer());const sha256=createHash('sha256').update(bytes).digest('hex');if(response.status!==200||sha256!==r.sha256)throw Error('Static server did not preserve built bytes '+r.path);served.push({path:r.path,status:response.status,sha256});}
const result={schema:1,served,engine,label,rootBuild:build,scope:'Actual unchanged root-built PDF input Worker and descendant parser asset, controlled whole fixture bytes. No extra build, native capture, full built App UI, Agent or OS permissions claim.',before:inputs(),checks:[],errors:[],externalRequests:[],asset:assets[0]};
const browser=await(engine==='webkit'?webkit:chromium).launch({headless:true,executablePath:engine==='webkit'?path.resolve('output/2026-10-10-text-feedback-webkit/browsers/webkit-2336/pw_run.sh'):'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});
try{const page=await browser.newPage();page.on('pageerror',e=>result.errors.push(String(e)));await page.route('**/*',r=>{if(r.request().url().startsWith('http://127.0.0.1:1535/'))return r.continue();result.externalRequests.push(r.request().url());return r.abort();});await page.goto('http://127.0.0.1:1535/built-smoke.html');for(const [name,expected] of [['01','inputReady'],['05','incomplete'],['04','encrypted']]){const capture=JSON.parse(fs.readFileSync(fixtureBase+'/fixtures/'+name+'.capture.json'));const value=await page.evaluate(async({url,capture})=>window.workerSmoke(url,capture),{url:'/'+assets[0].replace(/^dist\//,''),capture});const pass=name==='01'?value?.kind==='inputReady'&&value.result?.pages?.length===3&&value.result.pages[2].items.some(i=>i.text==='PAGE_THREE_TAIL')&&value.result.partial===true&&value.result.warnings.length===4:value?.kind==='error'&&value.code===expected;result.checks.push({name,expected,pass,actualKind:value?.kind,actualCode:value?.code,actualPages:value.result?.pages?.length});if(!pass)throw Error('built fixture '+name+' fails');}}catch(e){result.failure=String(e);}finally{await browser.close();result.after=inputs();result.stable=JSON.stringify(result.before)===JSON.stringify(result.after);result.passed=!result.failure&&result.stable&&!result.errors.length&&!result.externalRequests.length&&result.checks.every(x=>x.pass);fs.writeFileSync(base+'/'+engine+'-built-'+label+'.json',JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({engine,label,passed:result.passed,checks:result.checks,failure:result.failure,errors:result.errors,externalRequests:result.externalRequests,stable:result.stable}));process.exitCode=result.passed?0:1;}
