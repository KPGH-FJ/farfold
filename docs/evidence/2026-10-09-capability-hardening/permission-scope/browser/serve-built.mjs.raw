import http from 'node:http';
import fs from 'node:fs';
import path from 'node:path';
const base='output/2026-10-13-permission-pdf-ui-integration';
const builtRoot=path.resolve('dist');
const server=http.createServer((req,res)=>{
 try{const url=new URL(req.url,'http://127.0.0.1:1535');let file;
 if(url.pathname==='/built-smoke.html')file=path.resolve(base,'built-smoke.html');
 else {file=path.resolve(builtRoot,'.'+decodeURIComponent(url.pathname));if(!file.startsWith(builtRoot+path.sep))throw Error('outside');}
 if(!fs.statSync(file).isFile())throw Error('missing');const ext=path.extname(file);const types={'.html':'text/html; charset=utf-8','.js':'text/javascript; charset=utf-8','.json':'application/json','.wasm':'application/wasm','.bcmap':'application/octet-stream','.ttf':'font/ttf'};
 res.writeHead(200,{'Content-Type':types[ext]??'application/octet-stream','Cache-Control':'no-store'});res.end(fs.readFileSync(file));
 }catch{res.writeHead(404);res.end('not found');}
});server.listen(1535,'127.0.0.1',()=>console.log(JSON.stringify({pid:process.pid,port:1535,scope:'Byte-preserving static root dist server for actual built Worker, no Vite transform'})));
for(const signal of ['SIGINT','SIGTERM'])process.on(signal,()=>server.close(()=>process.exit(0)));
