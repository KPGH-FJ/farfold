import React, { StrictMode } from 'react';
import { createRoot } from 'react-dom/client';
import App from '/src/App';
import { DraftStartup } from '/src/components/DraftStartup';
import { StorageStartup } from '/src/components/StorageRecovery';
import { threads, freshThreadState, normalizeConfigOptions } from '/src/runtime/sessions';
import { composerDrafts, newConversationChoice, draftPersistence, fileFeedbackDrafts } from '/src/runtime/drafts';
import { readDocumentInput, confirmDocumentInput, verifyDocumentInput } from '/src/runtime/document_input';
import { userMessageDraftAttachments } from '/src/runtime/message_actions';
import { resourceDraftAttachment } from '/src/runtime/prompt_blocks';
import '@xterm/xterm/css/xterm.css';
import '/src/styles.css'; import '/src/styles-settings.css'; import '/src/styles-content.css';
import '/src/styles-thread.css'; import '/src/styles-artifact.css'; import '/src/product-shell.css';
import '/src/conversation-workspace.css'; import '/src/history-import.css'; import '/src/desktop-workbench.css';


import { readPdfInput } from '/src/runtime/pdf_input_read';
import { renderPdfPage } from '/src/runtime/pdf_preview';
let inputController:AbortController|undefined,previewController:AbortController|undefined;
const jobs:any={};
const resultOf=(p:Promise<any>,key:string)=>{jobs[key]={status:'pending'};void p.then(value=>jobs[key]={status:'resolved',value},e=>jobs[key]={status:'rejected',code:e.code??e.message});};
function startInput(name:string){inputController=new AbortController();resultOf(readPdfInput(clone(captures.get(name)),{mode:'decoded-page-text',includePossiblyInvisibleText:true},inputController.signal),'input');}
function startPreview(){previewController=new AbortController();const raw=atob(captures.get('01').data);const bytes=Uint8Array.from(raw,c=>c.charCodeAt(0));resultOf(renderPdfPage(bytes,document.createElement('canvas'),1,600,previewController.signal,()=>{}),'preview');}

const w = window as any, base='/output/2026-10-13-pdf-input-independent';
const fixtureFiles=await fetch(base+'/fixtures/manifest.json').then(r=>r.json());
const oracle=await fetch(base+'/oracle-authoring-original.json').then(r=>r.json());
const captures = new Map<string,any>();
for(const f of Object.values(fixtureFiles) as any[]) captures.set(f.key,await fetch(base+'/'+f.capture).then(r=>r.json()));
const settings=new Map<string,any>();
const seed=w.fixtureSeed;
if(seed?.unsentWork) settings.set('unsentWork.v1',structuredClone(seed.unsentWork));
const agent={id:'independent-pdf',name:'Controlled document Agent',source:'custom',command:'/controlled/never-executed',args:[],env:[],version:null,handshake:{agentCapabilities:{promptCapabilities:{embeddedContext:true}},authMethods:[],configOptions:[]},createdAt:1,updatedAt:1};
const row={id:'independent-pdf:/controlled/pdf:native-pdf',agentId:agent.id,cwd:'/controlled/pdf',nativeSessionId:'native-pdf',title:'PDF_CONTROLLED',configOptions:null,pinned:false,archived:false,createdAt:1,updatedAt:1};
const draftKey='session:'+row.id;
const permissionOption=(value='restricted')=>({id:'access',name:'文件与网络操作',type:'select',currentValue:value,options:[{value:'restricted',name:'限制访问',description:'受限文件与网络操作'},{value:'expanded',name:'扩大访问',description:'不同的受控选项'}]});
const permissionEffect={configId:'access',appliesAt:'next_ordinary_prompt',currentScope:'unknown'};
const effect=seed && Object.hasOwn(seed,'permissionEffect')?seed.permissionEffect:permissionEffect;
const channels:any[]=[];
const mode={workerHold:false,captureHold:false,inspectHold:false,revisionHold:false,sourceChanged:false,saveFail:false,promptReason:null as null|string,configHold:false,promptHold:false};
const pending:{name:string;resolve:(v:any)=>void;reject:(v:any)=>void;value:any}[]=[];
const clone=(v:any)=>structuredClone(v);
const held=(name:string,value:any)=>new Promise((resolve,reject)=>pending.push({name,resolve,reject,value}));
const captureFor=(file:any)=>{const entry=[...captures.values()].find(v=>v.file.path===file.path);if(!entry)throw {code:'missing'};return entry;};
function events(channel:any,body:string='KEEP_LOADED_BODY') {
  channel.onmessage({update:{sessionUpdate:'user_message_chunk',content:{type:'text',text:body}}});
}
w.testInvoke=async(cmd:string,args:any)=>{
  const {channel,...rest}=args??{};w.calls.push({cmd,args:clone(rest)});
  if(cmd==='settings_get')return args.key==='autoArchiveDays'?0:settings.get(args.key)??null;
  if(cmd==='settings_set'){if(args.key==='unsentWork.v1'&&mode.saveFail)throw Error('OWN_CONTROLLED_SAVE_FAILURE');settings.set(args.key,clone(args.value));return;}
  if(cmd==='storage_recovery_status')return {ready:true,issue:null,dataDirectory:'/controlled/data',databaseReplacementAvailable:false,databaseReplacement:null};
  if(cmd==='app_initial_snapshot')return {agents:[agent],settings:{}};
  if(cmd==='app_default_working_directory')return row.cwd;
  if(cmd==='session_index_list')return [clone(row)];
  if(['catalog_list','catalog_scan','credential_list','desktop_notification_take_pending','prompt_templates_list','agent_status'].includes(cmd))return [];
  if(['app_drafts_ready','host_performance_sample','session_mark_read','session_index_mark_read','session_close','session_dismiss','plugin:event|unlisten'].includes(cmd))return;
  if(cmd==='host_performance_origin')return null;
  if(cmd==='plugin:event|listen')return 1;
  if(cmd==='agent_work_get')return {cwd:args.cwd,enabled:{},locationEnabled:true};
  if(cmd==='desktop_notifications_get')return {enabled:false,successEnabled:false,sound:false};
  if(cmd==='worktree_list')return {locations:[],archives:[],recoveries:[],materials:[],operation:null};
  if(cmd==='browser_share_status')return {taskKey:args.taskKey,label:args.label,agentId:agent.id,phase:'unshared',revision:0,reason:null,pendingRequest:null};
  if(cmd==='file_delivery_inspect_selected') {const cap=[...captures.values()].find(v=>v.file.path===args.path);if(!cap)throw {code:'missing'};return mode.inspectHold?held('inspect',clone(cap.file)):clone(cap.file);}
  if(cmd==='file_delivery_read_visual')return {file:clone(args.file),data:clone(captureFor(args.file)).data};
  if(cmd==='file_delivery_read_pdf_input'){const value=clone(captureFor(args.file));return mode.captureHold?held('capture',value):value;}
  if(cmd==='file_delivery_check_revision'){const value={kind:'verified',file:{...clone(args.file),...(mode.sourceChanged?{version:'controlled-changed-version'}:{})}};return mode.revisionHold?held('revision',value):value;}
  if(cmd==='draft_attachment_check')throw Error('PDF must never be re-read as ordinary UTF8');
  if(cmd==='session_set_config'){const options=[permissionOption(String(args.value))];const value={configOptions:options,configOptionsModern:true,configCheck:{status:'ready',issues:[],protectedIds:[],current:{choices:[]}},permissionConfigId:'access',permissionState:'ready',permissionEffect:effect,service:null};return mode.configHold?held('config',value):value;}
  if(cmd==='session_open'){if(args.nativeSessionId){channels.push(channel);events(channel);channel.onmessage({kind:'session_history_complete',openToken:args.openToken});}return {nativeSessionId:args.nativeSessionId??'controlled-document-preparation',connectionId:'controlled-document-connection',cwd:row.cwd,configOptions:[permissionOption()],configOptionsModern:true,resumed:Boolean(args.nativeSessionId),warnings:[],permissionConfigId:'access',permissionState:'ready',permissionEffect:effect,configCheck:{status:'ready',issues:[],protectedIds:[],current:{choices:[]}}};}
  if(cmd==='session_prompt'){const value=mode.promptReason?{status:mode.promptReason==='uncertain'?'unknown':'rejected',reason:mode.promptReason}:{status:'accepted'};return mode.promptHold?held('prompt',value):value;}
  w.unexpected.push(cmd);throw Error('Unexpected independent controlled IPC '+cmd);
};
settings.set('agentSetup.v1',{version:1,completed:[agent.id],pending:{},progress:{},selections:{[agent.id]:{service:null,config:{}}}});
await draftPersistence.load();
newConversationChoice.cwd=row.cwd;newConversationChoice.agentId=agent.id;
const state=freshThreadState(row.id,agent.id,row.cwd,row.nativeSessionId);
state.configOptions=normalizeConfigOptions([permissionOption()]);state.permissionConfigId='access';state.permissionState='ready';(state as any).permissionEffect=effect;state.configCheck={status:'ready',issues:[],protectedIds:[],current:{choices:[]}};
state.identity='established';state.title=row.title;state.openError=null;state.workEnabled=true;
state.items=[{kind:'user',id:'original-user',text:'KEEP_LOADED_BODY',attachments:[],streaming:false,time:1}];
// Do not preload a live owner: opening the saved index must exercise actual restore normalization.
function fileAttachment(name:string,id='document-chip') {const f=fixtureFiles[name];return{id,kind:'file' as const,name:f.file.name,uri:f.uri,mimeType:'application/pdf'};}
if(!seed?.unsentWork) composerDrafts.update(draftKey,()=>({text:'KEEP_COMPOSER',attachments:seed?.noAttachment?[]:[fileAttachment('01')]}));
fileFeedbackDrafts.update(row.id,'/controlled/keep.txt',{text:'KEEP_OPINION',selection:null});
await draftPersistence.flush();
w.fixture={
  oracle,files:fixtureFiles,draftKey,row,
  workerState:()=>w.workerRecords.map((r:any)=>({url:r.url,terminated:r.terminated,posts:r.posts,held:r.pending.length})),
  workerHold:(value:boolean)=>w.holdPdfWorkers=value,
  releaseWorkers:()=>{for(const r of w.workerRecords)for(const item of r.pending.splice(0))r.worker.postActual(...item);},
  startInput:(name='01')=>startInput(name),abortInput:()=>inputController?.abort(),
  startPreview:()=>startPreview(),tryAdditionalPreview:async()=>{const raw=atob(captures.get('01').data);try{await renderPdfPage(Uint8Array.from(raw,c=>c.charCodeAt(0)),document.createElement('canvas'),1,600,new AbortController().signal,()=>{});return null;}catch(e){return (e as Error).message;}},abortPreview:()=>previewController?.abort(),
  jobs:()=>clone(jobs),
  current:()=>({calls:clone(w.calls),unexpected:clone(w.unexpected),draft:clone(composerDrafts.read(draftKey)),newDraft:clone(composerDrafts.read('new')),thread:JSON.parse(JSON.stringify(threads.thread(row.id))),status:clone(draftPersistence.snapshot()),saved:clone(settings.get('unsentWork.v1')),pending:pending.map(x=>x.name),channels:channels.length,choice:JSON.parse(JSON.stringify(newConversationChoice))}),
  threadPatch:(patch:any)=>{Object.assign(threads.thread(row.id)!,patch);(threads as any).emit();},
  event:(event:any)=>{const channel=channels.at(-1);if(!channel)throw Error('no controlled current channel');channel.onmessage(clone(event));},
  replaceThread:()=>{const original=threads.thread(row.id)!;const replacement=freshThreadState(row.id,agent.id,row.cwd,row.nativeSessionId);replacement.identity='established';replacement.title=row.title;replacement.workEnabled=true;replacement.configOptions=normalizeConfigOptions([permissionOption()]);replacement.permissionConfigId='access';replacement.permissionState='ready';(replacement as any).permissionEffect=effect;replacement.configCheck={status:'ready',issues:[],protectedIds:[],current:{choices:[]}};replacement.items=clone(original.items);threads.getSnapshot().threads.set(row.id,replacement);(threads as any).emit();return {sameId:replacement.key===original.key,differentObject:replacement!==original};},
  mode:(patch:any)=>Object.assign(mode,patch),
  release:(name:string,error?:boolean)=>{const i=pending.findIndex(p=>p.name===name);if(i<0)throw Error('no pending '+name);const [p]=pending.splice(i,1);error?p.reject({code:'unreadable'}):p.resolve(clone(p.value));},
  choose:(name:string)=>composerDrafts.update(draftKey,d=>({...d,attachments:[fileAttachment(name)]})),
  remove:()=>composerDrafts.update(draftKey,d=>({...d,attachments:[]})),
  removeReadd:()=>{const d=composerDrafts.read(draftKey);const a=d.attachments[0];composerDrafts.update(draftKey,x=>({...x,attachments:[]}));composerDrafts.update(draftKey,x=>({...x,attachments:[{...a,loading:false}]}));},
  edit:(text:string)=>composerDrafts.update(draftKey,d=>({...d,text})),
  useUnknown:(text:string)=>composerDrafts.update(draftKey,d=>({...d,attachments:[{...fileAttachment('01'),documentText:{text,local:null},recovered:true}]})),
  flush:()=>draftPersistence.flush(),
  readAPI:(name:string,withScope=true)=>readDocumentInput({uri:fixtureFiles[name].uri,name:fixtureFiles[name].file.name},new AbortController().signal,withScope?{pdf:{mode:'decoded-page-text',includePossiblyInvisibleText:true}}:undefined),
  verifyAPI:(value:any,uri:string,reparse:boolean)=>verifyDocumentInput(value,uri,{reparse}),
  resendFromLocal:()=>{const thread=threads.thread(row.id)!;const user=thread.items.find((i:any)=>i.kind==='user'&&i.attachments?.some((a:any)=>a.localDocumentText));return user?userMessageDraftAttachments((user as any).attachments??[]):null;},
  setKnown:(value:any,recovered=false)=>composerDrafts.update(draftKey,d=>({...d,attachments:[{...fileAttachment('01'),documentText:value,recovered}]})),
  historicalResource:(text:string)=>resourceDraftAttachment({type:'resource',resource:{uri:fixtureFiles['01'].uri,mimeType:'text/plain',text}}),
  echo:()=>{const sent=w.calls.filter((x:any)=>x.cmd==='session_prompt').at(-1);if(!sent)throw Error('no send');const channel=channels.at(-1);const deliver=(event:any)=>channel?channel.onmessage(event):(threads as any).applyChannelEvent(row.id,event);for(const block of sent.args.content)deliver({update:{sessionUpdate:'user_message_chunk',content:clone(block)}});deliver({kind:'turnEnd',stopReason:'end_turn'});},
};
createRoot(document.getElementById('root')!).render(<StrictMode><StorageStartup><DraftStartup><App/></DraftStartup></StorageStartup></StrictMode>);
