import base64
import hashlib
import html
import json
import pathlib
import zipfile

ROOT = pathlib.Path('/Users/tw/Desktop/farfold')
OUT = ROOT / 'output/2026-10-13-docx-input-independent'
FIX = OUT / 'fixtures'
FIX.mkdir(parents=True, exist_ok=True)
W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'
R = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships'
REL = 'http://schemas.openxmlformats.org/package/2006/relationships'
CT = 'http://schemas.openxmlformats.org/package/2006/content-types'

def p(text):
    return '<w:p><w:r><w:t xml:space="preserve">' + html.escape(text) + '</w:t></w:r></w:p>'

def document(body):
    return f'<w:document xmlns:w="{W}" xmlns:r="{R}"><w:body>{body}</w:body></w:document>'

body_values = ['BODY_'+str(i)+'_中文🙂\t[1]|literal' for i in range(45)]
body_values[-1] += '_BODY_TAIL_AFTER_PRESENTATION_PAGE'
cells = [[f'CELL_{r}_{c}' for c in range(7)] for r in range(31)]
cells[-1][-1] += '_LAST_CELL_' + ('表格内全部文字|"\n' * 125) + '_CELL_TAIL_AFTER_600'
table = '<w:tbl><w:tblPr/><w:tblGrid>' + '<w:gridCol w:w="1000"/>' * 7 + '</w:tblGrid>'
for row in cells:
    table += '<w:tr>' + ''.join('<w:tc><w:tcPr/>' + p(text) + '</w:tc>' for text in row) + '</w:tr>'
table += '</w:tbl>'
merge = '<w:tbl><w:tblGrid>' + '<w:gridCol w:w="1200"/>' * 3 + '</w:tblGrid><w:tr><w:tc><w:tcPr><w:gridSpan w:val="2"/><w:vMerge w:val="restart"/></w:tcPr>' + p('MERGED_ANCHOR_ONCE') + '</w:tc><w:tc>' + p('RIGHT_TOP') + '</w:tc></w:tr><w:tr><w:tc><w:tcPr><w:gridSpan w:val="2"/><w:vMerge/></w:tcPr><w:p/></w:tc><w:tc>' + p('RIGHT_BOTTOM') + '</w:tc></w:tr></w:tbl>'
refs = '<w:p><w:r><w:t>AUTHOR_LITERAL_[1]</w:t><w:footnoteReference w:id="1"/><w:footnoteReference w:id="2"/><w:endnoteReference w:id="3"/></w:r></w:p>'
section = '<w:sectPr><w:headerReference w:type="default" r:id="header"/><w:footerReference w:type="default" r:id="footer"/></w:sectPr>'
stories = {
    'word/header.xml': f'<w:hdr xmlns:w="{W}">' + p('HEADER_ALL_STORY_TAIL') + '</w:hdr>',
    'word/footer.xml': f'<w:ftr xmlns:w="{W}">' + p('FOOTER_ALL_STORY_TAIL') + '</w:ftr>',
    'word/footnotes.xml': f'<w:footnotes xmlns:w="{W}"><w:footnote w:id="1">' + p('FOOTNOTE_ONE_TAIL') + '</w:footnote><w:footnote w:id="2"><w:p/></w:footnote></w:footnotes>',
    'word/endnotes.xml': f'<w:endnotes xmlns:w="{W}"><w:endnote w:id="3">' + p('ENDNOTE_THREE_TAIL') + '</w:endnote></w:endnotes>',
}

def package(name, body, include_stories=False, broken=False):
    overrides = {'/word/document.xml': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml'}
    if include_stories:
        for filename, kind in [('header.xml', 'header'), ('footer.xml', 'footer'), ('footnotes.xml', 'footnotes'), ('endnotes.xml', 'endnotes')]:
            overrides['/word/'+filename] = 'application/vnd.openxmlformats-officedocument.wordprocessingml.'+kind+'+xml'
    types = f'<Types xmlns="{CT}"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/>' + ''.join(f'<Override PartName="{part}" ContentType="{mime}"/>' for part, mime in overrides.items()) + '</Types>'
    parts = {'[Content_Types].xml': types, '_rels/.rels': f'<Relationships xmlns="{REL}"><Relationship Id="main" Type="{R}/officeDocument" Target="word/document.xml"/></Relationships>', 'word/document.xml': document(body)}
    if include_stories:
        parts.update(stories)
        parts['word/_rels/document.xml.rels'] = f'<Relationships xmlns="{REL}">' + ''.join(f'<Relationship Id="{kind}" Type="{R}/{kind}" Target="{filename}"/>' for kind, filename in [('header','header.xml'),('footer','footer.xml'),('footnotes','footnotes.xml'),('endnotes','endnotes.xml')]) + '</Relationships>'
    if broken:
        parts['word/document.xml'] = f'<w:document xmlns:w="{W}"><w:body><w:p><w:r><w:t>UNFINISHED'
    archive = FIX / (name+'.docx')
    with archive.open('xb') as raw:
        with zipfile.ZipFile(raw, 'w', zipfile.ZIP_DEFLATED) as z:
            for filename, text in parts.items():
                info = zipfile.ZipInfo(filename, (2026,10,13,0,0,0));info.compress_type = zipfile.ZIP_DEFLATED
                z.writestr(info, text.encode())
    with zipfile.ZipFile(archive) as z:
        assert z.testzip() is None
        entries = z.namelist()
        decoded = {n:z.read(n) for n in entries}
    data = archive.read_bytes()
    file = {'root':str(FIX), 'path':str(archive), 'resolvedPath':str(archive), 'name':archive.name, 'size':len(data), 'sha256':hashlib.sha256(data).hexdigest(), 'version':'independent-owned-'+name+'-v1'}
    capture = {'file':file, 'parts':[{'name':n,'data':base64.b64encode(v).decode()} for n,v in decoded.items()], 'entries':entries, 'inflatedBytes':sum(len(v) for v in decoded.values())}
    with (FIX/(name+'.capture.json')).open('x') as f:json.dump(capture,f,ensure_ascii=False,indent=2);f.write('\n')
    return {'name':name,'archive':str(archive.relative_to(ROOT)),'sha256':file['sha256'],'bytes':len(data),'uri':archive.as_uri(),'file':file,'capture':str((FIX/(name+'.capture.json')).relative_to(ROOT)),'zipCrcVerified':True}

fixtures = [package('full', ''.join(p(x) for x in body_values)+table+merge+refs+section, True), package('partial', p('READABLE_PARTIAL_AUTHOR')+'<w:p><w:r><w:rPr><w:vanish/></w:rPr><w:t>HIDDEN_MUST_NOT_LEAK</w:t></w:r></w:p>'), package('empty-note', '<w:p><w:r><w:footnoteReference w:id="2"/></w:r></w:p>', True), package('literal-note', p('[1]')), package('oversize', p('测'*90000)), package('broken', '', broken=True)]
oracle = {'scope':'Independently authored explicit OOXML/ZIP data and expected author text; no production conversion or author test oracle generates these expectations. Capture protocol derived from own ZIP with Python CRC check; no real native file capture claim.', 'bodyParagraphTexts':body_values,'tableRows':cells,'merge':{'anchor':'MERGED_ANCHOR_ONCE','rowSpan':2,'columnSpan':2,'expectedAnchorOccurrences':1},'stories':['HEADER_ALL_STORY_TAIL','FOOTER_ALL_STORY_TAIL','FOOTNOTE_ONE_TAIL','ENDNOTE_THREE_TAIL'],'literal':'AUTHOR_LITERAL_[1]','emptyNoteOnlyHasNoAuthorText':True,'oversizeTextUtf8Bytes':270000,'fixtureManifest':fixtures}
with (FIX/'oracle.json').open('x') as f:json.dump(oracle,f,ensure_ascii=False,indent=2);f.write('\n')
print(json.dumps({'fixtures':len(fixtures),'bodyParagraphs':len(body_values),'tableRows':len(cells),'tableColumns':7,'lastCellChars':len(cells[-1][-1]),'file':'output/2026-10-13-docx-input-independent/fixtures/oracle.json'},ensure_ascii=False))
