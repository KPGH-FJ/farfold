 check('Sending control belongs to the visible original draft workbench',await activeWorkbench.count()===1&&await activeWorkbench.getByRole('textbox',{name:'对话内容',exact:true}).inputValue()==='KEEP_COMPOSER');
 const send=activeWorkbench.getByRole('button',{name:'发送',exact:true});
 await send.waitFor();await send.click();await page.waitForFunction(()=>window.fixture.current().calls.some(c=>c.cmd==='session_prompt'));let s=await state();const wire=s.calls.find(c=>c.cmd==='session_prompt').args.content;
 check('Actual production send reaches IPC once with exact original URI and full reviewed resource',count(s,'session_prompt')===1&&wire.filter(b=>b.type==='resource').length===1&&wire.some(b=>b.type==='resource'&&b.resource.text===text&&b.resource.mimeType==='text/plain'&&b.resource.uri===oracle.fixtureManifest.find(f=>f.name==='full').uri));
 check('Outgoing official whitelist contains no local source metadata',!JSON.stringify(wire).includes('localDocumentText')&&!JSON.stringify(wire).includes('textSha256')&&wire.every(b=>Object.keys(b).every(k=>['type','text','resource'].includes(k)))&&wire.filter(b=>b.type==='resource').every(b=>Object.keys(b.resource).sort().join(',')==='mimeType,text,uri'));
 const beforeEcho=s.thread.items.filter(i=>i.kind==='user').length;await page.evaluate(()=>window.fixture.echo());await settle();s=await state();check('Official exact echo does not duplicate local outgoing message',s.thread.items.filter(i=>i.kind==='user').length===beforeEcho);const resending=await page.evaluate(()=>window.fixture.resendFromLocal());check('Local message reconstruction preserves exact approved text and local source',resending?.some(a=>a.documentText?.text===text&&a.documentText?.local?.textSha256===approved.local.textSha256));await snap('approved-and-sent');

 await load('cold-known-source-explicit-review',{unsentWork:saved});s=await state();check('Cold restore retains exact text but marks source for review',s.draft.attachments[0].documentText.text===text&&s.draft.attachments[0].recovered===true&&count(s,'session_prompt')===0);
 await page.getByRole('button',{name:'核对附件',exact:true}).click();const recovery=page.getByRole('dialog',{name:'核对恢复的附件',exact:true});await recovery.waitFor();const selected=recovery.getByRole('checkbox');check('Cold recovery requires explicit attachment selection',await selected.count()>=1);await selected.first().check();await recovery.getByRole('button',{name:'保留所选附件',exact:true}).click();await recovery.waitFor({state:'hidden'});await settle();s=await state();check('Explicit cold known-source review re-parses real OOXML and retains identical text',s.draft.attachments[0].recovered===false&&s.draft.attachments[0].documentText.text===text&&count(s,'file_delivery_read_docx')>=1&&count(s,'session_prompt')===0);await noSend();

 await load('unknown-history-source-and-reread');await page.evaluate(()=>window.fixture.useUnknown('PRESERVED_UNKNOWN_TEXT'));await settle();s=await state();check('Unknown historical DOCX resource keeps text and cannot acquire fake source',s.draft.attachments[0].documentText.local===null&&s.draft.attachments[0].documentText.text==='PRESERVED_UNKNOWN_TEXT');await rereadButton().click();await reviewText().waitFor();await dialog().getByText('保留的原文字',{exact:true}).click();check('Explicit reread shows preserved prior text separately',await dialog().getByRole('textbox',{name:'保留的原文字',exact:true}).inputValue()==='PRESERVED_UNKNOWN_TEXT');await dialog().getByRole('button',{name:'取消',exact:true}).click();s=await state();check('Cancel reread retains unknown original text and no source',s.draft.attachments[0].documentText.text==='PRESERVED_UNKNOWN_TEXT'&&s.draft.attachments[0].documentText.local===null&&count(s,'session_prompt')===0);
