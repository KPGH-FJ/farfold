 check('Confirm is keyboard reachable on narrow viewport',await dialog().getByRole('button',{name:'加入这些文字',exact:true}).evaluate(b=>document.activeElement===b));
 const metrics=await dialog().evaluate(d=>{const r=d.getBoundingClientRect();return {x:r.x,right:r.right,width:innerWidth,scroll:d.scrollWidth,client:d.clientWidth};});check('Review fits narrow viewport',metrics.x>=0&&metrics.right<=metrics.width+1&&metrics.scroll<=metrics.client+1,metrics);await snap('full-review-narrow-keyboard');
 await page.setViewportSize({width:1100,height:820});await page.evaluate(()=>document.documentElement.dataset.theme='light');const approved=await approve();const saved=(await state()).saved;
 check('Explicit confirm saves exactly reviewed text and known source without sending',approved.text===text&&approved.local!==null&&JSON.stringify(saved).includes('BODY_TAIL_AFTER_PRESENTATION_PAGE')&&count(await state(),'session_prompt')===0);
 const beforeBadUri=count(await state(),'file_delivery_check_revision');
 const uriFailure=await page.evaluate(async approved=>{try{await window.fixture.verifyAPI(approved,window.fixture.files['literal-note'].uri,false);return null;}catch(e){return e.code;}},approved);
 check('Known text cannot authorize a different selected URI before file checking',uriFailure==='changed'&&count(await state(),'file_delivery_check_revision')===beforeBadUri);
 const digestFailure=await page.evaluate(async approved=>{try{await window.fixture.verifyAPI({...approved,text:approved.text.replace('BODY_0','CODY_0')},window.fixture.files.full.uri,false);return null;}catch(e){return e.code;}},approved);
