const result={engine,label,scope:'Full production App/StrictMode/controllers/draft lifecycle and real production DOCX Worker. Only native IPC/initial data are controlled; OOXML ZIP and oracle independently authored. No formal App/real Agent/account/database/native file-capture claim.',inputBoundary:'All non-*.test.* src files, three frozen backend source files and owned ZIP/oracle/harness inputs. Test-file changes are separately recorded; they do not authorize production-source drift.',before:inputs(),testsBefore:hashes(scan('src').filter(isTest)),checks:[],screenshots:[],errors:[],blockedRequests:[],scenarios:[],limitations:['Author backend controlled RPC evidence remains separate; this browser controls admission results.','Late native rejection after an abort is not by itself evidence that a retired read/confirm catch executed late.','Installed App/real Agent/actual source file I/O and operating-system process cleanup remain untested.']};
const browser=await(engine==='webkit'?webkit:chromium).launch({headless:true,executablePath:engine==='webkit'?path.resolve('output/2026-10-10-text-feedback-webkit/browsers/webkit-2336/pw_run.sh'):'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});
let page,scenario;
const timer=setTimeout(()=>void browser.close(),240000);
const state=()=>page.evaluate(()=>window.fixture.current());
const count=(s,n)=>s.calls.filter(x=>x.cmd===n).length;
const dialog=()=>page.getByRole('dialog',{name:'加入文档文字',exact:true});
const readButton=()=>page.getByRole('button',{name:'加入文字',exact:true});
const rereadButton=()=>page.getByRole('button',{name:'重新读取文字',exact:true});
const reviewText=()=>dialog().getByRole('textbox',{name:'本次拟加入的全部文字',exact:true});
const check=(name,pass,detail)=>{result.checks.push({scenario,name,pass:!!pass,...detail===undefined?{}:{detail}});if(!pass)throw Error(name);};
const settle=()=>page.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))));
async function snap(name){const dest=`${base}/${engine}-${label}-${name}.png`;await page.screenshot({path:dest});result.screenshots.push(dest);}
async function load(name,seed){scenario=name;result.scenarios.push(name);if(page)await page.close();page=await browser.newPage({viewport:{width:1100,height:820}});page.setDefaultTimeout(10000);page.on('pageerror',e=>result.errors.push({scenario:name,error:String(e)}));await page.route('**/*',r=>{if(r.request().url().startsWith('http://127.0.0.1:1526/'))return r.continue();result.blockedRequests.push(r.request().url());return r.abort();});if(seed)await page.addInitScript(seed=>window.fixtureSeed=seed,seed);await page.goto('http://127.0.0.1:1526/'+base+'/index.html');await page.locator('.product-recent').filter({hasText:'DOCX_CONTROLLED'}).click();await page.waitForFunction(()=>document.querySelector('textarea')?.value==='KEEP_COMPOSER');}
async function read(name='full'){if(name!=='full'){await page.evaluate(name=>window.fixture.choose(name),name);await settle();}await readButton().click();await reviewText().waitFor();return reviewText().inputValue();}
async function approve(){await dialog().getByRole('button',{name:'加入这些文字',exact:true}).click();await dialog().waitFor({state:'hidden'});await page.waitForFunction(()=>window.fixture.current().draft.attachments[0]?.documentText&& !window.fixture.current().status.saving);return (await state()).draft.attachments[0].documentText;}
async function noSend(){const s=await state();check('Conversion/review has not dispatched any message',count(s,'session_prompt')===0);check('Controlled IPC has no unhandled commands',s.unexpected.length===0,s.unexpected);}
try{
 await load('whole-OOXML-and-explicit-confirm');const text=await read();const oracle=await page.evaluate(()=>window.fixture.oracle);
