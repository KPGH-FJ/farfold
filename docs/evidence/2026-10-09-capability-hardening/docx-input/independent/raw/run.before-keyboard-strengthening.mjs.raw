 await load('cold-null-source-preserves-authority-gap',{unsentWork:unknownSaved});s=await state();check('Cold null source retains exact old text, marks recovered and never fabricates a source',s.draft.attachments[0].documentText.text==='PRESERVED_UNKNOWN_TEXT'&&s.draft.attachments[0].documentText.local===null&&s.draft.attachments[0].recovered===true&&count(s,'session_prompt')===0);
 const sourceUnknown=await page.evaluate(async()=>{const f=window.fixture;try{await f.verifyAPI(f.current().draft.attachments[0].documentText,f.files.full.uri,true);return null;}catch(e){return e.code;}});
 check('Null metadata cannot silently reparse into sending authority',sourceUnknown==='sourceUnknown'&&count(await state(),'file_delivery_read_docx')===0);
 await rereadButton().click();await reviewText().waitFor();await approve();s=await state();check('Only explicit fresh reread and confirm replace unknown text with verified source',s.draft.attachments[0].documentText.local!==null&&s.draft.attachments[0].documentText.text===text);await noSend();

 await load('partial-non-default-consent');await read('partial');check('Partial range checkbox starts unchecked and confirmation disabled',!(await dialog().getByRole('checkbox').isChecked())&&await dialog().getByRole('button',{name:'只加入已读取文字',exact:true}).isDisabled());check('Hidden author content is omitted and partial range is explicit',!(await reviewText().inputValue()).includes('HIDDEN_MUST_NOT_LEAK')&&(await dialog().innerText()).includes('部分内容未读取'));await snap('partial-review');await dialog().getByRole('checkbox').check();await dialog().getByRole('button',{name:'只加入已读取文字',exact:true}).click();await dialog().waitFor({state:'hidden'});s=await state();check('Explicit partial selection persists the actual selected range',s.draft.attachments[0].documentText.local.partial&&s.draft.attachments[0].documentText.local.partialSelected);await noSend();

 for(const name of ['empty-note','oversize','broken']){await load('error-'+name);await page.evaluate(name=>window.fixture.choose(name),name);await settle();await readButton().click();await dialog().getByRole('alert').waitFor();const message=await dialog().getByRole('alert').innerText();s=await state();check(name+' rejects without creating text or clearing input',!s.draft.attachments[0].documentText&&s.draft.text==='KEEP_COMPOSER'&&count(s,'session_prompt')===0);if(name==='empty-note')check('Empty generated note marker does not count as author text',message.includes('没有读到可加入的文字'));if(name==='oversize')check('UTF8 overlimit rejects whole representation without truncation',message.includes('256 KiB'));await snap('error-'+name);await dialog().getByRole('button',{name:'取消',exact:true}).click();await noSend();}
