}catch(error){result.failure=String(error);if(page){result.diagnostic={body:await page.locator('body').innerText().catch(()=>''),aria:await page.locator('body').ariaSnapshot().catch(()=>''),state:await state().catch(()=>null)};await snap('failure').catch(()=>{});}}
finally{clearTimeout(timer);await browser.close();result.after=inputs();result.testsAfter=hashes(scan('src').filter(isTest));result.changedTestInputs=Object.keys({...result.testsBefore,...result.testsAfter}).filter(p=>result.testsBefore[p]!==result.testsAfter[p]);result.sourceStable=JSON.stringify(result.before)===JSON.stringify(result.after);result.passed=!result.failure&&result.sourceStable&&result.errors.length===0&&result.blockedRequests.length===0&&result.checks.every(x=>x.pass);fs.writeFileSync(`${base}/${engine}-${label}.json`,JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({engine,label,passed:result.passed,checks:result.checks.length,failure:result.failure,errors:result.errors,blockedRequests:result.blockedRequests,sourceStable:result.sourceStable,changedTestInputs:result.changedTestInputs}));process.exitCode=result.passed?0:1;}
