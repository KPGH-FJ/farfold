 check('All31×7 table cells including long final cell are present in full structure',tables[0]?.rows.length===31&&tables[0].rows.every((r,i)=>r.cells.length===7&&r.cells.every((c,j)=>c.blocks[0].text===oracle.tableRows[i][j])));
