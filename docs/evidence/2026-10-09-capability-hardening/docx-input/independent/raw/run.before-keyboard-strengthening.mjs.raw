 await load('exact-selection-ABA-and-late-native-failure');await page.evaluate(()=>window.fixture.mode({captureHold:true}));await readButton().click();await page.waitForFunction(()=>window.fixture.current().pending.includes('capture'));await page.evaluate(()=>window.fixture.removeReadd());await dialog().waitFor({state:'hidden'});await page.evaluate(()=>window.fixture.release('capture',true));await settle();s=await state();check('Remove/readd cannot restore former review or late source authority',!s.draft.attachments[0].documentText&&!s.draft.attachments[0].loading&&count(s,'session_prompt')===0);await page.evaluate(()=>window.fixture.mode({captureHold:false}));await read();await approve();await noSend();

 for(const hold of ['capture','revision']){await load('retired-'+hold+'-failure-with-successor');if(hold==='capture'){await page.evaluate(()=>window.fixture.mode({captureHold:true}));await readButton().click();await page.waitForFunction(()=>window.fixture.current().pending.includes('capture'));}else{await read();await page.evaluate(()=>window.fixture.mode({revisionHold:true}));await dialog().getByRole('button',{name:'加入这些文字',exact:true}).click();await page.waitForFunction(()=>window.fixture.current().pending.includes('revision'));}await dialog().getByRole('button',{name:'取消',exact:true}).click();await dialog().waitFor({state:'hidden'});await page.evaluate(()=>window.fixture.mode({captureHold:true,revisionHold:false}));await readButton().click();await page.waitForFunction(hold=>window.fixture.current().pending.length>=2,hold);await page.evaluate(hold=>window.fixture.release(hold,true),hold);await settle();s=await state();check('Retired '+hold+' native failure cannot error/clear successor reading',await dialog().getByText('正在读取文档文字…',{exact:true}).isVisible()&&await dialog().getByRole('alert').count()===0&&s.draft.attachments[0].loading);await page.evaluate(()=>window.fixture.mode({captureHold:false}));await page.evaluate(()=>window.fixture.release('capture'));await reviewText().waitFor();await approve();await noSend();}

