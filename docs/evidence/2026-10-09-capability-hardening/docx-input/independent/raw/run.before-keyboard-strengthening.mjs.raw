const base='output/2026-10-13-docx-input-independent',engine=process.argv[2]??'webkit',label=process.argv[3]??'run01';
if(!['webkit','chromium'].includes(engine)||!/^run\d+$/.test(label))throw Error('invalid run identity');
const scan=p=>fs.readdirSync(p,{withFileTypes:true}).flatMap(e=>e.isDirectory()?scan(p+'/'+e.name):[p+'/'+e.name]);
const hashes=paths=>Object.fromEntries(paths.sort().map(p=>[p,createHash('sha256').update(fs.readFileSync(p)).digest('hex')]));
