  "findings": [],
  "codeReview": [
    {
      "path": "src-tauri/src/file_delivery/document.rs",
      "start": 39,
      "conclusion": "read_docx_search has its own MAX_TEXT_BYTES (1 MiB) capture. open_source_detailed validates absolute/canonical root and requested/resolved location plus metadata cap before body capture; name/size/saved version are checked before body. capture_opened bounds growth at max+1, rechecks safe handle/path/stamp and returns a newly computed full SHA. Complete VerifiedFile equality is required before unpack."
    },
    {
      "path": "src-tauri/src/file_delivery/ooxml_archive.rs",
      "start": 235,
      "conclusion": "Existing pre-index central/local directory, count, duplicate/name/overlap/encryption/ZIP64 checks are reused unchanged. Every member, including omitted binary, is read through bounded EOF/CRC before inclusion. Per-part16MiB, total64MiB and2048 entries remain finite inflation bounds; this is not a1MiB inflated-text promise."
    },
    {
      "path": "src-tauri/src/file_delivery_commands.rs",
      "start": 151,
      "conclusion": "Main caller guard precedes checked_docx_search, which uses the actual shared file_read_check::run rather than a new pool. Its nested domain result maps changed/limit/invalid/etc and outer pending/busy separately. lib registers the same handler. Actual Webview invocation is not covered by helper tests."
    },
    {
      "path": "src-tauri/src/file_read_check.rs",
      "start": 51,
      "conclusion": "Unchanged real semaphore permit lives inside the blocking closure and is not released by dropped or timed-out response; it remains shared with other file checks. The new command-helper test saturates this production admission and verifies busy followed by actual capture and limit after release."
    },
    {
      "path": "src-tauri/src/file_delivery/document.rs",
      "start": 11,
      "conclusion": "Legacy read_docx still calls old read_archive16MiB with equivalent selection closure. New search limit does not silently lower normal preview limit. Extension or ZIP capture alone does not authenticate OPC/author text, which stays the frontend parser responsibility."
    }
  ],
  "counterexampleEvidence": {
    "red": "The temporary delegate of the newly proposed search API accepted a valid ZIP of1MiB+1: actual exit101,1pass/1fail. Legacy16MiB behavior is intentional, not retrospectively called a legacy bug.",
    "newCaptureTests": 7,
    "newCaptureCoverage": [
      "Exactly1MiB success and1MiB+1 refusal while legacy remains usable",
      "Oversize at open and post-open growth; source path shows size failure before hashing",
      "Each of seven saved source fields changes independently",
      "Same-byte inode replacement after open",
      "Symlink redirected after saved receipt",
      "Ignored binary CRC corruption",
      "Compressed member expanding to MAX_PART+1",
      "Suffix does not authenticate ZIP or DOCX semantics"
    ],
    "legacyDocxRegressionTests": 11,
    "productionSharedAdmissionHelperTests": 1,
    "sharedTimeoutDropAndCapacityTests": 5,
