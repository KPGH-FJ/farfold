  "review": [
    {
      "area": "Explicit authorization and source ownership",
      "files": [
        "src/runtime/attachment_search_source.ts:103",
        "src/components/SelectedAttachmentSearch.tsx:90"
      ],
      "result": "Explicit Start over at most 20 known WeakMap candidates; captured URI/name/MIME, message attachment object, thread and current index agent/cwd/native-session fields stay checked. MIME selects a parser only, never authenticates a DOCX."
    },
    {
      "area": "Bounded capture and source identity",
      "files": [
        "src/runtime/attachment_search.ts:339",
        "src/runtime/attachment_search.ts:351",
        "src/runtime/attachment_search.ts:373",
        "src/runtime/attachment_search.ts:382"
      ],
      "result": "The new bounded DOCX IPC is used with all seven VerifiedFile fields; capture, parsed preview and final revision must agree. Missing/invalid parse fails explicitly without plain-text fallback. Backend safe capture and shared OS pool are covered separately by backend-review.json."
    },
    {
      "area": "Real text and budget",
      "files": [
        "src/runtime/docx_search_text.ts:39",
        "src/runtime/attachment_search.ts:415",
        "src/runtime/attachment_search.ts:441"
      ],
      "result": "Only validated author run text, actual tab and line break enter search. Images, notices and note references break segments; paragraph, cell and story boundaries never join. Generated labels and alt text are excluded. TextEncoder counts extracted UTF-8 bytes; whole-file admission is at most 16 MiB, with no prefix search. Unknown temporary reservations wait instead of consuming later candidates."
    },
    {
      "area": "Concurrency, cancellation and errors",
      "files": [
        "src/runtime/attachment_search.ts:158",
        "src/runtime/attachment_search.ts:338",
        "src/runtime/attachment_search.ts:363",
        "src/runtime/attachment_search.ts:399"
      ],
      "result": "At most two captured/read tasks; per-batch parseTail serializes the single Worker. External Worker busy is reported, not retried. Every asynchronous boundary discards cancelled/stale results; cancellation does not claim an OS read stopped or release its Rust permit. readPending/readBusy/limit/encrypted/timeout remain distinct."
    },
    {
      "area": "Jump and persistence",
      "files": [
        "src/runtime/attachment_search.ts:526",
        "src/components/AttachmentSearchJump.tsx",
        "src/App.tsx"
      ],
      "result": "Result navigation rechecks the exact file and current source, then jumps to an already loaded declared attachment with existing DOM-owner checks. No Word visual page or conversation text offset is invented. Search contents/results remain temporary; no new persistence or Agent request path."
    }
  ],
