{"timestamp":"2026-10-13T16:58:33.942Z","ordinal":4818,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13410-a021-7660-b316-4a5e2c3de35f","turn_id":"01a13621-a9b7-76e0-8ce5-f906af34e17b","item":{"type":"CommandExecution","id":"exec-4eb4fdac-e13a-482b-9b37-a23fd5f4b900","process_id":"94805","command":["/bin/zsh","-lc","python3 - <<'PY'\np='src/runtime/docx_search_text.test.ts';s=open(p).read().replace('[\"body\", \"body\", \"body\", \"body\", \"header\", \"footer\", \"footnote\", \"endnote\"]','[\"body\", \"body\", \"body\", \"body\", \"footnote\", \"endnote\", \"header\", \"footer\"]');s=s.replace('hits[6].location.noteId','hits[4].location.noteId').replace('hits[6].location.source.part','hits[4].location.source.part').replace('docxSearchLocationLabel(hits[6].location)','docxSearchLocationLabel(hits[4].location)');open(p,'w').write(s)\nPY\ncp src/runtime/attachment_search.docx.test.ts output/2026-10-14-docx-search-frontend/red-case-test.ts.raw\ncat > src/runtime/attachment_search.docx.test.ts <<'EOF'\nimport { describe, expect, it, vi } from \"vitest\";\nimport { deferred, setup, tick } from \"./attachment_search.test-support\";\nimport { AttachmentSearch } from \"./attachment_search\";\nimport { attachmentSearchCandidates, attachmentSearchSourceCurrent } from \"./attachment_search_source\";\nimport { DocxError, type DocxCapture, type DocxPreview } from \"./docx_types\";\nimport type { VerifiedFile } from \"./file_delivery\";\n\nfunction docxSetup(texts = [\"author needle tail\"], plain: string[] = []) {\n  const h = setup([...texts.map(() => \"compressed source\"), ...plain]);\n  const captures = new Map<string, DocxCapture>(), previews = new Map<string, DocxPreview>();\n  texts.forEach((text, i) => {\n    const item = h.s.items[i];\n    if (item.kind !== \"user\" && item.kind !== \"agent\") throw Error();\n    const path = `/fixture/chosen${i}.docx`;\n    item.attachments![0] = {name: `chosen${i}.docx`, uri: `file://${path}`};\n    const file = {...h.files.get(`/fixture/file${i}.txt`)!, path, resolvedPath: path, name: `chosen${i}.docx`};\n    h.files.set(path, file);\n    captures.set(path, {file, parts: [{name: \"word/document.xml\", data: \"eA==\"}], entries: [\"word/document.xml\"], inflatedBytes: 1});\n    previews.set(path, {file, blocks: [{kind: \"paragraph\", id: \"p1\", style: {}, source: {part: \"word/document.xml\", elementPath: [0,0]}, runs: [{kind:\"text\", text, style:{}}]}], stories:[], images:[], warnings:[], partial:false});\n  });\n  const services = {...h.services,\n    readDocx: vi.fn(async (f: VerifiedFile) => captures.get(f.path)!),\n    parseDocx: vi.fn(async (c: DocxCapture, _signal: AbortSignal) => previews.get(c.file.path)!),\n  };\n  let candidates = attachmentSearchCandidates([h.s.key], h.states).candidates;\n  const refresh = () => candidates = attachmentSearchCandidates([h.s.key], h.states).candidates;\n  const current = () => candidates.every(c => attachmentSearchSourceCurrent(c, h.states));\n  const file = captures.values().next().value!.file, capture = captures.get(file.path)!, preview = previews.get(file.path)!;\n  return {...h, file, capture, preview, captures, previews, services, candidates, current, refresh, search: new AttachmentSearch(services)};\n}\n\ndescribe(\"explicit current DOCX attachment search\", () => {\n  it(\"searches selected DOCX author text through the bounded document route\", async () => {\n    const h = docxSetup();\n    await h.search.start(\"needle\", h.candidates, h.current);\n    expect(h.search.snapshot().matches).toBe(1);\n    expect(h.services.readDocx).toHaveBeenCalledOnce();\n    expect(h.services.read).not.toHaveBeenCalled();\n    expect(h.search.snapshot().hits[0]).toMatchObject({source: h.candidates[0], before: \"author \", match:\"needle\", after:\" tail\", location: {region:\"body\", paragraph:1}});\n    expect(h.search.snapshot().bytes).toBe(18);\n  });\n  it.each([\"application/vnd.openxmlformats-officedocument.wordprocessingml.document\", \" Application/Vnd.Openxmlformats-Officedocument.Wordprocessingml.Document ; charset=UTF-8\"])(\"uses shared MIME essence for extensionless DOCX: %s\", async mimeType => {\n    const h=docxSetup(), item=h.s.items[0];\n    if(item.kind!==\"user\") throw Error();\n    const path=\"/fixture/extensionless\";\n    item.attachments[0]={name:\"display.txt\", uri:`file://${path}`, mimeType};\n    Object.assign(h.file,{path,resolvedPath:path,name:\"extensionless\"});\n    h.files.set(path,h.file); h.captures.set(path,h.capture); h.previews.set(path,h.preview);\n    await h.search.start(\"needle\",h.refresh(),h.current);\n    expect(h.search.snapshot().matches).toBe(1);expect(h.services.read).not.toHaveBeenCalled();\n  });\n  it(\"uses actual uppercase DOCX location, never a misleading display name alone\", async()=>{\n    const h=docxSetup(),item=h.s.items[0];if(item.kind!==\"user\")throw Error();\n    item.attachments[0]={name:\"chosen.docx\",uri:\"file:///fixture/file0.txt\"};\n    await h.search.start(\"compressed\",h.refresh(),h.current);\n    expect(h.services.readDocx).not.toHaveBeenCalled();expect(h.services.read).toHaveBeenCalledOnce();\n    const path=\"/fixture/UPPER.DOCX\"; item.attachments[0]={name:\"other\",uri:`file://${path}`};\n    Object.assign(h.file,{path,resolvedPath:path,name:\"UPPER.DOCX\"});h.files.set(path,h.file);h.captures.set(path,h.capture);h.previews.set(path,h.preview);\n    await h.search.start(\"needle\",h.refresh(),h.current); expect(h.search.snapshot().matches).toBe(1);\n  });\n  it(\"MIME mutation invalidates ownership and cannot publish a late capture\",async()=>{\n    const h=docxSetup(), wait=deferred<DocxCapture>();h.services.readDocx.mockImplementation(()=>wait.promise);\n    const run=h.search.start(\"needle\",h.candidates,h.current);await tick();\n    const item=h.s.items[0];if(item.kind!==\"user\")throw Error();item.attachments[0].mimeType=\"text/plain\";\n    expect(h.current()).toBe(false);wait.resolve(h.capture);await run;\n    expect(h.search.snapshot()).toMatchObject({phase:\"stale\",hits:[]});expect(h.services.parseDocx).not.toHaveBeenCalled();\n  });\n  it.each([\"root\",\"path\",\"resolvedPath\",\"name\",\"size\",\"sha256\",\"version\"] as const)(\"rejects changed capture source %s before parsing\",async key=>{\n    const h=docxSetup();h.services.readDocx.mockResolvedValue({...h.capture,file:{...h.file,[key]:key===\"size\"?9:key===\"sha256\"?\"b\".repeat(64):\"/changed\"}});\n    await h.search.start(\"needle\",h.candidates,h.current);\n    expect(h.search.snapshot().rows[0].code).toBe(\"changed\");expect(h.services.parseDocx).not.toHaveBeenCalled();\n  });\n  it.each([\"root\",\"path\",\"resolvedPath\",\"name\",\"size\",\"sha256\",\"version\"] as const)(\"rejects changed parsed source %s\",async key=>{\n    const h=docxSetup();h.services.parseDocx.mockResolvedValue({...h.preview,file:{...h.file,[key]:key===\"size\"?9:key===\"sha256\"?\"b\".repeat(64):\"/changed\"}});\n    await h.search.start(\"needle\",h.candidates,h.current);expect(h.search.snapshot().hits).toEqual([]);expect(h.services.check).not.toHaveBeenCalled();\n  });\n  it.each([\"root\",\"path\",\"resolvedPath\",\"name\",\"size\",\"sha256\",\"version\"] as const)(\"rejects changed final revision %s and hides author text\",async key=>{\n    const h=docxSetup();h.services.check.mockResolvedValue({kind:\"verified\",file:{...h.file,[key]:key===\"size\"?9:key===\"sha256\"?\"b\".repeat(64):\"/changed\"}});\n    await h.search.start(\"needle\",h.candidates,h.current);expect(h.search.snapshot().hits).toEqual([]);expect(h.search.snapshot().rows[0].state).toBe(\"error\");\n  });\n  it.each([[\"readPending\",\"pending\"],[\"readBusy\",\"busy\"],[\"limit\",\"documentLimit\"],[\"encrypted\",\"encrypted\"],[\"invalid\",\"invalid\"],[\"unsupported\",\"unsupported\"],[\"unreadable\",\"unreadable\"],[\"changed\",\"changed\"]])(\"preserves native %s reason as %s\",async(code,expected)=>{\n    const h=docxSetup();h.services.readDocx.mockRejectedValue({code});await h.search.start(\"needle\",h.candidates,h.current);\n    expect(h.search.snapshot().rows[0].code).toBe(expected);expect(h.search.snapshot().hits).toEqual([]);expect(h.services.parseDocx).not.toHaveBeenCalled();expect(h.services.read).not.toHaveBeenCalled();\n  });\n  it.each([\"busy\",\"timeout\",\"limit\",\"unsupported\"] as const)(\"retains Worker %s reason without ordinary text fallback\",async code=>{\n    const h=docxSetup();h.services.parseDocx.mockRejectedValue(new DocxError(code));await h.search.start(\"needle\",h.candidates,h.current);\n    expect(h.search.snapshot().rows[0].code).toBe(code===\"limit\"?\"documentLimit\":code);expect(h.services.read).not.toHaveBeenCalled();\n  });\n  it(\"serializes same-batch parsers while bounded reads may prefetch two\",async()=>{\n    const h=docxSetup([\"first needle\",\"second needle\",\"third needle\"]), first=deferred<DocxPreview>();let active=0,max=0;\n    h.services.parseDocx.mockImplementation(async(c)=>{active++;max=Math.max(max,active);try{return c.file===h.capture.file?await first.promise:h.previews.get(c.file.path)!;}finally{active--;}});\n    const run=h.search.start(\"needle\",h.candidates,h.current);await tick();\n    expect(h.services.readDocx).toHaveBeenCalledTimes(2);expect(h.services.parseDocx).toHaveBeenCalledOnce();first.resolve(h.preview);await run;\n    expect(max).toBe(1);expect(h.search.snapshot().matches).toBe(3);expect(h.services.parseDocx).toHaveBeenCalledTimes(3);\n  });\n  it(\"cancels Worker work and drops a late result without starting another parser\",async()=>{\n    const h=docxSetup([\"needle\",\"needle\"]),wait=deferred<DocxPreview>();let signal:AbortSignal|undefined;\n    h.services.parseDocx.mockImplementation((_c,s)=>{signal=s;return wait.promise;});const run=h.search.start(\"needle\",h.candidates,h.current);await tick();h.search.cancel();expect(signal?.aborted).toBe(true);wait.resolve(h.preview);await run;\n    expect(h.services.parseDocx).toHaveBeenCalledOnce();expect(h.search.snapshot()).toMatchObject({phase:\"cancelled\",hits:[]});expect(h.services.check).not.toHaveBeenCalled();\n  });\n  it(\"waits for already started native captures on cancel and retains late unknown state\",async()=>{\n    const h=docxSetup([\"needle\",\"needle\",\"needle\"]),wait=deferred<DocxCapture>();h.services.readDocx.mockImplementation(()=>wait.promise);\n    const run=h.search.start(\"needle\",h.candidates,h.current);await tick();h.search.cancel();expect(h.search.active()).toBe(true);expect(h.search.snapshot().phase).toBe(\"cancelling\");expect(h.services.readDocx).toHaveBeenCalledTimes(2);\n    wait.reject({code:\"readPending\"});await run;expect(h.search.snapshot()).toMatchObject({phase:\"pending\",hits:[]});expect(h.services.parseDocx).not.toHaveBeenCalled();\n  });\n  it(\"accounts actual extracted UTF8 instead of compressed size or UTF16 in mixed batches\",async()=>{\n    const text=\"界\".repeat(3_000_000)+\" needle\", h=docxSetup([text,text],[\"needle\"]);\n    await h.search.start(\"needle\",h.candidates,h.current);\n    expect(h.search.snapshot()).toMatchObject({bytes:9_000_013,matches:2});expect(h.search.snapshot().rows.map(r=>r.state)).toEqual([\"searched\",\"skipped\",\"searched\"]);expect(h.search.snapshot().rows[1].code).toBe(\"budget\");\n  });\n  it(\"accepts exact16MiB extracted bytes and skips only the one-byte excess\",async()=>{\n    const h=docxSetup([\"界\".repeat(4*1024*1024),\"a\".repeat(4*1024*1024)],[\"x\"]);\n    await h.search.start(\"zz\",h.candidates,h.current);expect(h.search.snapshot().bytes).toBe(16*1024*1024);expect(h.search.snapshot().rows.map(r=>r.state)).toEqual([\"searched\",\"searched\",\"skipped\"]);expect(h.services.read).not.toHaveBeenCalled();\n  });\n  it(\"does not parse a capture beyond the existing inflation budget\",async()=>{\n    const h=docxSetup();h.capture.inflatedBytes=64*1024*1024+1;await h.search.start(\"needle\",h.candidates,h.current);expect(h.search.snapshot().rows[0].code).toBe(\"documentLimit\");expect(h.services.parseDocx).not.toHaveBeenCalled();\n  });\n  it(\"rechecks revision before navigating a DOCX author snippet\",async()=>{\n    const h=docxSetup();await h.search.start(\"needle\",h.candidates,h.current);h.services.check.mockResolvedValue({kind:\"verified\",file:{...h.file,version:\"new\"}});expect(await h.search.verifyHit(h.search.snapshot().hits[0],h.current)).toBe(false);expect(h.search.snapshot()).toMatchObject({phase:\"stale\",hits:[],error:\"changed\"});\n  });\n});\nEOF\ncorepack pnpm exec vitest run src/runtime/attachment_search.docx.test.ts src/runtime/docx_search_text.test.ts > output/2026-10-14-docx-search-frontend/targeted-04.txt 2>&1"],"cwd":"file:///Users/tw/Desktop/farfold","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\np='src/runtime/docx_search_text.test.ts';s=open(p).read().replace('[\"body\", \"body\", \"body\", \"body\", \"header\", \"footer\", \"footnote\", \"endnote\"]','[\"body\", \"body\", \"body\", \"body\", \"footnote\", \"endnote\", \"header\", \"footer\"]');s=s.replace('hits[6].location.noteId','hits[4].location.noteId').replace('hits[6].location.source.part','hits[4].location.source.part').replace('docxSearchLocationLabel(hits[6].location)','docxSearchLocationLabel(hits[4].location)');open(p,'w').write(s)\nPY\ncp src/runtime/attachment_search.docx.test.ts output/2026-10-14-docx-search-frontend/red-case-test.ts.raw\ncat > src/runtime/attachment_search.docx.test.ts <<'EOF'\nimport { describe, expect, it, vi } from \"vitest\";\nimport { deferred, setup, tick } from \"./attachment_search.test-support\";\nimport { AttachmentSearch } from \"./attachment_search\";\nimport { attachmentSearchCandidates, attachmentSearchSourceCurrent } from \"./attachment_search_source\";\nimport { DocxError, type DocxCapture, type DocxPreview } from \"./docx_types\";\nimport type { VerifiedFile } from \"./file_delivery\";\n\nfunction docxSetup(texts = [\"author needle tail\"], plain: string[] = []) {\n  const h = setu