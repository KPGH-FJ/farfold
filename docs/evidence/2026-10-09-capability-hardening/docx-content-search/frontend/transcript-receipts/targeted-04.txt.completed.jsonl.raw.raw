ther parser\",async()=>{\n    const h=docxSetup([\"needle\",\"needle\"]),wait=deferred<DocxPreview>();let signal:AbortSignal|undefined;\n    h.services.parseDocx.mockImplementation((_c,s)=>{signal=s;return wait.promise;});const run=h.search.start(\"needle\",h.candidates,h.current);await tick();h.search.cancel();expect(signal?.aborted).toBe(true);wait.resolve(h.preview);await run;\n    expect(h.services.parseDocx).toHaveBeenCalledOnce();expect(h.search.snapshot()).toMatchObject({phase:\"cancelled\",hits:[]});expect(h.services.check).not.toHaveBeenCalled();\n  });\n  it(\"waits for already started native captures on cancel and retains late unknown state\",async()=>{\n    const h=docxSetup([\"needle\",\"needle\",\"needle\"]),wait=deferred<DocxCapture>();h.services.readDocx.mockImplementation(()=>wait.promise);\n    const run=h.search.start(\"needle\",h.candidates,h.current);await tick();h.search.cancel();expect(h.search.active()).toBe(true);expect(h.search.snapshot().phase).toBe(\"cancelling\");expect(h.services.readDocx).toHaveBeenCalledTimes(2);\n    wait.reject({code:\"readPending\"});await run;expect(h.search.snapshot()).toMatchObject({phase:\"pending\",hits:[]});expect(h.services.parseDocx).not.toHaveBeenCalled();\n  });\n  it(\"accounts actual extracted UTF8 instead of compressed size or UTF16 in mixed batches\",async()=>{\n    const text=\"界\".repeat(3_000_000)+\" needle\", h=docxSetup([text,text],[\"needle\"]);\n    await h.search.start(\"needle\",h.candidates,h.current);\n    expect(h.search.snapshot()).toMatchObject({bytes:9_000_013,matches:2});expect(h.search.snapshot().rows.map(r=>r.state)).toEqual([\"searched\",\"skipped\",\"searched\"]);expect(h.search.snapshot().rows[1].code).toBe(\"budget\");\n  });\n  it(\"accepts exact16MiB extracted bytes and skips only the one-byte excess\",async()=>{\n    const h=docxSetup([\"界\".repeat(4*1024*1024),\"a\".repeat(4*1024*1024)],[\"x\"]);\n    await h.search.start(\"zz\",h.candidates,h.current);expect(h.search.snapshot().bytes).toBe(16*1024*1024);expect(h.search.snapshot().rows.map(r=>r.state)).toEqual([\"searched\",\"searched\",\"skipped\"]);expect(h.services.read).not.toHaveBeenCalled();\n  });\n  it(\"does not parse a capture beyond the existing inflation budget\",async()=>{\n    const h=docxSetup();h.capture.inflatedBytes=64*1024*1024+1;await h.search.start(\"needle\",h.candidates,h.current);expect(h.search.snapshot().rows[0].code).toBe(\"documentLimit\");expect(h.services.parseDocx).not.toHaveBeenCalled();\n  });\n  it(\"rechecks revision before navigating a DOCX author snippet\",async()=>{\n    const h=docxSetup();await h.search.start(\"needle\",h.candidates,h.current);h.services.check.mockResolvedValue({kind:\"verified\",file:{...h.file,version:\"new\"}});expect(await h.search.verifyHit(h.search.snapshot().hits[0],h.current)).toBe(false);expect(h.search.snapshot()).toMatchObject({phase:\"stale\",hits:[],error:\"changed\"});\n  });\n});\nEOF\ncorepack pnpm exec vitest run src/runtime/attachment_search.docx.test.ts src/runtime/docx_search_text.test.ts > output/2026-10-14-docx-search-frontend/targeted-04.txt 2>&1"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"","exit_code":1,"duration":{"secs":0,"nanos":439568375}},"started_at_ms":1791910713502,"completed_at_ms":1791910713942}}
