{"timestamp":"2026-10-13T17:10:20.620Z","ordinal":4996,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13410-a021-7660-b316-4a5e2c3de35f","turn_id":"01a1363c-a0d0-71e3-8434-c83c5dcd7e8a","item":{"type":"CommandExecution","id":"exec-dd41c16d-7b26-4109-ae7e-b0696754f460","process_id":"81992","command":["/bin/zsh","-lc","cat > src/components/SelectedAttachmentSearch.test.tsx <<'EOF'\nimport { renderToStaticMarkup } from \"react-dom/server\";\nimport { describe, expect, it, vi } from \"vitest\";\nimport { AttachmentSearch } from \"../runtime/attachment_search\";\nimport { setup } from \"../runtime/attachment_search.test-support\";\nimport { attachmentSearchCandidates, attachmentSearchSourceCurrent } from \"../runtime/attachment_search_source\";\nimport { ATTACHMENT_SEARCH_STRINGS as S } from \"../runtime/attachment_search_strings\";\nimport type { DocxCapture } from \"../runtime/docx_types\";\nvi.mock(\"../runtime/sessions\", () => ({\n  threads: { getSnapshot: () => ({index: [], threads: new Map()}) },\n  useThreadsSnapshot: () => ({index: [], threads: new Map()}),\n}));\nimport { SelectedAttachmentSearch } from \"./SelectedAttachmentSearch\";\n\nasync function searched(partial: boolean) {\n  const h = setup([\"needle\"]), item = h.s.items[0];\n  if (item.kind !== \"user\") throw Error();\n  item.attachments[0].mimeType = \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\";\n  const file = h.files.values().next().value!;\n  const candidates = attachmentSearchCandidates([h.s.key], h.states).candidates;\n  const current = () => candidates.every(c => attachmentSearchSourceCurrent(c, h.states));\n  const search = new AttachmentSearch({...h.services,\n    readDocx: async () => ({file, parts: [], entries: [], inflatedBytes: 1}),\n    parseDocx: async (_capture: DocxCapture) => ({file, blocks:[], stories:[], images:[], warnings:[], partial}),\n  });\n  await search.start(\"needle\", candidates, current);\n  return {search, services:h.services, current};\n}\nfunction render(controller: AttachmentSearch, active=true) {\n  return renderToStaticMarkup(<SelectedAttachmentSearch active={active} rows={[]} query=\"needle\" scopeKey=\"controlled\" controller={controller} />);\n}\nfunction status(html: string) { return html.match(/<div role=\"status\">([\\s\\S]*?)<\\/div>/)?.[1] ?? \"\"; }\n\ndescribe(\"selected attachment omitted-content notice\", () => {\n  it(\"shows the partial scope beside counts even while per-file details are closed\", async () => {\n    const {search}=await searched(true);const html=render(search);\n    expect(status(html)).toContain(S.docxPartial);\n    expect(html).toMatch(/<details class=\"history-search-coverage\">/);\n    expect(html).not.toMatch(/<details[^>]*\\bopen\\b/);\n    expect(html.slice(html.indexOf(\"<details\"))).toContain(S.docxPartial);\n  });\n  it(\"does not invent omissions when the searched content has none\", async () => {\n    const {search}=await searched(false);expect(render(search)).not.toContain(S.docxPartial);\n  });\n  it(\"does not expose old partial results when the search view is inactive or retired\", async () => {\n    const {search}=await searched(true);expect(render(search,false)).not.toContain(S.docxPartial);\n    search.retire();expect(render(search)).not.toContain(S.docxPartial);\n  });\n  it(\"does not keep a current-scope notice after result ownership becomes stale\", async () => {\n    const h=await searched(true);\n    // A new attempt that loses ownership before inspection completes produces\n    // a stale state without claiming anything about previously extracted text.\n    let current=true;const c=setup([\"needle\"]);c.services.inspect.mockImplementation(async()=>{current=false;return c.files.values().next().value!;});\n    await h.search.start(\"needle\",c.candidates,()=>current);\n    expect(h.search.snapshot().phase).toBe(\"stale\");expect(status(render(h.search))).not.toContain(S.docxPartial);\n  });\n});\nEOF\ncorepack pnpm exec vitest run src/components/SelectedAttachmentSearch.test.tsx > output/2026-10-14-docx-search-frontend/ui-notice-red-v2.txt 2>&1"],"cwd":"file:///Users/tw/Desktop/farfold","parsed_cmd":[{"type":"unknown","cmd":"cat > src/components/SelectedAttachmentSearch.test.tsx <<'EOF'\nimport { renderToStaticMarkup } from \"react-dom/server\";\nimport { describe, expect, it, vi } from \"vitest\";\nimport { AttachmentSearch } from \"../runtime/attachment_search\";\nimport { setup } from \"../runtime/attachment_search.test-support\";\nimport { attachmentSearchCandidates, attachmentSearchSourceCurrent } from \"../runtime/attachment_search_source\";\nimport { ATTACHMENT_SEARCH_STRINGS as S } from \"../runtime/attachment_search_strings\";\nimport type { DocxCapture } from \"../runtime/docx_types\";\nvi.mock(\"../runtime/sessions\", () => ({\n  threads: { getSnapshot: () => ({index: [], threads: new Map()}) },\n  useThreadsSnapshot: () => ({index: [], threads: new Map()}),\n}));\nimport { SelectedAttachmentSearch } from \"./SelectedAttachmentSearch\";\n\nasync function searched(partial: boolean) {\n  const h = setup([\"needle\"]), item = h.s.items[0];\n  if (item.kind !== \"user\") throw Error();\n  item.attachments[0].mimeType = \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\";\n  const file = h.files.values().next().value!;\n  const candidates = attachmentSearchCandidates([h.s.key], h.states).candidates;\n  const current = () => candidates.every(c => attachmentSearchSourceCurrent(c, h.states));\n  const search = new AttachmentSearch({...h.services,\n    readDocx: async () => ({file, parts: [], entries: [], inflatedBytes: 1}),\n    parseDocx: async (_capture: DocxCapture) => ({file, blocks:[], stories:[], images:[], warnings:[], partial}),\n  });\n  await search.start(\"needle\", candidates, current);\n  return {search, services:h.services, current};\n}\nfunction render(controller: AttachmentSearch, active=true) {\n  return renderToStaticMarkup(<SelectedAttachmentSearch active={active} rows={[]} query=\"needle\" scopeKey=\"controlled\" controller={controller} />);\n}\nfunction status(html: string) { return html.match(/<div role=\"status\">([\\s\\S]*?)<\\/div>/)?.[1] ?? \"\"; }\n\ndescribe(\"selected attachment omitted-content notice\", () => {\n  it(\"shows the partial scope beside counts even while per-file details are closed\", async () => {\n    const {search}=await searched(true);const html=render(search);\n    expect(status(html)).toContain(S.docxPartial);\n    expect(html).toMatch(/<details class=\"history-search-coverage\">/);\n    expect(html).not.toMatch(/<details[^>]*\\bopen\\b/);\n    expect(html.slice(html.indexOf(\"<details\"))).toContain(S.docxPartial);\n  });\n  it(\"does not invent omissions when the searched content has none\", async () => {\n    const {search}=await searched(false);expect(render(search)).not.toContain(S.docxPartial);\n  });\n  it(\"does not expose old partial results when the search view is inactive or retired\", async () => {\n    const {search}=await searched(true);expect(render(search,false)).not.toContain(S.docxPartial);\n    search.retire();expect(render(search)).not.toContain(S.docxPartial);\n  });\n  it(\"does not keep a current-scope notice after result ownership becomes stale\", async () => {\n    const h=await searched(true);\n    // A new attempt that loses ownership before inspection completes produces\n    // a stale state without claiming anything about previously extracted text.\n    let current=true;const c=setup([\"needle\"]);c.services.inspect.mockImplementation(async()=>{current=false;return c.files.values().next().value!;});\n    await h.search.start(\"needle\",c.candidates,()=>current);\n    expect(h.search.snapshot().phase).toBe(\"stale\");expect(status(render(h.search))).not.toContain(S.docxPartial);\n  });\n});\nEOF\ncorepack pnpm exec vitest run src/components/SelectedAttachmentSearch.test.tsx > output/2026-10-14-docx-search-frontend/ui-notice-red-v2.txt 2>&1"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"","exit_code":1,"duration":{"secs":0,"nanos":469254042}},"started_at_ms":1791911420151,"completed_at_ms":1791911420620}}
