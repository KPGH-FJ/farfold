+      )
+      .map((node) => node.props);
+  const open = (key: string) =>
+    call("ConversationLibrary", "onOpen", {
+      id: key,
+      agentId: key === "old-A" ? "A" : "B",
+      cwd: `/${key}`,
+      nativeSessionId: key,
+    });
+  open("old-A");
+  const notify = component("ThreadPage").onBrowserOwnersChange as (
+    key: string,
+    owns: boolean,
+  ) => void;
+  notify("old-A", true);
+  open("test-B");
+  notify("test-B", true);
