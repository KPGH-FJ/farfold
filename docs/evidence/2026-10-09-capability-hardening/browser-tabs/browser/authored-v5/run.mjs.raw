  check("Hidden selection hide ACK released",await release("select-hide",ta)===1);
  await waitState((s,id)=>s.selections["tabs-A"].label===id,tb);
  check("Completing selection cannot show inactive task page",!(await state()).pages.find(p=>p.label===tb).visible);
  await task("A");
  await waitShown(tb);
  check("Completed hidden selection leaves controls operable",await tablist().getByRole("tab").nth(0).isEnabled());
  await activate(0,ta);
  await finish();

  await load("failed-hidden-close-keeps-owner-for-retry");
  const ca=await open("A",false), cb=await open("B");
  await configure({fail:"close"});
  await pane().getByRole("button",{name:/^关闭网页：/}).nth(0).click();
  await pane().locator(".browser-tabs-error[role=alert]").waitFor();
  current=await state();
  check("Close failure retains exact hidden owner",live(current).length===2 && !current.pages.find(p=>p.label===ca).closed);
  await configure({fail:""});
  await pane().getByRole("button",{name:/^关闭网页：/}).nth(0).click();
  await waitState((s,id)=>s.pages.find(p=>p.label===id)?.closed,ca);
  current=await state();
  check("Explicit close retry only destroys chosen owner",live(current).length===1 && !current.pages.find(p=>p.label===cb).closed && current.trace.filter(t=>t.stage==="close"&&t.event==="ack").every(t=>t.label===ca));
  await finish();

  await load("task-route-waits-for-selected-close-ACK");
  const xa=await open("A",false), xb=await open("B");
  await configure({hold:"close"});
  await pane().getByRole("button",{name:/^关闭网页：/}).nth(1).click();
  await waitState((s,id)=>s.held.some(h=>h.stage==="close"&&h.label===id),xb);
  await requestTask("B");
  check("Pending selected close keeps old task until ACK",await page.locator(".thread-title h1:visible").innerText()==="P30_TASK_A");
  await configure({hold:""});
  check("Selected owner close ACK released",await release("close",xb)===1);
  await waitState((s,id)=>s.pages.find(p=>p.label===id)?.closed,xb);
  await waitTask("B");
  check("Close successor is not displayed in inactive task",!(await state()).pages.find(p=>p.label===xa).visible);
  await task("A");
  await waitShown(xa);
  check("Returning task has a selected successor panel",await tablist().getByRole("tab",{selected:true}).count()===1 && await panel().count()===1);
  check("Close removed only explicit page B",! (await state()).pages.find(p=>p.label===xa).closed);
  await finish();

  for (const delivery of ["captured-success","validate-current"]) {
    await load("ABA-stale-snapshot-"+delivery);
    const sa=await open("A",false), sb=await open("B");
    await activate(0,sa);
    await page.locator(`iframe[data-controlled-page="${sa}"]`).evaluate(frame=>{const p=frame.contentDocument.createElement("p");p.id="snapshot-marker";p.textContent="P30_OLD_CAPTURED_MARKER";frame.contentDocument.body.prepend(p);});
    const stage=delivery==="captured-success"?"snapshot-delivery":"snapshot";
    await configure({hold:stage,snapshotDelivery:delivery});
    await panel().getByRole("button",{name:"读取文字快照",exact:true}).click();
    await waitState((s,d)=>s.held.some(h=>h.stage===d.stage&&h.label===d.id),{stage,id:sa});
    await activate(1,sb);
    await activate(0,sa);
    await page.locator(`iframe[data-controlled-page="${sa}"]`).evaluate(frame=>{frame.contentDocument.getElementById("snapshot-marker").textContent="P30_NEW_EXPLICIT_MARKER";});
    await configure({hold:"",snapshotDelivery:"validate-current"});
    check("Old snapshot response released for exact page",await release(stage,sa)===1);
    await waitState((s,d)=>s.trace.some(t=>t.stage===d.stage&&t.label===d.id&&t.event==="ack"),{stage,id:sa});
