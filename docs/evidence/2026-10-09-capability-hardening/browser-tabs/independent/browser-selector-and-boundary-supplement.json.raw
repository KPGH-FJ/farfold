  "selectors": [
    {
      "purpose": "Active content pane and current page",
      "recommendation": "Use .artifact-pane:visible, then getByRole('tabpanel') with default visible filtering. BrowserWorkspace maps each tab aria-controls to its exact panel; avoid assuming one global textbox or close button."
    },
    {
      "purpose": "Tab activation / same-URL identities",
      "recommendation": "getByRole('tablist',{name:'网页标签',exact:true}).getByRole('tab'); capture each tab aria-controls at creation, retain identity map, and correlate browser_workspace_select label with controlled page ID. Duplicate URL text is not an identity selector."
    },
    {
      "purpose": "Explicit snapshot and success-late result",
      "recommendation": "Within visible tabpanel, getByRole('button',{name:'读取文字快照',exact:true}). After explicit A-B-A and held success release, assert no unique stale marker in .browser-workspace-snapshot[aria-label='文字快照'] pre of the visible panel. Re-read explicitly and require the new marker. Do not reject at the mock gate in this separate adversarial scenario."
    },
    {
      "purpose": "Collapse without closure",
      "recommendation": "Within current pane use button name '收起对话内容'; reopening in active thread uses '查看对话内容'. Await page-hide ACK and pane state before reopening, then verify exact native-label memory plus no new create/revoke, rather than just presence of tab text."
    },
    {
      "purpose": "Selection failure retry",
      "recommendation": "Use .browser-tabs-error[role='alert'] and its button '重试切换'. Verify failed select's captured expected revision is not automatically replayed; only explicit retry can use latest state."
    },
    {
      "purpose": "Permission UI if actually available in fixture",
      "recommendation": "Within the active pane .browser-share-controls, expand '读取权限' then click exact '允许读取', or '停止共享'. Do not fabricate a real connection or claim real grant. If seeded shared state is needed, label it explicitly as a controlled precondition; assert presentation-only hide preserves that precondition without claiming real authorization."
    }
  ],
  "adversarialCases": [
