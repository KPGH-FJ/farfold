{
  "authoredAtUtc": "2026-10-13T20:41:26.856617+00:00",
  "provenance": "Hand-authored from approved PRODUCT scope and explicit lifecycle requirements before implementing multi-tabs. No current parser/controller/test output defines expected values. These are proposed red cases, not claimed observed failures.",
  "cases": [
    {
      "id": "P30-01",
      "title": "Three real instances, not three labels",
      "given": {
        "task": "T1",
        "pages": [
          "A",
          "B",
          "C"
        ],
        "initial": "No pages"
      },
      "actions": [
        "Create/open A, B, C by explicit actions, select each and set independent fixture counter/scroll",
        "Return A then B"
      ],
      "expected": {
        "nativeLive": 3,
        "distinctNativeIds": 3,
        "maxVisible": 1,
        "pageState": "A/B/C counters and scroll remain their own",
        "grant": "No grant inherited from another tab",
        "forbidden": "Destroy/recreate old pages as the tab switch implementation"
      },
      "evidenceBoundary": "Current open closes active; red must be recorded before implementation, not inferred as executed here."
    },
    {
      "id": "P30-02",
      "title": "Revoke and quiesce before new presentation",
      "given": {
        "selected": "A",
        "target": "B",
        "sharing": "A grant active",
        "read": "A undelivered read pending",
        "barriers": [
          "quiesce",
          "hide"
        ]
      },
      "actions": [
        "Start select B",
        "Resolve revocation, delay quiesce; then resolve quiesce, delay hide; finally resolve hide"
      ],
      "expected": {
        "beforeQuiesce": "No B show and no new A dispatch/delivery after revoke linearizes",
        "beforeHideAck": "B still hidden",
        "after": "B can be shown only after true hide ACK; B unshared",
        "alreadyDelivered": "Existing delivered bytes cannot be recalled"
      },
      "evidenceBoundary": "Controlled transport and real-native presentation require separate proof."
    },
    {
      "id": "P30-03",
      "title": "Withdrawal failure cannot rollback permission",
      "given": {
        "selected": "A",
        "target": "B",
        "revoke": "local gate revoked",
        "quiesce": "fails"
      },
      "actions": [
        "Select B",
        "Return quiesce error",
        "Explicitly retry or close exact A later"
      ],
      "expected": {
        "selected": "A remains selected or clearly blocked; never false B success",
        "Agrant": "Stays revoked; UI stop-failed/unknown retained",
        "B": "No show/new grant",
        "retry": "Uses actual current retiring scope, not old success receipt"
      },
      "evidenceBoundary": "Manual expected state; no product output used."
    },
    {
      "id": "P30-04",
      "title": "Hide/show failure stays globally blocked",
      "given": {
        "selected": "A",
        "target": "B",
        "revoke": "success"
      },
      "actions": [
        "Variant1 hide A ACK fails",
        "Variant2 hide A succeeds but show B ACK fails"
      ],
      "expected": {
        "variant1": "No B show, A permission remains withdrawn, A native visibility unknown",
        "variant2": "B may be selected but presentation unknown; no C or old A auto-show",
        "resolution": "Exact failed-owner close/retry ACK needed; no UI-only success"
      },
      "evidenceBoundary": "Do not turn native timeout into closed/hidden."
    },
    {
      "id": "P30-05",
      "title": "Presentation-only hiding preserves same-page grant",
      "given": {
        "task1": "T1/A selected+shared",
        "task2": "T2/C selected+unshared"
      },
      "actions": [
        "Focus and activate already-selected A without changing page",
        "Collapse and reopen T1/A",
        "Switch task to T2/C and back to T1/A without selecting another T1 tab"
      ],
      "expected": {
        "grantA": "Preserved if no navigation/close/revoke occurred",
        "pendingA": "Same request can complete while hidden; receipts observed",
        "grantC": "Not granted from A",
        "maxVisible": 1,
        "noSelectedChange": "Task navigation is not same-task tab selection",
        "sameTabNoop": "Does not revoke/recreate page or grant"
      },
      "evidenceBoundary": "Counterexample to over-broad revoke-on-any-hide implementation."
    },
    {
      "id": "P30-06",
      "title": "Two owners and reversed late creation",
      "given": {
        "owners": [
          "T1/B",
          "T2/C"
        ],
        "nativeCreate": "Both late; most recent route T2"
      },
      "actions": [
        "Start T1/B hidden create",
        "Navigate to T2 and start C",
        "Deliver C ACK then late B ACK, and repeat reverse order"
      ],
      "expected": {
        "visible": "Only eligible latest route selected page; B cannot steal focus",
        "scope": "Each reply updates exact owner only",
        "retired": "A discarded owner closes its exact late page; merely hidden task retains hidden page",
        "grant": "No restoration by create completion"
      },
      "evidenceBoundary": "Independent cross-owner oracle, not source-derived output."
    },
    {
      "id": "P30-07",
      "title": "Close one tab and failed close capacity",
