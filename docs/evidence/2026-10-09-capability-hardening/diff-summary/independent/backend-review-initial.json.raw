  "designReview": {
    "direction": "Shared bounded comparison, body-only integer-ID LCS and explicit precision are appropriate; no backend or protocol changes required.",
    "oracleV1Correction": "whitespace-is-content input a\\n\\tz contradicts the intended separate tab line; owner preserved v1 and corrected to a\\n\\t\\nz in v2 plus shifted EOL coordinates. This is fixture correction, not production success.",
    "recommendationsAdopted": [
      "physical rows with per-line LF/CRLF/none, no phantom final row",
      "oldLine and newLine for EOL changes",
      "precise string interning to integer IDs inside bounded LCS",
      "all NumberedText/feedback counts/copy path share physical semantics",
      "feedback ID distinguishes missing and empty and includes physical-lines-v1",
      "scope remains fragment; explicit diff.path click uses existing single-file verification"
    ]
  },
  "initialSourceAssessment": [
    "combined characters checked before row allocation, rows capped with +1 sentinel, 1M matrix cells enforced; pure add/remove middles avoid matrix",
    "prefix/suffix and LCS preserve independent old/new row positions, repeated-anchor tie-break deterministic",
    "unknown original produces neutral rows and null stats; empty known original produces counted additions",
    "weak cache verifies both original strings on reused owners; no global string-keyed payload cache",
    "precision replacement/unavailable keeps stats null; aggregate exact total only when all individual stats are known",
    "original raw copy remains exact; human-readable diff copy adds precision and EOL information without claiming applyable patch"
  ],
  "findings": [
    {
      "priority": "P2",
      "status": "reported_to_frontend",
      "path": "src/components/thread-items.tsx",
      "location": "DiffView status conditional",
      "counterexample": "status=future-status (session_projection.ts keeps arbitrary String status): message selects filePending while FileArtifactView selects fileUnknown.",
      "recommendation": "Only pending/in_progress map to pending; any other noncompleted/nonfailed value maps to unknown, matching the file view."
    },
    {
      "priority": "test-strength",
      "status": "recommended_to_frontend",
      "path": "src/runtime/artifact_view.test.ts",
      "location": "large replacement reconstruction",
      "detail": "New reconstruction reads ending from production textLines; retain independent hand-written LF/CRLF/no-ending and shifted-row assertions in pure-helper tests so a shared parser error cannot validate itself."
    }
  ],
  "failureClassification": {
    "red01": "2 actual failures on prior behavior: inaccurate +2/-2 for one replacement and missing-before called new file. Genuine original behavioral counterexamples.",
