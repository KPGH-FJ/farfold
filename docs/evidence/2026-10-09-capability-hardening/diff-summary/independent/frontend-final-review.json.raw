  "checks": [
    {
      "id": "precision-and-limits",
      "basis": [
        "src/runtime/line_diff.ts:64",
        "src/runtime/line_diff.ts:101",
        "src/runtime/line_diff.ts:155"
      ],
      "conclusion": "Map uses exact string equality and integer IDs inside bounded LCS; no hash-only equality. Combined UTF16/physical-row limits precede matrix allocation; over-budget matrix returns replacement with stats=null. Original source text remains retained."
    },
    {
      "id": "line-endings-coordinates",
      "basis": [
        "src/runtime/line_diff.ts:34",
        "src/runtime/line_diff.ts:118",
        "src/runtime/line_diff_presentation.ts:27"
      ],
      "conclusion": "LF/CRLF separate; lone CR remains body; final LF creates no phantom row. Ending changes retain oldLine and newLine. Shifted EOL coordinates, exact whitespace and Unicode were independently executed."
    },
    {
      "id": "views-copy-and-search",
      "basis": [
        "src/components/thread-items.tsx:159",
        "src/components/FileArtifactView.tsx:141",
        "src/runtime/line_diff_presentation.ts:36"
      ],
      "conclusion": "Both views share comparison and neutral missing/replacement bodies. Unavailable raw sides stay expandable/searchable; generated comparison labels are outside data-find-blocks. Human-readable diff copy explains precision/endings; raw-side copy retains original strings."
    },
    {
      "id": "feedback-identity",
      "basis": [
        "src/components/FileArtifactView.tsx:58",
        "src/components/FileArtifactView.tsx:342",
        "src/runtime/drafts.ts:296"
      ],
      "conclusion": "Physical-lines-v1 and missing/known original separate null/empty and old coordinate identity. Existing feedback map keys preserve historical entries. Display counters and input bounds share physical-row convention; no historical feedback deletion/migration introduced."
    },
    {
      "id": "status-main-row",
      "basis": [
        "src/components/thread-items.tsx:254",
        "src/components/thread-items.tsx:441",
        "src/components/FileArtifactView.tsx:786"
      ],
      "conclusion": "Only completed status with activity other than unknown uses completed-tense main summary. Failed/pending/in_progress/arbitrary unknown stay neutral; details and pane distinguish failed/unfinished/unknown. Initial future-status inconsistency is corrected."
    },
    {
      "id": "provenance-and-file-access",
      "basis": [
        "src/runtime/artifacts.ts:95",
        "src/runtime/artifacts.ts:163",
        "src/components/thread-items.tsx:190"
      ],
      "conclusion": "Original fragment/input/report provenance and status retained. diff.path uses existing explicit file-open callback. Pure rendering introduces no disk access and no location offset promoted to full-file or actual-write proof."
    },
    {
      "id": "cache-and-resources",
      "basis": [
        "src/runtime/line_diff.ts:187",
        "src/components/FileArtifactView.tsx:98"
      ],
      "conclusion": "WeakMap validates both strings on owner reuse, does not persist comparisons. Raw numbered display is paged. No claim that arbitrary large source rendering has a new complete performance guarantee."
    },
    {
      "id": "old-failure-expectations",
      "basis": [
        "src/runtime/artifact_view.test.ts:182",
        "src/components/thread-items.search-expansion.test.tsx:17",
        "src/components/FileArtifactView.feedback.test.tsx:121"
      ],
      "conclusion": "Reviewed test changes against physical-row/null-neutral/explanatory-copy contract. Hidden-tail search still exercises hidden real source under unified32 preview. Independent literal row/ending test supplements production-parser reconstruction."
    }
  ],
