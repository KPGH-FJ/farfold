  "confirmedStaticFindings": [
    "Message counts every nonblank old/new row and marks unchanged rows as edits; simple a/b -> a/c is presently +2/-2 by source deduction.",
    "Content pane already aligns lines and retains fragment/source/status, but large middle fallback exposes only rows and no precision flag.",
    "Message oldText=null currently says 新文件; content pane says 未提供修改前的文本。 Local v1 schema uses None for new files, but tolerant decoding/frontend normalization also yield null. At most a reported intent, never proof of creation.",
    "Content-pane lineDiff splits trailing LF into an extra empty row. Proposed physical-row/EOL distinction prevents terminal-newline-only edits being counted as body changes; update related coordinate/copy tests if adopted."
  ],
  "sharedInterfaceProposal": {
    "module": "src/runtime/line_diff.ts (pure, no I/O, no Agent branch)",
    "result": "{precision: aligned | replacement | missing-before | unavailable, rows, stats: {adds,removes}|null, endingChanges, reason?}; preserve both exact original strings outside result",
    "aligned": "Two known sides, bounded exact body-line LCS; stats count actual add/remove rows including whitespace. Body equality with EOL changes is not no-change. Coordinates are relative to supplied text only.",
    "replacement": "Existing bounded matrix overflow keeps exact prefix/suffix + replace rows for viewing; stats=null, visible concise 未完整比较 label with reason in detail. Never present replacement count as minimal changes.",
    "missing-before": "After content remains visible and copyable; no deletion side/old coordinates or exact +/-; use existing missingOriginal wording, not 新文件.",
    "unavailable": "If explicit input character/line comparison budget is exceeded, skip comparison without splitting unbounded arrays; retain raw before/after view and honest reason. No silent truncation or fabricated zero changes.",
    "budgets": "Retain 1,000,000 LCS cells; proposed separate comparison-only guard is 2 Mi UTF-16 code units combined and 20,000 physical rows combined. These are implementation proposals, not existing product limits; validate boundary cost before freezing. Do not cap stored reported payload or silently narrow text search.",
    "aggregate": "Tool summary exact +/- only when all counted diff reports are aligned; otherwise precision-aware summary. Do not treat multiple reports for one path as net disk changes. Cache/reuse comparison per immutable content to avoid repeated LCS on unrelated renders.",
    "lineSemantics": "See manual oracle. Keep body bytes/code units, Unicode and each terminator; do not trim/normalize. Endings change separately; raw copy reconstructs exact source. No imaginary file offsets."
  },
  "minimumUI": [
    "Replace message two-side coloring/stats with shared rows; unchanged rows neutral, changed rows colored, preserve keyboard fold/search behavior.",
    "Use one compact precision/scope conclusion and existing expandable details, not repeated defensive prose. Preserve failed/unfinished/unknown labels beside available output.",
    "Wire DiffView.path through existing MessageFileLink + supplied onOpenFile; no automatic reads and no parsing raw code/input into links.",
    "Content pane uses same precision result for combined/split display and diff-copy; raw before/after copy remains exact. Keep fragment-relative feedback and source/status footer."
