import datetime
import hashlib
import json
import pathlib
import subprocess
import sys

ROOT = pathlib.Path('/Users/tw/Desktop/farfold')
OUT = pathlib.Path(__file__).resolve().parent
COMMANDS = {
    'red': ['cargo', 'test', '--manifest-path', 'src-tauri/Cargo.toml', '--locked', 'text_inspection', '--', '--nocapture'],
    'green': ['cargo', 'test', '--manifest-path', 'src-tauri/Cargo.toml', '--locked', 'text_inspection', '--', '--nocapture'],
    'regression': ['cargo', 'test', '--manifest-path', 'src-tauri/Cargo.toml', '--locked', 'file_delivery', '--', '--nocapture'],
    'readpool': ['cargo', 'test', '--manifest-path', 'src-tauri/Cargo.toml', '--locked', 'file_read_check', '--', '--nocapture'],
    'format': ['cargo', 'fmt', '--check', '--manifest-path', 'src-tauri/Cargo.toml'],
}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def stamp():
    return {p: sha(ROOT / p) for p in json.loads((OUT / 'owned-sources.json').read_text())}


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def main():
    phase = sys.argv[1]
    argv = COMMANDS[phase]
    folder = OUT / phase
    folder.mkdir()
    before = stamp()
    expected = json.loads((OUT / ('red-sources.json' if phase == 'red' else 'fixed-sources.json')).read_text())
    if before != expected:
        raise RuntimeError('Owned source differs from recorded stage')
    record = {'schema': 1, 'phase': phase, 'argv': argv, 'cwd': str(ROOT), 'startedAtUtc': now(), 'sourcesBefore': before, 'runnerSha256': sha(pathlib.Path(__file__))}
    (folder / 'started.json').write_text(json.dumps(record, indent=2) + '\n')
    print(json.dumps({'started': phase, 'argv': argv}), flush=True)
    with (folder / 'stdout.log').open('xb') as stdout, (folder / 'stderr.log').open('xb') as stderr:
        done = subprocess.run(argv, cwd=ROOT, stdout=stdout, stderr=stderr)
    record.update({'completedAtUtc': now(), 'actualExitCode': done.returncode, 'sourcesAfter': stamp(), 'outputs': [{'path': str(p.relative_to(ROOT)), 'bytes': p.stat().st_size, 'sha256': sha(p)} for p in [folder / 'stdout.log', folder / 'stderr.log']]})
    record['sourceStable'] = record['sourcesBefore'] == record['sourcesAfter']
    (folder / 'completed.json').write_text(json.dumps(record, indent=2) + '\n')
    print(json.dumps({'completed': phase, 'actualExitCode': done.returncode, 'sourceStable': record['sourceStable']}), flush=True)
    return done.returncode


if __name__ == '__main__':
    sys.exit(main())
