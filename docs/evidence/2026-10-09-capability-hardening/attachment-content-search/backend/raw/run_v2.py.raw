"""Reuse the frozen scoped runner, retaining original v1 receipts unchanged."""
import importlib.util
import pathlib
import sys

here = pathlib.Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location("scoped", here / "run_scoped.py")
runner = importlib.util.module_from_spec(spec)
spec.loader.exec_module(runner)
runner.OUT = here / "v2"
sys.exit(runner.main())
