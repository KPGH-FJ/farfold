  "implementation": {
    "ipc": [
      "file_delivery_inspect_text({path}) -> VerifiedFile",
      "file_delivery_check_text_revision({file}) -> {kind:verified,file:VerifiedFile}"
    ],
    "errors": "Existing typed RevisionFailure {code}; shared read-pool busy/pending/unavailable remain accurate",
    "limitBytes": 1048576,
    "limits": "Both operations reject oversized metadata before content capture; growth is bounded by existing take(limit + 1) overflow sentinel and rejected before hashing. This is not a zero-OS-I/O claim or an OS cancellation API.",
    "reuse": "Existing descriptor-based safe open, canonical containment, expected location, final identity/path/size recheck, exact complete-byte SHA and version; main webview guard and shared read pool",
    "compatibility": "Existing ordinary inspection, revision and readText unchanged; strict UTF-8 remains readText responsibility; BOM/CRLF retained, valid NUL retained by old readText and excluded by P32 frontend."
  },
  "redMeaning": {
