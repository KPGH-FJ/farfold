  "findings": [
    {
      "id": "P32-review-pending-latch",
      "priority": "P2",
      "state": "OPEN-owner-notified",
      "origin": "Root identified; independent source confirmed",
      "refs": [
        "src/runtime/attachment_search.ts:194",
        "src/runtime/attachment_search.ts:212",
        "src/runtime/attachment_search.ts:263",
        "src/runtime/attachment_search.ts:397",
        "src/runtime/attachment_search_strings.ts:28"
      ],
      "finding": "A native timeout sets the singleton pending latch permanently. Reentering the view cannot enable Start despite the user guidance. Actual OS read may already have returned.",
      "minimumFix": "Explicit new Start may reset only the per-search pending flag; no automatic retry. Let the actual shared Rust semaphore decide busy/admission, while describing old read completion as unknown."
    },
    {
      "id": "P32-review-index-binding",
      "priority": "P2",
      "state": "OPEN-owner-notified",
      "origin": "Root identified; independent source confirmed",
      "refs": [
        "src/components/SelectedAttachmentSearch.tsx:80",
        "src/runtime/attachment_search_source.ts:76",
        "src/App.tsx:578"
      ],
      "finding": "Source-current checks include only visible row keys plus loaded-thread identity/fields. A same-key index agent/cwd/nativeSessionId change with the old thread still loaded does not retire active reads or hits. App navigation checks it later.",
      "minimumFix": "Use a shared value-based current index row and loaded owner binding at selection/start/continuation/publication/navigation. Accept equal refresh values, reject missing/duplicate/mismatched identities."
    },
    {
      "id": "P32-review-stale-hit",
      "priority": "P2",
      "state": "OPEN-owner-notified",
      "origin": "Independent static finding",
      "refs": [
        "src/runtime/attachment_search.ts:383",
        "src/components/SelectedAttachmentSearch.tsx:243"
      ],
      "finding": "verifyHit detects a changed full revision but returns false while retaining the known-stale hits. Only pending currently clears hits. UI shows a changed error and old current-file excerpts concurrently.",
      "minimumFix": "Invalidate known-stale results after a detected change; keep pending/busy/unreadable classifications distinct instead of labeling all failed navigation as a content change."
    },
    {
      "id": "P32-review-format-boundary",
      "priority": "P2",
      "state": "QUESTION-owner-notified",
      "origin": "Independent static boundary counterexample, not executed",
      "refs": [
        "src/runtime/attachment_search.ts:155",
        "src/runtime/attachment_search_strings.ts:8",
        "src/runtime/attachment_search_source.ts:51"
      ],
      "finding": "UTF-8 and NUL validation alone admits a genuine all-ASCII PDF or SVG source. No MIME, suffix or known-format check exists, despite a string excluding images/audio/document formats.",
      "minimumFix": "Align supported plain-text semantics and copy; do not silently represent PDF object syntax or SVG source as extracted document/image content. Extension alone cannot establish text validity."
    }
  ],
  "positiveStaticChecks": [
    "Enumeration reads only explicitly declared attachments of loaded user/reply items. It neither scrapes body paths nor performs IO/Agent operations. Candidates are immutable, registered in a WeakMap; fabricated candidate copies are refused.",
    "Local paths require local file URI without credentials/query/fragment; initial actual read is behind explicit Start and current-owner predicate.",
    "VerifiedFile validator requires exactly all seven fields; read payload checks full seven-field equality, exact UTF-8 byte length, SHA-256 of returned bytes, NUL/unpaired surrogate rejection. Final and navigation content checks compare all seven fields.",
    "New Rust inspect/check limit metadata to 1MiB before capture and reads at most 1MiB+1 before rejecting growth; reuse complete hash and handle/root/path rechecks. check returns fresh receipt, and frontend rejects any difference from selected revision.",
    "All three native IPCs check main origin and use the same static two-slot file_read_check. Actual blocking closures own permits until completion, including IPC timeout/drop. No cancellation API claims OS interruption.",
    "Controller has at most two simultaneous awaits; explicit cancel/retire suppresses late publication and stops further admission. Search is literal Unicode case-insensitive matching, not caller regex execution.",
    "Transient state contains only bounded snippets/results, no settings/meta_store/draft writes or body logging in reviewed code. close/retire drops displayed result state."
  ],
  "scopeNotes": [
    "16MiB is the total accepted searchable UTF-8 file bytes, not total disk IO. Up to20 selected files are fully inspected/hashed first, followed by at most16MiB body reads and up to16MiB final content checks.",
    "Runtime/controller tests and real native shared-pool tests were read, not run. Their existence is not a new passing test result.",
    "P32 whole capability, actual installed product behavior, real Agent interfaces and Windows remain outside this provisional static review."
  ],
  "next": "Wait for owners final source freeze and original targeted/browser evidence; recheck changed relevant code and final hashes, without duplicating owner tests."
