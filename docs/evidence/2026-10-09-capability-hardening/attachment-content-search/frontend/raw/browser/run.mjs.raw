import fs from 'node:fs';import path from 'node:path';import{createHash}from'node:crypto';
const{webkit,chromium}=await import('/Users/tw/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright/index.mjs');
const base='output/2026-10-13-attachment-search-frontend/browser',engine=process.argv[2],label=process.argv[3];if(!['chromium','webkit'].includes(engine)||!/^run\d+$/.test(label))throw Error('identity required');
const scan=p=>fs.readdirSync(p,{withFileTypes:true}).flatMap(e=>e.isDirectory()?scan(p+'/'+e.name):[p+'/'+e.name]);const hash=p=>createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const refs=()=>Object.fromEntries([...scan('src'),...['fixture.tsx','index.html','serve.mjs','run.mjs'].map(n=>base+'/'+n),'package.json','pnpm-lock.yaml','vite.config.ts'].sort().map(p=>[p,hash(p)]));
const result={schema:1,engine,label,scope:'Complete production App, shared Library attachment search and source navigation, controlled Tauri returns only. No native Rust IO, installed App, real Agent, user files or network.',before:refs(),checks:[],errors:[],externalRequests:[],screenshots:[],scenarios:[]};
const browser=await(engine==='webkit'?webkit:chromium).launch({headless:true,executablePath:engine==='webkit'?path.resolve('output/2026-10-10-text-feedback-webkit/browsers/webkit-2336/pw_run.sh'):'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});let page,scenario='start',baseline;
const check=(name,pass,detail)=>{result.checks.push({scenario,name,pass:!!pass,...detail===undefined?{}:{detail}});if(!pass)throw Error(name);};const count=(s,cmd)=>s.calls.filter(x=>x.cmd===cmd).length;const state=()=>page.evaluate(()=>window.fixture.current());
const panel=()=>page.getByRole('region',{name:'查找当前附件文件',exact:true});const button=n=>panel().getByRole('button',{name:n,exact:true});const query=()=>page.getByRole('textbox',{name:'搜索所选附件内容…',exact:true});const scope=()=>page.getByRole('combobox',{name:'搜索范围',exact:true});const box=n=>panel().getByRole('checkbox',{name:new RegExp('^'+n.replaceAll('.','\\.')+'\\s')});const mode=m=>page.evaluate(m=>window.fixture.mode(m),m);
async function load(name,seed={}){scenario=name;if(page)await page.close();page=await browser.newPage({viewport:{width:1100,height:820}});page.setDefaultTimeout(10000);page.on('pageerror',e=>result.errors.push({scenario,error:String(e)}));await page.route('**/*',r=>r.request().url().startsWith('http://127.0.0.1:1537/')?r.continue():(result.externalRequests.push(r.request().url()),r.abort()));await page.addInitScript(seed=>window.fixtureSeed=seed,seed);await page.goto('http://127.0.0.1:1537/'+base+'/index.html');await page.locator('.product-navigation').getByRole('button',{name:/所有对话/}).click();await scope().selectOption('attachments');await panel().waitFor();baseline=await state();}
async function choose(names,q='needle'){for(const n of names)await box(n).check();await query().fill(q);}
async function start(){await button('开始查找附件').click();await page.waitForFunction(()=>window.fixture.current().search.phase==='complete'&&!window.fixture.current().busy);}
async function shot(name){const file=base+'/'+engine+'-'+label+'-'+name+'.png';await page.screenshot({path:file});result.screenshots.push({file,sha256:hash(file)});}
async function post(){const s=await state();check('No Agent/network/persistent search body side effects',!s.calls.some(c=>/^(session_prompt|session_open|session_load|session_set_config|history_search_)/.test(c.cmd))&&s.unexpected.length===0&&count(s,'settings_set')===count(baseline,'settings_set'),{unexpected:s.unexpected,settingsBefore:count(baseline,'settings_set'),settingsAfter:count(s,'settings_set')});check('Existing draft and feedback remain exact',s.protectedUnchanged);result.scenarios.push({name:scenario,calls:s.calls.filter(c=>/^file_delivery_/.test(c.cmd)),phase:s.search.phase,matches:s.search.matches,bytes:s.search.bytes,maxActive:s.maxActive});}
try{
 await load('explicit-selection-and-navigation');await choose(['a.txt','folded.txt']);let s=await state();check('Enumeration, query and checkbox selection perform zero reads',count(s,'file_delivery_inspect_text')===0&&count(s,'file_delivery_read_text')===0);check('Remote and received-only attachment text cannot grant local file reads',await box('remote.txt').isDisabled()&&await box('received-only.txt').isDisabled());check('Unloaded conversation coverage remains explicit',(await panel().innerText()).includes('1 个对话尚未加载'));await start();s=await state();check('Only selected current full files searched with exact bytes',s.search.matches===3&&s.search.rows.length===2&&count(s,'file_delivery_read_text')===2&&s.search.bytes===s.search.rows.reduce((n,r)=>n+r.file.size,0));check('Hostile file HTML is inert literal text',await panel().locator('img,script,iframe,a').count()===0&&await page.evaluate(()=>window.BAD===undefined));await page.evaluate(()=>window.fixture.refresh());check('Equivalent index refresh preserves result ownership',(await state()).search.matches===3&&await panel().getByRole('button',{name:'前往来源附件',exact:true}).count()===3);await query().fill('界'.repeat(86));check('Oversized UTF8 query has visible reason and no admission',await button('开始查找附件').isDisabled()&&(await panel().innerText()).includes('关键词最多 256 个 UTF-8 字节'));await query().fill('needle');await start();await page.setViewportSize({width:780,height:760});await button('开始查找附件').focus();check('Keyboard reaches explicit start',await button('开始查找附件').evaluate(e=>document.activeElement===e));check('Narrow search stays within viewport',await panel().evaluate(e=>e.getBoundingClientRect().right<=innerWidth+1&&e.scrollWidth<=e.clientWidth+1));await panel().getByRole('heading',{name:'当前文件的匹配片段',exact:true}).scrollIntoViewIfNeeded();await shot('results-narrow');await panel().locator('.history-search-hit').filter({hasText:'folded.txt'}).getByRole('button',{name:'前往来源附件'}).click();await page.getByText('已定位到来源附件；文件匹配片段仍以本次查找为准。',{exact:true}).waitFor();check('Fifth folded attachment navigates to genuine source, not invented message offset',await page.locator('[data-loaded-message="A-message"].search-match').count()===1&&await page.locator('[data-loaded-message="A-message"] [data-loaded-attachment="4"]').isVisible());await shot('source-location');await page.locator('.product-navigation').getByRole('button',{name:/所有对话/}).click();check('Leaving source clears prior attachment locator',await page.getByRole('button',{name:'关闭附件定位',exact:true}).count()===0);await post();
 await load('full-no-match-and-errors');await choose(['z.txt','bad.txt','unsupported.bin','huge.txt']);await start();s=await state();check('Empty result distinguishes searched vs unread and unsupported inputs',s.search.rows.find(r=>r.source.name==='z.txt').state==='searched'&&s.search.rows.find(r=>r.source.name==='bad.txt').code==='unsupported'&&s.search.rows.find(r=>r.source.name==='unsupported.bin').code==='unsupported'&&s.search.rows.find(r=>r.source.name==='huge.txt').code==='tooLarge'&&s.search.hits.length===0);check('Oversize file never enters body read',!s.calls.some(c=>c.cmd==='file_delivery_read_text'&&c.args.file.name==='huge.txt'));await post();
 await load('exact-one-mib');await choose(['one.txt']);await start();s=await state();check('Exact one MiB complete UTF8 file is searched',s.search.bytes===1048576&&s.search.matches===1);await post();
 await load('omitted-hits',{flood:true});await choose(['a.txt']);await start();s=await state();check('200 display limit reports all omitted matches',s.search.hits.length===200&&s.search.matches===250&&(await panel().innerText()).includes('50 处匹配未展示'));await post();
 await load('pending-explicit-retry');await choose(['a.txt']);await mode({pending:true});await button('开始查找附件').click();await button('重新检查所选附件').waitFor();s=await state();check('Pending does not auto-read or auto-retry',count(s,'file_delivery_inspect_text')===1&&count(s,'file_delivery_read_text')===0);await mode({pending:false});await button('重新检查所选附件').click();await page.waitForFunction(()=>window.fixture.current().search.phase==='complete'&&!window.fixture.current().busy);check('User explicitly retries without claiming prior OS work stopped',(await state()).search.matches===2&&(await panel().innerText()).includes('此前的后台读取是否结束仍未确认'));await post();
 await load('cancel-two-held-checks');await choose(['a.txt','z.txt','folded.txt']);await mode({hold:true,stage:'inspect'});await button('开始查找附件').click();await page.waitForFunction(()=>window.fixture.current().held===2);await button('取消本次附件查找').click();check('Cancel waits actual admitted IPCs and cannot start overlap',await button('开始查找附件').isDisabled()&&(await state()).search.phase==='cancelling'&&(await state()).maxActive===2);await page.evaluate(()=>window.fixture.release());await page.waitForFunction(()=>window.fixture.current().search.phase==='cancelled'&&!window.fixture.current().busy);check('Late canceled inspection never reads text or shows matches',count(await state(),'file_delivery_read_text')===0&&(await state()).search.hits.length===0);await post();
 await load('scope-switch-keeps-real-flight');await choose(['a.txt','z.txt','folded.txt']);await mode({hold:true,stage:'inspect'});await button('开始查找附件').click();await page.waitForFunction(()=>window.fixture.current().held===2);await scope().selectOption('metadata');await scope().selectOption('attachments');check('Unmount/reopen cannot create another overlapping search',await button('开始查找附件').isDisabled()&&(await state()).busy&&count(await state(),'file_delivery_inspect_text')===2);await page.evaluate(()=>window.fixture.release());await page.waitForFunction(()=>!window.fixture.current().busy);check('Retired scope discards late text and releases display memory',(await state()).search.hits.length===0&&(await state()).search.rows.length===0&&count(await state(),'file_delivery_read_text')===0);await post();
 for(const mutation of ['sourceChange','indexChange']){await load('late-'+mutation);await choose(['a.txt']);await mode({hold:true,stage:'read'});await button('开始查找附件').click();await page.waitForFunction(()=>window.fixture.current().held===1);await page.evaluate(m=>window.fixture[m](),mutation);await page.evaluate(()=>window.fixture.release());await page.waitForFunction(()=>!window.fixture.current().busy);check('Changed source or same-key index rejects late bytes before revision/publication',(await state()).search.hits.length===0&&count(await state(),'file_delivery_check_text_revision')===0&&(await panel().innerText()).includes('附件或搜索范围已变化'));await post();}
 await load('navigation-file-change');await choose(['a.txt']);await start();await mode({changed:true});await panel().getByRole('button',{name:'前往来源附件',exact:true}).first().click();await panel().getByRole('alert').waitFor();check('A changed file retires stale snippets and restores usable start',(await state()).search.hits.length===0&&await button('开始查找附件').isEnabled()&&(await panel().innerText()).includes('内容、位置或来源已变化'));await post();
 await load('query-late-and-error-owner');await choose(['a.txt']);await mode({hold:true,stage:'read'});await button('开始查找附件').click();await page.waitForFunction(()=>window.fixture.current().held===1);await query().fill('changed');await page.evaluate(()=>window.fixture.release());await page.waitForFunction(()=>!window.fixture.current().busy);check('Query change revokes a pending body before publication',(await state()).search.hits.length===0&&count(await state(),'file_delivery_check_text_revision')===0);await query().fill('needle');await start();await mode({checkError:'unreadable'});await panel().getByRole('button',{name:'前往来源附件',exact:true}).first().click();await panel().getByRole('alert').waitFor();check('Navigation unreadable is distinct from a known changed file',(await panel().getByRole('alert').innerText()).includes('无法读取此文件')&&(await state()).search.hits.length===0&&await button('开始查找附件').isEnabled());await query().fill('new query');check('Old source error is removed when a new query owns the view',await panel().getByRole('alert').count()===0);await post();
 await load('twenty-explicit-files',{aggregate:true,aggregateCount:21});await choose(Array.from({length:20},(_,i)=>'large'+i+'.txt'));check('UI limits exact explicit selection to20 without any automatic read',await box('large20.txt').isDisabled()&&await panel().getByRole('checkbox',{checked:true}).count()===20&&count(await state(),'file_delivery_inspect_text')===0);await post();
 await load('aggregate-sixteen-mib',{aggregate:true});await choose(Array.from({length:17},(_,i)=>'large'+i+'.txt'));await start();s=await state();check('Actual complete App caps body total at16MiB in selected order',s.search.bytes===16777216&&count(s,'file_delivery_read_text')===16&&s.search.rows[16].code==='budget'&&s.maxActive<=2);await post();
}catch(e){result.failure=String(e);if(page){result.diagnostic={scenario,body:await page.locator('body').innerText().catch(()=>''),aria:await page.locator('body').ariaSnapshot().catch(()=>''),state:await state().catch(()=>null)};await shot('failure').catch(()=>{});}}
finally{await browser.close();result.after=refs();result.stable=JSON.stringify(result.before)===JSON.stringify(result.after);result.passed=!result.failure&&result.stable&&!result.errors.length&&!result.externalRequests.length;fs.writeFileSync(base+'/'+engine+'-'+label+'.json',JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({engine,label,passed:result.passed,checks:result.checks.length,failure:result.failure,errors:result.errors,externalRequests:result.externalRequests,stable:result.stable}));process.exitCode=result.passed?0:1;}
