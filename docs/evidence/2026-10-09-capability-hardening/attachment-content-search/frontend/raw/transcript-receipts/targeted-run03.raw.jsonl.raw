resetHarness);afterEach(cleanupHarness);\nfunction fixture(){\n const state=freshThreadState(\"loaded\",\"A\",\"/controlled\",\"native\");state.connectionLost=true;\n state.items=[{kind:\"user\",id:\"message\",text:\"ordinary\",attachments:[{name:\"current.txt\",uri:\"file:///controlled/current.txt\"}],streaming:false,time:0}];\n h.threads.set(state.key,state);h.index=[{id:state.key,agentId:state.agentId,cwd:state.cwd,nativeSessionId:state.nativeSessionId}];\n return {state,source:attachmentSearchCandidates([state.key],h.threads).candidates[0]};\n}\nit(\"opens only the already loaded source attachment without Agent recovery\",()=>{\n const {source}=fixture();call(\"ConversationLibrary\",\"onSelectAttachment\",source,()=>true);\n expect(component(\"ThreadPage\")).toMatchObject({viewKey:\"loaded\",attachmentSearchRequest:{source}});\n expect(h.open).not.toHaveBeenCalled();expect(h.reconnect).not.toHaveBeenCalled();expect(h.draft.text).toBe(\"OWN-ORIGINAL-DRAFT\");\n});\nit.each([\"owner\",\"message\",\"index\",\"thread\"])(\"rejects stale %s after browser hide before attachment navigation\",async change=>{\n const {state,source}=fixture();let current=true,finish!:()=>void;const close=new Promise<void>(r=>{finish=r;});const owned=browserSurfaceGuard.register(()=>close);\n try {call(\"ConversationLibrary\",\"onSelectAttachment\",source,()=>current);if(change===\"owner\")current=false;if(change===\"message\")state.items=[];if(change===\"index\")h.index=[];if(change===\"thread\")h.threads.delete(state.key);finish();await vi.waitFor(()=>expect(browserSurfaceGuard.getSnapshot().busy).toBe(false));expect(render().some(n=>n.props.viewKey===\"loaded\")).toBe(false);expect(h.open).not.toHaveBeenCalled();expect(h.reconnect).not.toHaveBeenCalled();}finally{owned.release();}\n});\nit(\"does not accept an invented message offset or fabricated source\",()=>{\n const {source}=fixture();call(\"ConversationLibrary\",\"onSelectAttachment\",{...source},()=>true);expect(render().some(n=>n.props.viewKey===\"loaded\")).toBe(false);expect(h.open).not.toHaveBeenCalled();\n});\nEOF\npython3 - <<'PY'\np='src/runtime/attachment_search.test.ts';s=open(p).read();i=s.rfind('\\n});');s=s[:i]+'''\n it(\"serializes navigation verification with subsequent reads\",async()=>{\n  const h=setup([\"needle\"]);await h.search.start(\"needle\",h.candidates,h.current);const pending=deferred<{kind:string;file:VerifiedFile}>();h.services.check.mockImplementation(()=>pending.promise);\n  const hit=h.search.snapshot().hits[0], nav=h.search.verifyHit(hit,h.current);expect(await h.search.verifyHit(hit,h.current)).toBe(false);expect(await h.search.start(\"needle\",h.candidates,h.current)).toBe(false);pending.resolve({kind:\"verified\",file:hit.file});expect(await nav).toBe(true);\n });\n it(\"pending navigation preserves uncertainty and forbids next read\",async()=>{\n  const h=setup([\"needle\"]);await h.search.start(\"needle\",h.candidates,h.current);h.services.check.mockRejectedValue({code:\"pending\"});expect(await h.search.verifyHit(h.search.snapshot().hits[0],h.current)).toBe(false);expect(h.search.snapshot().phase).toBe(\"pending\");expect(await h.search.start(\"needle\",h.candidates,h.current)).toBe(false);\n });\n it(\"abort during match enumeration yields and suppresses the partial result\",async()=>{\n  const h=setup([\"n\".repeat(20000)]);let current=true;const run=h.search.start(\"n\",h.candidates,()=>current);setTimeout(()=>{current=false;},0);await run;expect(h.search.snapshot().hits).toEqual([]);expect(h.search.snapshot().phase).toBe(\"stale\");\n });\n''' + s[i:];open(p,'w').write(s)\nPY\ncorepack pnpm exec prettier --write src/runtime/attachment_search*.ts src/components/SelectedAttachmentSearch.tsx src/components/AttachmentSearchJump.tsx src/App{,.attachment-search.test}.tsx > output/2026-10-13-attachment-search-frontend/format-current.txt\ncorepack pnpm exec vitest run src/runtime/attachment_search.test.ts src/App.attachment-search.test.tsx src/App.loaded-sea