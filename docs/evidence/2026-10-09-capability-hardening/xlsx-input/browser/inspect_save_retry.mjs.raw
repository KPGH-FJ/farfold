import fs from 'node:fs';
import {createHash} from 'node:crypto';
const {chromium}=await import('/Users/tw/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright/index.mjs');
const base='output/2026-10-13-xlsx-input-browser',label=process.argv[2];
if(!/^run\d+$/.test(label))throw Error('fresh identity required');
const out=`${base}/save-retry-inspection-${label}.json`;
if(fs.existsSync(out))throw Error('refuse overwrite');
const scan=p=>fs.readdirSync(p,{withFileTypes:true}).flatMap(e=>e.isDirectory()?scan(p+'/'+e.name):[p+'/'+e.name]);
const inputs=()=>Object.fromEntries(scan('src').filter(p=>!/\.test\.[jt]sx?$/.test(p)).sort().map(p=>[p,createHash('sha256').update(fs.readFileSync(p)).digest('hex')]));
const result={scope:'Controlled complete production App/StrictMode/real XLSX Worker; save-failed input followed by actual Retry Save. Native storage/file interfaces controlled; no native App/Agent/user DB.',before:inputs(),errors:[],workers:[],checks:[]};
const browser=await chromium.launch({headless:true,executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});
let page;
try{
 page=await browser.newPage({viewport:{width:1100,height:820}});page.setDefaultTimeout(10000);page.on('pageerror',e=>result.errors.push(String(e)));page.on('worker',w=>result.workers.push(w.url()));await page.route('**/*',r=>r.request().url().startsWith('http://127.0.0.1:1529/')?r.continue():r.abort());await page.goto(`http://127.0.0.1:1529/${base}/index.html`);await page.locator('.product-recent').filter({hasText:'XLSX_CONTROLLED'}).click();const main=page.getByRole('main').filter({has:page.getByRole('heading',{name:'XLSX_CONTROLLED',exact:true})});await main.getByRole('button',{name:'加入文字',exact:true}).click();const dialog=page.getByRole('dialog',{name:'加入文档文字',exact:true});await dialog.getByRole('textbox',{name:'本次拟加入的全部文字',exact:true}).waitFor();await dialog.getByRole('checkbox').check();await page.evaluate(()=>window.fixture.mode({saveFail:true}));await dialog.getByRole('button',{name:'只加入已读取文字',exact:true}).click();await page.waitForFunction(()=>window.fixture.current().status.error!==null);await dialog.waitFor({state:'hidden'});const before=await page.evaluate(()=>window.fixture.current());result.beforeRetry={draft:before.draft,status:before.status,calls:before.calls};await page.evaluate(()=>window.fixture.mode({saveFail:false}));await main.getByRole('button',{name:'重试保存',exact:true}).click();await page.waitForFunction(()=>window.fixture.current().status.error===null&&!window.fixture.current().status.saving);await page.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))));const after=await page.evaluate(()=>window.fixture.current());result.afterRetry={draft:after.draft,status:after.status,saved:after.saved,calls:after.calls};result.body=await page.locator('body').innerText();result.aria=await page.locator('body').ariaSnapshot();result.obsoleteDocumentSaveFailureVisible=result.body.includes('文字已加入，但未发送内容尚未保存。请重试保存后再发送或关闭。');result.checks=[{name:'Actually saved complete approved text/source after prior failed persistence',pass:after.status.error===null&&after.draft.attachments[0].documentText?.text.includes('FAR_CORNER')&&JSON.stringify(after.saved).includes('FAR_CORNER')},{name:'Actual retry preserved exact retained draft and never submitted',pass:JSON.stringify(before.draft)===JSON.stringify(after.draft)&&after.calls.every(c=>c.cmd!=='session_prompt')},{name:'Resolved persistence no longer displays obsolete document-save failure',pass:!result.obsoleteDocumentSaveFailureVisible}];result.screenshot=`${base}/save-retry-inspection-${label}.png`;await page.screenshot({path:result.screenshot});
}catch(error){result.failure=String(error);}
finally{await browser.close();result.after=inputs();result.sourceStable=JSON.stringify(result.before)===JSON.stringify(result.after);result.passed=!result.failure&&result.sourceStable&&result.errors.length===0&&result.checks.every(c=>c.pass);fs.writeFileSync(out,JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({label,passed:result.passed,checks:result.checks,sourceStable:result.sourceStable,obsoleteDocumentSaveFailureVisible:result.obsoleteDocumentSaveFailureVisible,failure:result.failure}));process.exitCode=result.passed?0:1;}
