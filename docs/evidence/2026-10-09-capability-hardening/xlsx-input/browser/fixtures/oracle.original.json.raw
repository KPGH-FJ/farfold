      "unreadContent":[
        {"part":"xl/drawings/drawing1.xml","text":"DRAWING_ONLY_WORDS","meaning":"DrawingML shape text is not worksheet cell text"},
        {"part":"xl/media/fixture.png","meaning":"synthetic one-pixel image; no image semantics or OCR"},
        {"part":"xl/externalLinks/externalLink1.xml","text":"REMOTE_CACHED_ONLY","meaning":"external-link part cache, not a current remote fetch or ordinary worksheet cell"},
        {"part":"xl/externalLinks/_rels/externalLink1.xml.rels","target":"https://example.invalid/farfold-fixture.xlsx","mode":"External","meaning":"must not access target"}
      ],
      "expectedAdmissionWithoutPartialConsent":"REJECT_OR_REVIEW_REQUIRED; never all-content success",
