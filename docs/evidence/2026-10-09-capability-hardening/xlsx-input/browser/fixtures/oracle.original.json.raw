        {"sheet":"Gap","address":"A3","t":"n","vPresent":true,"vText":"99","fPresent":true,"fText":"[1]Remote!A1+1","fAttrs":{},"meaning":"saved external-dependent formula and cache only; remote result not fetched/calculated"},
        {"sheet":"Gap","address":"A6","t":"inlineStr","vPresent":false,"isText":"VISIBLE_MERGE_ANCHOR"},
        {"sheet":"Gap","address":"B6","t":"inlineStr","vPresent":false,"isText":"COVERED_SAVED_VALUE","meaning":"saved non-anchor content covered by merge; do not silently drop it or duplicate anchor"}
