const check=(name,pass,detail)=>{result.checks.push({scenario,name,pass:!!pass,...detail===undefined?{}:{detail}});if(!pass)throw Error(name);};
const parseText=text=>JSON.parse(text.slice(text.lastIndexOf('\n\n')+2));
const cells=body=>body.sheets.flatMap(sh=>sh.cells.map(c=>({...c,sheet:sh.name})));
const cell=(body,sheet,address)=>cells(body).find(c=>c.sheet===sheet&&c.address===address);
const allRadio=()=>dialog().getByRole('radio',{name:'全部工作表中的保存单元格（含隐藏内容）',exact:true});
const visibleRadio=()=>dialog().getByRole('radio',{name:'可见工作表中的保存单元格',exact:true});
async function snap(name){const dest=`${base}/${engine}-${label}-${name}.png`;if(fs.existsSync(dest))throw Error('screenshot overwrite');await page.screenshot({path:dest});result.screenshots.push(dest);}
async function load(name,seed){scenario=name;result.scenarios.push(name);if(page)await page.close();page=await browser.newPage({viewport:{width:1100,height:820}});page.setDefaultTimeout(10000);page.on('pageerror',e=>result.errors.push({scenario:name,error:String(e)}));page.on('worker',worker=>result.workers.push({scenario:name,url:worker.url()}));await page.route('**/*',r=>{if(r.request().url().startsWith('http://127.0.0.1:1529/'))return r.continue();result.blockedRequests.push(r.request().url());return r.abort();});if(seed)await page.addInitScript(seed=>window.fixtureSeed=seed,seed);await page.goto('http://127.0.0.1:1529/'+base+'/index.html');await page.locator('.product-recent').filter({hasText:'XLSX_CONTROLLED'}).click();await owned().getByRole('textbox',{name:'对话内容',exact:true}).waitFor();await page.waitForFunction(()=>window.fixture.current().draft.text==='KEEP_COMPOSER');}
async function read(name='values'){if(name!=='values'){await page.evaluate(name=>window.fixture.choose(name),name);await settle();}await readButton().click();await reviewText().waitFor();return reviewText().inputValue();}
async function consent(){const box=dialog().getByRole('checkbox');if(await box.count())await box.check();}
async function confirmClick(){const partial=dialog().getByRole('button',{name:'只加入已读取文字',exact:true});await (await partial.count()?partial:dialog().getByRole('button',{name:'加入这些文字',exact:true})).click();}
