const base='output/2026-10-13-xlsx-input-browser', engine=process.argv[2], label=process.argv[3];
if(!['webkit','chromium'].includes(engine)||!/^run\d+$/.test(label))throw Error('invalid fresh run identity');
const out=`${base}/${engine}-${label}.json`;
if(fs.existsSync(out))throw Error('refusing to overwrite run');
const scan=p=>fs.readdirSync(p,{withFileTypes:true}).flatMap(e=>e.isDirectory()?scan(p+'/'+e.name):[p+'/'+e.name]);
const digest=p=>createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const hashes=paths=>Object.fromEntries([...new Set(paths)].sort().map(p=>[p,digest(p)]));
const isTest=p=>/\.test\.[cm]?[jt]sx?$/.test(p);
const inventory=()=>hashes([...scan('src').filter(p=>!isTest(p)),...scan('src-tauri/src'),...scan(base+'/fixtures'),...['index.html','fixture.tsx','serve.mjs','run.mjs','make_captures.py'].map(n=>base+'/'+n),...['package.json','pnpm-lock.yaml','vite.config.ts','tsconfig.json','tsconfig.app.json','tsconfig.node.json','src-tauri/Cargo.toml','src-tauri/Cargo.lock','src-tauri/tauri.conf.json'].filter(p=>fs.existsSync(p))]);
const result={engine,label,scope:'Complete production App, StrictMode, production controllers and real XLSX Worker. Synthetic ZIP bytes and independent authored oracle; native file capture, source versions, backend admission and initial data are controlled. No formal App, real Agent/account, user database, native OS file-capture or installed acceptance.',before:inventory(),testsBefore:hashes(scan('src').filter(isTest)),checks:[],scenarios:[],workers:[],screenshots:[],errors:[],blockedRequests:[],limitations:['Controlled native source capture uses actual independently authored ZIP parts and VerifiedFile hashes; no native ZIP/OS boundary claim.','Backend admission outcomes and busy state are controlled; no real Agent or real process deadline claim.','Late native completion cannot by itself prove execution of an already-aborted catch.']};
const browser=await(engine==='webkit'?webkit:chromium).launch({headless:true,executablePath:engine==='webkit'?path.resolve('output/2026-10-10-text-feedback-webkit/browsers/webkit-2336/pw_run.sh'):'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});
let page,scenario,s,allText,approvedAll,savedAll,visibleText;
const timer=setTimeout(()=>void browser.close(),300000);
const state=()=>page.evaluate(()=>window.fixture.current());
const count=(s,name)=>s.calls.filter(c=>c.cmd===name).length;
const dialog=()=>page.getByRole('dialog',{name:'加入文档文字',exact:true});
const readButton=()=>page.getByRole('button',{name:'加入文字',exact:true});
const rereadButton=()=>page.getByRole('button',{name:'重新读取文字',exact:true});
const reviewText=()=>dialog().getByRole('textbox',{name:'本次拟加入的全部文字',exact:true});
