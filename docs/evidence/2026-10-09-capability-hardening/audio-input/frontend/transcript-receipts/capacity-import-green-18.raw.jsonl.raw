).toMatchObject({kind:\"file\",audioClassificationFailed:true,loading:false});expect(report).toHaveBeenCalledWith(S.classificationFailed);\n await expect(prepareDraftAttachments(items,true)).rejects.toThrow(S.classificationFailed);expect(()=>attachmentPromptBlocks(\"\",items,true)).toThrow(S.classificationFailed);expect(h.invoke).toHaveBeenCalledTimes(1);\n});\nit.each([\"remove\",\"clear\",\"replace-path\"])(\"ignores a late candidate after %s\",async change=>{\n let finish!:(value:unknown)=>void;h.invoke.mockImplementation(()=>new Promise(resolve=>{finish=resolve;}));const work=addPickedAttachments(\"new\",[\"/chosen/file.wav\"],true,vi.fn());\n if(change===\"remove\")composerDrafts.update(\"new\",v=>({...v,attachments:[]}));\n if(change===\"clear\")composerDrafts.clear(\"new\");\n if(change===\"replace-path\")composerDrafts.update(\"new\",v=>({...v,attachments:v.attachments.map(a=>({...a,uri:\"file:///chosen/other.wav\"}))}));\n const kept=composerDrafts.read(\"new\");finish({mimeType:\"audio/wav\"});await work;expect(composerDrafts.read(\"new\")).toBe(kept);expect(h.invoke).toHaveBeenCalledTimes(1);\n});\nit(\"project selection also classifies a WAV before any ordinary text read\",async()=>{\n h.invoke.mockResolvedValue({mimeType:\"audio/wav\"});await addPickedAttachments(\"new\",[\"/chosen/file.wav\"],true,vi.fn(),{cwd:\"/chosen\",path:\"file.wav\",embed:true});\n expect(h.invoke.mock.calls.map(([cmd])=>cmd)).toEqual([\"draft_attachment_audio_candidate\"]);expect(composerDrafts.read(\"new\").attachments[0].kind).toBe(\"file\");\n});\nEOF\npython3 - <<'PY'\np='src/runtime/sessions.audio-capacity.test.ts';s=open(p).read().replace('  reads: 0,','  reads: 0,\\n  response: {status:\"accepted\"} as {status:string;reason?:string},\\n  failQueueSave: false,');s=s.replace('  h.reads = 0;','  h.reads = 0;\\n  h.response = {status:\"accepted\"}; h.failQueueSave=false;');s=s.replace('      if (args.key === \"unsentWork.v1\") h.saved = args.value;','''      if (args.key ===