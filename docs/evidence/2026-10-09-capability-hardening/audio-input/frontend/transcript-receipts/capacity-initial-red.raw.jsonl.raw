;\n expect(h.prompts).toHaveLength(1);\n});\nit(\"can save the unchanged queue editor for a 16MiB audio while preserving the original queued bytes\",async()=>{\n const {attachmentPromptBlocks}=await import(\"./draft_attachments\"),{startQueueEditor}=await import(\"./queue_edit\");const blocks=attachmentPromptBlocks(\"keep\",[audio],true);\n d.draftQueues.write(\"audio-capacity\",{blocks:[blocks],uncertainIndex:null});await d.draftPersistence.flush();\n startQueueEditor(\"audio-capacity\",0,blocks);await expect(d.draftPersistence.flush()).resolves.toBeUndefined();\n expect(d.composerDrafts.read(\"queue-edit:audio-capacity\").attachments[0].data).toBe(data);expect(d.draftQueues.read(\"audio-capacity\")?.blocks[0]).toEqual(blocks);\n});\nEOF\ncorepack pnpm test src/runtime/sessions.audio-capacity.test.ts"],"cwd":"file:///Users/tw/Desktop/farfold","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nfrom pathlib import Path\nimport base64\nb=Path('output/2026-10-13-audio-input-independent/fixtures/valid-exact-16mib.wav').read_bytes();pat=b[44:556];assert (pat*((len(b)-44+511)//512))[:len(b)-44]==b[44:]\np=Path('src/runtime/audio_input.test-support.ts');s=p.read_text();s+='''\n// Lossless expansion of the independent exact-16MiB fixture; its frozen 512-byte\n// waveform repeats. This is a byte fixture, not a second RIFF parser.\nexport function largeAudioCapture(): AudioCapture {\n  const bytes=Buffer.alloc(16777216);\n  Buffer.from(\"%s\",\"base64\").copy(bytes);\n  bytes.fill(Buffer.from(\"%s\",\"base64\"),44);\n  return {...audioCapture(),file:{...audioCapture().file,size:16777216,sha256:\"2aa96f22539756ff5af208c5cd9ae1ed2b2307faa03a13f185cf64b234a7bcad\"},data:bytes.toString(\"base64\"),channels:2,sampleRate:96000,bitsPerSample:8,frames:8388586,durationMs:87382};\n}\n'''%(base64.b64encode(b[:44]).decode(),base64.b64encode(pat).decode());p.write_text(s)\nPY\ncat > src/runtime/sessions.audio-capacity.test.ts <<'EOF'\nimport {afterEach,beforeEach,expect,it,vi} from 