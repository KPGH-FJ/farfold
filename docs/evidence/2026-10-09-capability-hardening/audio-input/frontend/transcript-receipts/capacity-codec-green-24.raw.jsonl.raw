SON.stringify(encodeDraftAudio(base())));\nbeforeEach(()=>{h.invoke.mockReset();});\nit(\"deduplicates only complete equal audio strings within one snapshot, keeps all source metadata, and expands isolated objects\",()=>{\n const value=base(),before=structuredClone(value),compressed=encoded();\n expect(compressed.audioEncoding.version).toBe(1);expect(compressed.audioEncoding.values).toEqual([audioAttachment().data]);expect(compressed.composers.new.attachments[0].data).toEqual({audioRef:0});\n const decoded=decodeDraftAudio(compressed) as ReturnType<typeof base>;\n expect(decoded).toEqual(value);expect(value).toEqual(before);\n expect(decoded.composers.new.attachments[0].localAudio).not.toBe(decoded.queues.one.blocks[0][0].localAudio);\n decoded.composers.new.attachments[0].localAudio!.file.name=\"changed\";\n expect(decoded.queues.one.blocks[0][0].localAudio!.file.name).toBe(\"sample.wav\");\n expect(compressed.composers.new.attachments[0].localAudio.file.name).toBe(\"sample.wav\");\n});\nit(\"same source hash never aliases different complete data\",()=>{\n const value=base();value.queues.one.blocks[0][0].data+=\"DIFFERENT\";\n const compressed=encodeDraftAudio(value) as {audioEncoding:{values:string[]}};\n expect(compressed.audioEncoding.values).toHaveLength(2);expect(decodeDraftAudio(compressed)).toEqual(value);\n});\nit(\"leaves old v1 and ordinary non-audio strings untouched\",()=>{\n const old={version:1,composers:{new:{text:\"audioRef:0\",attachments:[audioAttachment(),{id:\"image\",kind:\"image\",data:audioAttachment().data}]}},queues:{}};\n expect(encodeDraftAudio(old)).toBe(old);expect(decodeDraftAudio(old)).toBe(old);\n const value={...base(),feedback:{ordinary:{data:{audioRef:0}}}};\n expect((decodeDraftAudio(encodeDraftAudio(value)) as typeof value).feedback).toEqual(value.feedback);\n});\nit.each([\n (v:ReturnType<typeof encoded>)=>{v.audioEncoding.version=2;},\n (v:ReturnType<typeof encoded>)=>{delete v.audioEncoding.values;},\n (v:ReturnType<typeof encoded>)=>{v.audioEncoding.values=[{audioRef:0}];},\n (v:ReturnType<typeof encoded>)=>{v.audioEncoding.values.push(\"unused\");},\n (v:ReturnType<typeof encoded>)=>{v.audioEncoding.values.push(v.audioEncoding.values[0]);},\n (v:ReturnType<typeof encoded>)=>{v.audioEncoding.path=\"/private/arbitrary\";},\n (v:ReturnType<typeof encoded>)=>{v.composers.new.attachments[0].data={audioRef:-1};},\n (v:ReturnType<typeof encoded>)=>{v.composers.new.attachments[0].data={audioRef:0.1};},\n (v:ReturnType<typeof encoded>)=>{v.composers.new.attachments[0].data={audioRef:1};},\n (v:ReturnType<typeof encoded>)=>{v.composers.new.attachments[0].data={audioRef:\"0\"};},\n (v:ReturnType<typeof encoded>)=>{v.composers.new.attachments[0].data={audioRef:0,path:\"/private/arbitrary\"};},\n (v:ReturnType<typeof encoded>)=>{v.composers.new.attachments[0].data={};},\n (v:ReturnType<typeof encoded>)=>{v.composers.new.attachments[0].data=\"mixed inline\";},\n])( \"rejects malformed, unknown or dangling encoding as a whole without any settings write\",async mutate=>{\n const value=encoded();mutate(value);h.invoke.mockResolvedValue(value);vi.resetModules();const d=await import(\"./drafts\");await expect(d.draftPersistence.load()).rejects.toThrow();\n expect(d.composerDrafts.hasContent(\"new\")).toBe(false);expect(h.invoke.mock.calls.map(([cmd])=>cmd)).toEqual([\"settings_get\"]);\n});\nit(\"rejects cyclic snapshot or cross-snapshot references\",()=>{\n const value=encoded();value.audioEncoding.values[0]=value;\n expect(()=>decodeDraftAudio(value)).toThrow();\n const next=encoded();next.audioEncoding.values=[];expect(()=>decodeDraftAudio(next)).toThrow();\n});\nit(\"limits reference count before expansion\",()=>{\n const value=encoded();value.composers.new.attachments=Array.from({length:MAX_AUDIO_REFERENCES+1},()=>({...value.composers.new.attachments[0]}));\n expect(()=>decodeDraftAudio(value)).toThrow();\n});\nit(\"counts UTF-8 and JSON escaping in the 96MiB expansion boundary\",()=>{\n const valu