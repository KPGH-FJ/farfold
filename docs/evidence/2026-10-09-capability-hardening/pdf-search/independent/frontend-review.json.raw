  "findings": [],
  "reviewedContracts": [
    {
      "area": "Selected local source and declaration routing",
      "evidence": [
        "src/runtime/attachment_search_source.ts:29",
        "src/runtime/attachment_search_source.ts:81",
        "src/runtime/attachment_search_source.ts:138",
        "src/runtime/file_delivery.ts:66"
      ],
      "conclusion": "Candidates come only from loaded user/agent message attachments; owner checks retain exact item/attachment identity, URI, MIME, current index, Agent, cwd and nativeSession. Only local file URI without remote host/query/hash is admitted. MIME/path selects the parser; display name is not authority. Conflicting declarations retain earlier DOCX/XLSX precedence with no raw-text fallback."
    },
    {
      "area": "Bounded whole capture, version and immutable handoff",
      "evidence": [
        "src/runtime/attachment_search.ts:121",
        "src/runtime/attachment_search.ts:468",
        "src/runtime/pdf_input_capture.ts:55",
        "src/runtime/file_revision_monitor.ts:17"
      ],
      "conclusion": "Production port uses file_delivery_read_pdf_search. Selected inspect result is <=1 MiB; PDF capture copies/freezes source/data synchronously before awaiting the digest. Strict base64 round-trip, exact full length, all seven fields and actual whole SHA precede parser dispatch. The source is rechecked after parsing and before any jump."
    },
    {
      "area": "Read concurrency and parser lifetime",
      "evidence": [
        "src/runtime/attachment_search.ts:358",
        "src/runtime/attachment_search.ts:400",
        "src/runtime/attachment_search.ts:482",
        "src/runtime/pdf_input_read.ts:21"
      ],
      "conclusion": "At most two per-batch read tasks; PDF/DOCX/XLSX parser calls share one parseTail. Read cancellation does not claim OS cancellation. Queued parsing checks current owner/cancel/pending before entry; actual PDF worker uses the shared worker admission and release path. Tests of native slot semantics remain separate backend evidence."
    },
    {
      "area": "Search text, scope and exact UTF-8 budgets",
      "evidence": [
        "src/runtime/pdf_search_text.ts:24",
        "src/runtime/pdf_input_validation.ts:148",
        "src/runtime/attachment_search.ts:529",
        "src/runtime/attachment_search.ts:559"
      ],
      "conclusion": "Strict complete-result validation before indexing. Only actual item.text enters segments; each item/page remains separate with original item ordinal/page/rotation. No generated labels/JSON keys/warnings/OCR text is indexed. No Unicode normalization or whitespace synthesis. Real UTF-8 item bytes enter the mixed 16 MiB aggregate budget; source limits20 files/1 MiB and existing PDF whole-result256KiB/1000-page/parser limits remain."
    },
    {
      "area": "Whole-file failure and no-text semantics",
      "evidence": [
        "src/runtime/pdf_search_text.ts:48",
        "src/runtime/attachment_search.ts:209",
        "src/runtime/attachment_search.ts:495",
        "src/runtime/attachment_search_strings.ts:140"
      ],
      "conclusion": "Encrypted/timeout/late-page/limit/invalid results reject that entire file without earlier-page success or raw-text fallback. Whitespace/empty extracted scope reports pdfNoText rather than whole-file absence. PDF scope stays partial and warnings remain visible."
    },
    {
      "area": "Explicit Start, owner invalidation, query and navigation",
      "evidence": [
        "src/components/SelectedAttachmentSearch.tsx:72",
        "src/components/SelectedAttachmentSearch.tsx:88",
        "src/components/SelectedAttachmentSearch.tsx:185",
        "src/runtime/attachment_search.ts:304",
        "src/runtime/attachment_search.ts:661",
        "src/components/AttachmentSearchJump.tsx:45"
      ],
      "conclusion": "Selection itself does not read. Inline candidate scope explains all-page extractable/possibly invisible/partial text; selection+Start is authorization without extra PDF approval checkbox. Query changes retire results while preserving valid selection. Cancel/retire/owner mutation discards late outputs; pending can retry only via explicit new Start. Navigation revalidates source and locates the original attachment, not a fabricated visual PDF page position."
    }
  ],
