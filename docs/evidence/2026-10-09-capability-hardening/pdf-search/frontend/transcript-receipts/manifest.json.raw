    {
      "name": "targeted-03",
      "path": "output/2026-10-14-pdf-search-frontend/transcript-receipts/targeted-03.jsonl.raw",
      "bytes": 12927,
      "sha256": "819a439aa988fdc69a9b732a0ef76bfdb77efd24e88022125bb7b4576d0954cf",
      "sourceByteOffset": 24062840,
      "sourceByteLength": 12927,
      "timestamp": "2026-10-13T19:17:23.669Z",
      "itemId": "exec-e34cbec3-d09f-4a20-bfec-af0dfed40f27",
      "processId": "54404",
      "actualExitCode": 0,
      "command": [
        "/bin/zsh",
        "-lc",
        "mkdir -p src/runtime/fixtures/pdf-search\ncp output/2026-10-14-pdf-search-research/fixtures/hand-authored-textitems.json src/runtime/fixtures/pdf-search/hand-authored-textitems.json\ncat >> src/runtime/pdf_search_text.test.ts <<'EOF'\n\nimport handAuthored from \"./fixtures/pdf-search/hand-authored-textitems.json\";\nimport type { PdfInputResult } from \"./pdf_input_types\";\nit(\"matches the independently reviewed hand-authored TextItem model without deriving expected data from parser output\", () => {\n  const output = pdfSearchText(handAuthored.result as PdfInputResult);\n  expect(output.segments.map(({ text, location }) => ({ text, pageNumber: location.pageNumber, itemIndex: location.itemIndex, decodedRotation: location.decodedRotation }))).toEqual(handAuthored.expectedNonemptySegments);\n  expect(output.bytes).toBe(handAuthored.expectedUtf8Bytes);\n  expect(output.bytes).toBe(63);\n  for (const query of handAuthored.negativeQueries)\n    expect(output.segments.some((s) => s.text.includes(query))).toBe(false);\n});\nEOF\ncat >> src/runtime/attachment_search.pdf.test.ts <<'EOF'\n\nimport { attachmentSearchCandidates, attachmentSearchSourceCurrent } from \"./attachment_search_source\";\nit.each([0, 1])(\"shares the actual 16MiB XLSX/plain/PDF budget (over by %i)\", async (over) => {\n  const p = pdfSetup([\"中🚀 needle\"]), pdfBytes = Buffer.byteLength(\"中🚀 needle\"), plain = \"plain needle\";\n  const h = xlsxSetup([\"a\".repeat(L.totalBytes / 2), \"b\".repeat(L.totalBytes / 2 - pdfBytes - Buffer.byteLength(plain) + over)], [plain]);\n  h.s.items.push({ ...p.s.items[0], id: \"pdf-last\" });\n  h.files.set(p.file.path, p.file);\n  const candidates = attachmentSearchCandidates([h.s.key], h.states).candidates;\n  const current = () => candidates.every((c) => attachmentSearchSourceCurrent(c, h.states));\n  const search = new AttachmentSearch({ ...h.services, readPdf: p.services.readPdf, parsePdf: p.services.parsePdf });\n  await search.start(\"needle\", candidates, current);\n  expect(search.snapshot().rows.at(-1)?.state).toBe(over ? \"skipped\" : \"searched\");\n  expect(search.snapshot().rows.at(-1)?.code).toBe(over ? \"budget\" : undefined);\n  expect(search.snapshot().bytes).toBe(over ? L.totalBytes - pdfBytes + 1 : L.totalBytes);\n});\nit(\"preserves DOCX/XLSX routing precedence for conflicting PDF declarations\", async () => {\n  for (const mimeType of [\"application/vnd.openxmlformats-officedocument.wordprocessingml.document\", \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"]) {\n    const h = pdfSetup(), item = h.s.items[0]; if (item.kind !== \"user\") throw Error();\n    item.attachments[0].mimeType = mimeType;\n    await h.search.start(\"needle\", h.refresh(), h.current);\n    expect(h.services.readPdf).not.toHaveBeenCalled(); expect(h.services.read).not.toHaveBeenCalled();\n    expect(h.search.snapshot().rows[0].code).toBe(\"unsupported\");\n  }\n});\nit(\"retired result ownership cannot publish a late PDF parse\", async () => {\n  const h = pdfSetup(), gate = deferred<PdfInputResult>(); h.services.parsePdf.mockImplementationOnce(() => gate.promise);\n  const run = h.search.start(\"needle\", h.candidates, h.current);\n  await vi.waitFor(() => expect(h.services.parsePdf).toHaveBeenCalledOnce());\n  h.search.retire(); gate.resolve(h.pdf); await run;\n  expect(h.search.snapshot().hits).toEqual([]);\n});\nEOF\ncat >> src/components/SelectedAttachmentSearch.test.tsx <<'EOF'\n\nimport { pdfSetup, searchPdf } from \"../runtime/attachment_search.pdf.test-support\";\ndescribe(\"selected PDF extracted-text notices\", () => {\n  it(\"shows partial and page count outside collapsed details, with exact original item location\", async () => {\n    const h = pdfSetup(); h.results.set(h.file.path, searchPdf([[\"\", \"needle\"], [\"page two\"]]));\n    await h.search.start(\"needle\", h.candidates, h.current);\n    const html = render(h.search);\n    expect(status(html)).toContain(S.pdfPartial); expect(status(html)).toContain(S.pdfPages(2));\n    expect(html).toContain(\"第 1 页 · 提取片段 2\");\n    expect(html).not.toMatch(/<details[^>]*\\bopen\\b/);\n    expect(html.slice(html.indexOf(\"<details\"))).toContain(S.pdfWarnings.visibilityUnverified);\n    // No extra partial approval checkbox exists in the search result flow.\n    expect(html).not.toContain('type=\"checkbox\"');\n  });\n  it(\"keeps no-text/no-OCR result visible instead of claiming a whole PDF absence\", async () => {\n    const h = pdfSetup(); h.results.set(h.file.path, searchPdf([[]]));\n    await h.search.start(\"needle\", h.candidates, h.current);\n    expect(status(render(h.search))).toContain(S.errors.pdfNoText);\n    expect(status(render(h.search))).not.toContain(S.pdfPages(1));\n  });\n  it(\"does not label inactive, retired or stale PDF results as current scope\", async () => {\n    const h = pdfSetup(); await h.search.start(\"needle\", h.candidates, h.current);\n    expect(status(render(h.search, false))).not.toContain(S.pdfPartial);\n    h.services.check.mockRejectedValue({ code: \"changed\" });\n    await h.search.verifyHit(h.search.snapshot().hits[0], h.current);\n    expect(status(render(h.search))).not.toContain(S.pdfPartial);\n    h.search.retire(); expect(render(h.search)).not.toContain(S.pdfPages(1));\n  });\n  it(\"does not add PDF warnings to a plain-text-only result\", async () => {\n    const h = setup([\"needle\"]); await h.search.start(\"needle\", h.candidates, h.current);\n    expect(status(render(h.search))).not.toContain(S.pdfPartial);\n  });\n});\nEOF\npython3 output/2026-10-14-pdf-search-frontend/run.py targeted-03 corepack pnpm exec vitest run src/runtime/attachment_search.pdf.test.ts src/runtime/pdf_search_text.test.ts src/components/SelectedAttachmentSearch.test.tsx"
