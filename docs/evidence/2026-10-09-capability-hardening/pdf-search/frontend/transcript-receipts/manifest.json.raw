      "processId": "34830",
      "actualExitCode": 1,
      "command": [
        "/bin/zsh",
        "-lc",
        "mkdir -p output/2026-10-14-pdf-search-frontend\ncp output/2026-10-14-xlsx-search-frontend/run.py output/2026-10-14-pdf-search-frontend/run.py\ncat > src/runtime/attachment_search.pdf.test-support.ts <<'EOF'\nimport { createHash } from \"node:crypto\";\nimport { vi } from \"vitest\";\nimport { setup } from \"./attachment_search.test-support\";\nimport { AttachmentSearch } from \"./attachment_search\";\nimport {\n  attachmentSearchCandidates,\n  attachmentSearchSourceCurrent,\n} from \"./attachment_search_source\";\nimport type { VerifiedFile } from \"./file_delivery\";\nimport {\n  PDF_INPUT_SCOPE_WARNING_CODES,\n  type PdfInputCapture,\n  type PdfInputResult,\n} from \"./pdf_input_types\";\n\nexport function searchPdf(pages = [[\"author needle tail\"]]): PdfInputResult {\n  return {\n    scope: {\n      mode: \"decoded-page-text\",\n      includePossiblyInvisibleText: true,\n      pageCount: pages.length,\n      readPageNumbers: pages.map((_, i) => i + 1),\n      extraction: \"pdfjs-text-content-v1\",\n    },\n    pages: pages.map((texts, i) => ({\n      number: i + 1,\n      decodedRotation: i % 2 ? 90 : 0,\n      items: texts.map((text) => ({ text, dir: \"ltr\", hasEOL: false })),\n    })),\n    partial: true,\n    warnings: [\n      ...PDF_INPUT_SCOPE_WARNING_CODES.map((code) => ({\n        code, count: 1 as const, unit: \"scope\" as const,\n      })),\n      ...(pages.filter((p) => !p.some((t) => /\\S/u.test(t))).length\n        ? [{ code: \"pagesWithoutText\" as const, count: pages.filter((p) => !p.some((t) => /\\S/u.test(t))).length, unit: \"pages\" as const }]\n        : []),\n    ],\n  };\n}\nexport function pdfSetup(texts = [\"author needle tail\"], plain: string[] = []) {\n  // Controller fixtures use real hashed whole capture bytes, but a controlled\n  // parser result. They do not claim these bytes are a structurally valid PDF.\n  const h = setup([...texts.map(() => \"%PDF-controlled-capture\"), ...plain]);\n  const captures = new Map<string, PdfInputCapture>(),\n    results = new Map<string, PdfInputResult>();\n  texts.forEach((text, i) => {\n    const item = h.s.items[i];\n    if (item.kind !== \"user\" && item.kind !== \"agent\") throw Error();\n    const path = `/fixture/chosen${i}.pdf`;\n    item.attachments![0] = { name: `chosen${i}.pdf`, uri: `file://${path}` };\n    const raw = Buffer.from(`%PDF-controlled-capture-${i}`);\n    const file = {\n      ...h.files.get(`/fixture/file${i}.txt`)!, path, resolvedPath: path,\n      name: `chosen${i}.pdf`, size: raw.length,\n      sha256: createHash(\"sha256\").update(raw).digest(\"hex\"),\n    };\n    h.files.set(path, file);\n    captures.set(path, { file, data: raw.toString(\"base64\") });\n    results.set(path, searchPdf([[text]]));\n  });\n  const services = {\n    ...h.services,\n    readPdf: vi.fn(async (file: VerifiedFile) => captures.get(file.path)!),\n    parsePdf: vi.fn(async (capture: PdfInputCapture, _signal: AbortSignal) => results.get(capture.file.path)!),\n  };\n  let candidates = attachmentSearchCandidates([h.s.key], h.states).candidates;\n  const refresh = () => (candidates = attachmentSearchCandidates([h.s.key], h.states).candidates);\n  const current = () => candidates.every((c) => attachmentSearchSourceCurrent(c, h.states));\n  const capture = captures.values().next().value!;\n  return { ...h, services, captures, results, capture, file: capture.file,\n    pdf: results.get(capture.file.path)!, candidates, refresh, current,\n    search: new AttachmentSearch(services) };\n}\nEOF\ncat > src/runtime/attachment_search.pdf.test.ts <<'EOF'\nimport { expect, it } from \"vitest\";\nimport { pdfSetup } from \"./attachment_search.pdf.test-support\";\n\nit(\"searches PDF decoded page text through the bounded capture, never raw file text\", async () => {\n  const h = pdfSetup();\n  await h.search.start(\"needle\", h.candidates, h.current);\n  expect(h.search.snapshot().matches).toBe(1);\n  expect(h.services.readPdf).toHaveBeenCalledOnce();\n  expect(h.services.read).not.toHaveBeenCalled();\n  expect(h.search.snapshot().hits[0]).toMatchObject({\n    location: { kind: \"pdf\", pageNumber: 1, itemIndex: 0, decodedRotation: 0 },\n  });\n});\nEOF\npython3 output/2026-10-14-pdf-search-frontend/run.py red-01 corepack pnpm exec vitest run src/runtime/attachment_search.pdf.test.ts"
