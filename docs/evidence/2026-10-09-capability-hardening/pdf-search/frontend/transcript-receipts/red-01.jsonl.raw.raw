es));\n  const capture = captures.values().next().value!;\n  return { ...h, services, captures, results, capture, file: capture.file,\n    pdf: results.get(capture.file.path)!, candidates, refresh, current,\n    search: new AttachmentSearch(services) };\n}\nEOF\ncat > src/runtime/attachment_search.pdf.test.ts <<'EOF'\nimport { expect, it } from \"vitest\";\nimport { pdfSetup } from \"./attachment_search.pdf.test-support\";\n\nit(\"searches PDF decoded page text through the bounded capture, never raw file text\", async () => {\n  const h = pdfSetup();\n  await h.search.start(\"needle\", h.candidates, h.current);\n  expect(h.search.snapshot().matches).toBe(1);\n  expect(h.services.readPdf).toHaveBeenCalledOnce();\n  expect(h.services.read).not.toHaveBeenCalled();\n  expect(h.search.snapshot().hits[0]).toMatchObject({\n    location: { kind: \"pdf\", pageNumber: 1, itemIndex: 0, decodedRotation: 0 },\n  });\n});\nEOF\npython3 output/2026-10-14-pdf-search-frontend/run.py red-01 corepack pnpm exec vitest run src/runtime/attachment_search.pdf.test.ts"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"{\"name\": \"red-01\", \"actualExitCode\": 1, \"stdout\": {\"path\": \"/Users/tw/Desktop/farfold/output/2026-10-14-pdf-search-frontend/red-01.stdout.log\", \"bytes\": 369, \"sha256\": \"f709859cb5cb6b6cc4694cc97b6088bd5249f63a1d9d4434f11d6384f385978e\"}, \"stderr\": {\"path\": \"/Users/tw/Desktop/farfold/output/2026-10-14-pdf-search-frontend/red-01.stderr.log\", \"bytes\": 745, \"sha256\": \"548807eb2c91cb1890c4f823676898eabad1758186449e2a1f5da48ba6dca62f\"}}\n\n RUN  v4.1.11 /Users/tw/Desktop/farfold\n\n ❯ src/runtime/attachment_search.pdf.test.ts (1 test | 1 failed) 4ms\n   × searches PDF decoded page text through the bounded capture, never raw file text 4ms\n\n Test Files  1 failed (1)\n      Tests  1 failed (1)\n   Start at  03:09:01\n   Duration  227ms (transform 122ms, setup 0ms, import 156ms, tests 4ms, environment 0ms)\n\n\n\n⎯⎯⎯⎯⎯⎯⎯ Failed Tests