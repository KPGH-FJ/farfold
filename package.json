{
  "name": "farfold",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:d3qa": "tauri build --config src-tauri/tauri.d3qa.conf.json",
    "tauri:build:p3qa": "FARFOLD_P3_QA=1 VITE_FARFOLD_HOST_SHADOW_QA=1 tauri build --config src-tauri/tauri.p3qa.conf.json",
    "prepare:pi": "bash scripts/fetch-pi-sidecar.sh && bash scripts/prepare-capability-bridge.sh",
    "prepare:opencode": "bash scripts/fetch-opencode-sidecar.sh",
    "prepare:runtimes": "pnpm prepare:pi && pnpm prepare:opencode",
    "typecheck": "tsc -b --pretty false",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
